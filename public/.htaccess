# kittykat.tech — Apache config

# Astro emits index.html at root and per directory.
DirectoryIndex index.html

# Block direct access to environment files. Anyone hitting these gets a 403.
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# .git must never be web-accessible.
RedirectMatch 403 ^/\.git(/|$)

<IfModule mod_headers.c>
    # Allow full-length snippets and large image/video previews for search
    # and AI answer engines (feeds Google AI Overviews etc.). Site-wide.
    Header set X-Robots-Tag "max-snippet:-1, max-image-preview:large, max-video-preview:-1"

    # Cache static assets. Astro hashes asset filenames so they can be cached
    # aggressively — the html files revalidate on each load and pull fresh refs.
    <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|svg|gif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=300, must-revalidate"
    </FilesMatch>

    # update.html is operator-only — override the global tag to noindex.
    # Placed after the site-wide Header set so it wins for this file.
    <Files "update.html">
        Header set X-Robots-Tag "noindex, nofollow"
    </Files>
</IfModule>

# Compress text assets.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Custom 404 — Astro emits 404.html at root.
ErrorDocument 404 /404.html
