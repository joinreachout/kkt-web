---
// Language switcher — flag dropdown. Links to the same page in each locale
// (falls back to that locale's homepage when the page isn't translated yet).
import { LOCALES, LANGS, localizePath, hasTranslation, toLocale, DEFAULT_LOCALE } from '~/i18n/config';

const current = toLocale(Astro.currentLocale);
const path = Astro.url.pathname;

// Inline SVG flags — emoji regional-indicator flags don't render on Windows
// (Chrome/Edge show "GB"/"DE" letters), so we draw them. Keyed by locale.
// Sizing/border are INLINE: set:html content is unscoped, so Astro's scoped
// `.lang-flag svg {…}` rule never matches it (would render 0×0).
const FLAG_ATTRS = 'width="18" height="13" preserveAspectRatio="none" style="display:block;border-radius:2px;border:1px solid var(--border)"';
const FLAG_SVG: Record<string, string> = {
  en: `<svg ${FLAG_ATTRS} viewBox="0 0 60 30"><rect width="60" height="30" fill="#012169"/><path d="M0,0 60,30 M60,0 0,30" stroke="#fff" stroke-width="6"/><path d="M0,0 60,30 M60,0 0,30" stroke="#C8102E" stroke-width="4"/><rect x="25" width="10" height="30" fill="#fff"/><rect y="10" width="60" height="10" fill="#fff"/><rect x="27" width="6" height="30" fill="#C8102E"/><rect y="12" width="60" height="6" fill="#C8102E"/></svg>`,
  de: `<svg ${FLAG_ATTRS} viewBox="0 0 5 3"><rect width="5" height="3" fill="#000"/><rect y="1" width="5" height="2" fill="#DD0000"/><rect y="2" width="5" height="1" fill="#FFCE00"/></svg>`,
  et: `<svg ${FLAG_ATTRS} viewBox="0 0 5 3"><rect width="5" height="1" fill="#0072CE"/><rect y="1" width="5" height="1" fill="#000"/><rect y="2" width="5" height="1" fill="#fff"/></svg>`,
  th: `<svg ${FLAG_ATTRS} viewBox="0 0 6 6"><rect width="6" height="6" fill="#A51931"/><rect y="1" width="6" height="4" fill="#F4F5F8"/><rect y="2" width="6" height="2" fill="#2D2A4A"/></svg>`,
};

const target = (loc: (typeof LOCALES)[number]) =>
  hasTranslation(path, loc)
    ? localizePath(path, loc)
    : loc === DEFAULT_LOCALE
      ? localizePath(path, DEFAULT_LOCALE)
      : `/${loc}/`;
---

<details class="lang-dd">
  <summary class="lang-summary" aria-label="Change language">
    <span class="lang-flag" aria-hidden="true" set:html={FLAG_SVG[current]}></span>
    <span class="lang-code">{LANGS[current].label}</span>
    <svg class="lang-caret" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
  </summary>
  <ul class="lang-menu">
    {LOCALES.map((loc) => (
      <li>
        <a
          href={target(loc)}
          class:list={['lang-item', { 'is-active': loc === current }]}
          hreflang={LANGS[loc].bcp47}
          lang={LANGS[loc].bcp47}
          aria-current={loc === current ? 'true' : undefined}
        >
          <span class="lang-flag" aria-hidden="true" set:html={FLAG_SVG[loc]}></span>
          <span>{LANGS[loc].native}</span>
        </a>
      </li>
    ))}
  </ul>
</details>

<script>
  // Close any open language dropdown on outside click or Escape.
  document.addEventListener('click', (e) => {
    document.querySelectorAll('details.lang-dd[open]').forEach((dd) => {
      if (!dd.contains(e.target as Node)) (dd as HTMLDetailsElement).open = false;
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') document.querySelectorAll('details.lang-dd[open]').forEach((dd) => ((dd as HTMLDetailsElement).open = false));
  });
</script>

<style>
  .lang-dd { position: relative; }
  .lang-summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    cursor: pointer;
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 6px 9px;
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--text-secondary);
    user-select: none;
    transition: border-color .15s ease, color .15s ease;
  }
  .lang-summary::-webkit-details-marker { display: none; }
  .lang-summary:hover { border-color: var(--border-hover); color: var(--text-primary); }
  .lang-flag { display: inline-flex; line-height: 0; }
  .lang-flag svg {
    width: 18px; height: 13px; display: block;
    border-radius: 2px; border: 1px solid var(--border);
    object-fit: cover;
  }
  .lang-code { font-family: var(--font-mono); letter-spacing: 0.04em; }
  .lang-caret { transition: transform .15s ease; opacity: 0.7; }
  .lang-dd[open] .lang-caret { transform: rotate(180deg); }

  .lang-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    z-index: 40;
    min-width: 150px;
    list-style: none;
    margin: 0;
    padding: 5px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.1);
  }
  .lang-item {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 10px;
    border-radius: 5px;
    font-size: 13.5px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: background .12s ease, color .12s ease;
  }
  .lang-item:hover { background: var(--surface-alt); color: var(--text-primary); text-decoration: none; }
  .lang-item.is-active { color: var(--text-primary); font-weight: 600; }
</style>
