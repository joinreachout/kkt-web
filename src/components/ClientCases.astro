---
// Selected work — logo wall that expands in place (bento-morph) on click.
// Content adapted (EN) from the fuel-canvas trackRecord (canonical client copy).
// Expansion uses the View Transitions API for a true shared-element morph, with
// a graceful instant fallback where unsupported. Red Petroleum sits mid-grid
// (equal weight — not featured). Anonymised engagements use a monogram tile.

const cases = [
  {
    id: 'click-grow',
    name: 'Click & Grow',
    logo: '/logos/click-and-grow.png',
    sector: 'Consumer hardware · D2C',
    years: 'EU · 2022–2023',
    focus: 'Customer analytics for a D2C smart-garden brand',
    what: 'Customer analytics, segmentation, and personalisation built on device-and-consumable behaviour.',
    scope: [
      'Customer analytics and segmentation across the D2C base',
      'Transactional behaviour combined with product-engagement signals',
      'Personalisation support for retention and lifecycle marketing',
    ],
    outcome: [
      'Customer behaviour made actionable for retention planning',
      'Lifecycle marketing grounded in real customer data',
    ],
  },
  {
    id: 'csc-telecom',
    name: 'CSC Telecom',
    logo: '/logos/csc-telecom.png',
    sector: 'Telecom',
    years: 'Baltics · 2023–present',
    focus: 'Customer analytics, tariff analysis, and churn modelling',
    what: 'Behavioural segmentation, personalised communications, tariff and promo-response analysis, and first churn models for retention.',
    scope: [
      'Behavioural segmentation and personalised-communication design',
      'Tariff structure and package-configuration analysis',
      'Promo-response evaluation by cohort',
      'First churn models to route at-risk customers into retention',
    ],
    outcome: [
      'Risk groups visible earlier, not lost in overall traffic',
      'Marketing and commercial decisions on one customer base',
    ],
  },
  {
    id: 'gte',
    name: 'GTE',
    logo: '/logos/gte.png',
    sector: 'Industrial manufacturing',
    years: '2022–2023',
    focus: 'Fuel-efficiency optimisation in compressor design',
    what: 'Business-problem framing, an architecture blending operations research, ML and physical engineering rules, team-shaping support, and development oversight.',
    scope: [
      'Framing the fuel-efficiency optimisation problem in compressor design',
      'Architecture combining OR, ML, and physical engineering rules',
      'Team-composition recommendations',
      'Oversight of the technical development',
    ],
    outcome: [
      'Model used in active design work',
      'Fuel-efficiency gains validated against engineering baselines',
    ],
  },
  {
    id: 'forrest-taxi',
    name: 'Taxigo',
    logo: '/logos/taxigo.jpg',
    sector: 'Mobility · ride-hailing',
    years: 'Baltics & Nordics · 2023',
    focus: 'Dynamic-pricing architecture and feasibility',
    what: 'Business-problem framing, a target architecture, an ML prototype to prove feasibility, implementation-vendor support, and results control against a baseline.',
    scope: [
      'Framing the in-app pricing problem',
      'Defining the target architecture',
      'An ML prototype to prove feasibility',
      'Vendor-selection support and development oversight',
    ],
    outcome: [
      'Feasibility proven before committing to a full build',
      'Target architecture aligned to the business problem',
      'Rollout controlled against a measurable baseline',
    ],
  },
  {
    id: 'red-petroleum',
    name: 'Red Petroleum',
    logo: '/logos/red-petroleum.png',
    sector: 'Fuel retail',
    years: 'Central Asia · 2024–present',
    focus: 'A multi-year data & AI transformation across the network',
    what: 'AI-readiness and roadmap, a DWH/BI foundation, customer segmentation, anti-fraud analytics, internal assistants, and automation across payments, logistics and procurement.',
    scope: [
      'Roadmap and leadership alignment for the data & AI programme',
      'DWH/BI foundation: 24+ dashboards across 9 departments',
      'Segmentation of 380,000+ loyalty members; anti-fraud over 30M+ transactions',
      'NL analytics agent, internal RAG assistants, payment/logistics automation, a first procurement-optimisation product',
      'Hiring and training the client’s in-house data team',
    ],
    outcome: [
      'Most of the roadmap delivered',
      'In-house data team now runs independently',
      'Reporting that took days now takes minutes',
      'First in-house ML models in production',
    ],
  },
];

const partners = [
  { name: 'Noventiq', logo: '/logos/p-noventiq.svg', note: 'Digital-transformation partner' },
  { name: 'Microsoft', logo: '/logos/p-microsoft.svg', note: 'AI partner' },
  { name: 'AWS', logo: '/logos/p-aws.svg', note: 'Solutions delivered on AWS' },
  { name: 'Meta', logo: '/logos/p-meta.svg', note: 'Meta Tech Provider' },
];

const initials = (name) =>
  name.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();

// Localise: overlay translated text (focus/sector/what/scope/outcome) onto the
// static case data, and the notes onto partners. Brand names/logos stay.
import { useHome } from '~/i18n/home';
import { localizePath, toLocale } from '~/i18n/config';
const locale = toLocale(Astro.currentLocale);
const cc = useHome(Astro.currentLocale).cases;
const L = (p) => localizePath(p, locale);
const yr = (y) => y.replace('present', locale === 'de' ? 'heute' : locale === 'et' ? 'praegu' : 'present');
const byId = Object.fromEntries(cc.items.map((i) => [i.id, i]));
const localizedCases = cases.map((c) => ({ ...c, ...(byId[c.id] || {}) }));
const localizedPartners = partners.map((p, i) => ({ ...p, note: cc.partnerNotes[i] }));
---

<section id="cases" class="section cases" data-cases>
  <div class="container">
    <header class="cases-head" data-reveal>
      <p class="section-label">{cc.label}</p>
      <h2 class="h2-section cases-title">{cc.title}</h2>
      <p class="cases-intro">{cc.intro}</p>
    </header>

    <div class="cases-partners" data-reveal-stagger>
      {localizedPartners.map((p) => (
        <div class="cases-partner">
          <img class="cases-partner-logo" src={p.logo} alt={p.name} loading="lazy" />
          <span class="cases-partner-note">{p.note}</span>
        </div>
      ))}
    </div>

    <div class="cases-grid" data-reveal>
      {localizedCases.map((c) => (
        <article class="case-tile" data-id={c.id} style={`view-transition-name: ct-${c.id}`}>
          <button class="case-open" aria-expanded="false" aria-controls={`detail-${c.id}`}>
            <span class="case-brand">
              {c.logo
                ? <img class="case-logo" src={c.logo} alt={c.name} loading="lazy" />
                : <span class="case-mono" aria-hidden="true">{initials(c.name)}</span>}
            </span>
            <span class="case-name">{c.name}</span>
            <span class="case-focus">{c.focus}</span>
            <span class="case-cue" aria-hidden="true">+</span>
          </button>

          <div class="case-detail" id={`detail-${c.id}`} hidden>
            <div class="case-meta">{c.sector} · {yr(c.years)}</div>
            <p class="case-what">{c.what}</p>
            <div class="case-cols">
              <div class="case-col">
                <h4 class="case-col-h">{cc.didLabel}</h4>
                <ul class="case-list">{c.scope.map((s) => <li>{s}</li>)}</ul>
              </div>
              <div class="case-col">
                <h4 class="case-col-h">{cc.changedLabel}</h4>
                <ul class="case-list case-list-out">{c.outcome.map((o) => <li>{o}</li>)}</ul>
              </div>
            </div>
            <button class="case-close" type="button">{cc.close}</button>
          </div>
        </article>
      ))}
    </div>

    <p class="cases-tail" data-reveal>
      <a href={L('/case-studies/')} class="link-cta">{cc.tail}</a>
    </p>
  </div>
</section>

<style>
  .cases { padding-top: clamp(56px, 9vh, 100px); padding-bottom: clamp(56px, 9vh, 100px); }
  .cases-head { max-width: 46ch; margin-bottom: clamp(28px, 4vh, 44px); }
  .cases-title { margin: 12px 0 16px; }
  .cases-intro { font-size: clamp(16px, 1.6vw, 19px); line-height: 1.6; color: var(--text-secondary); }

  /* Partners row */
  .cases-partners { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-bottom: clamp(28px, 4vh, 40px); }
  @media (min-width: 720px) { .cases-partners { grid-template-columns: repeat(4, 1fr); gap: 14px; } }
  .cases-partner {
    display: flex; flex-direction: column; gap: 12px; justify-content: center;
    background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 20px;
    min-height: 96px;
  }
  .cases-partner-logo {
    height: 24px; width: auto; max-width: 130px; object-fit: contain; object-position: left center;
    opacity: 1; transition: opacity .2s ease;
  }
  .cases-partner-note { font-size: 12px; color: var(--text-muted); }
  .cases-tail { margin-top: 26px; }

  .cases-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(186px, 1fr));
    gap: 14px;
    align-items: start;
  }

  .case-tile {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    transition: opacity .3s ease, filter .3s ease, border-color .2s ease;
  }
  /* When one is open, dim the rest into a quiet logo wall. */
  .cases-grid.has-open .case-tile:not(.is-open) { opacity: 0.4; filter: grayscale(1); }

  .case-open {
    display: grid;
    gap: 10px;
    width: 100%;
    text-align: left;
    background: none;
    border: 0;
    padding: 20px 20px 18px;
    position: relative;
  }
  .case-tile:hover { border-color: var(--border-hover); }

  .case-brand { display: flex; align-items: center; height: 34px; }
  .case-logo {
    max-height: 30px; max-width: 130px; object-fit: contain; object-position: left center;
    opacity: 1; transition: opacity .2s ease;
  }
  .case-mono {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border-radius: 9px;
    background: var(--accent-dim); color: var(--accent-text);
    font-weight: 700; font-size: 13px; letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }
  .case-name {
    font-family: var(--font-display); font-weight: 600; font-size: 16px;
    letter-spacing: -0.01em; color: var(--text-primary);
  }
  .case-focus { font-size: 13.5px; line-height: 1.45; color: var(--text-muted); }
  .case-cue {
    position: absolute; top: 16px; right: 18px;
    font-size: 18px; line-height: 1; color: var(--text-muted);
    transition: transform .25s ease, color .2s ease;
  }
  .case-tile.is-open .case-cue { transform: rotate(45deg); color: var(--accent-text); }
  .case-open:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; border-radius: 14px; }

  /* Expanded state — tile spans the full row and reveals the detail. */
  .case-tile.is-open { grid-column: 1 / -1; border-color: var(--border-hover); }
  .case-detail[hidden] { display: none; }
  .case-detail {
    padding: 4px 24px 24px;
    border-top: 1px solid var(--border);
    margin: 4px 0 0;
    animation: caseIn .32s ease both;
  }
  @keyframes caseIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  .case-meta {
    font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--accent-text); margin: 16px 0 14px;
  }
  .case-what {
    font-size: clamp(16px, 1.7vw, 19px); line-height: 1.55; color: var(--text-primary);
    max-width: 70ch; margin-bottom: 24px; font-weight: 400;
  }
  .case-cols { display: grid; grid-template-columns: 1fr; gap: 22px; }
  @media (min-width: 720px) { .case-cols { grid-template-columns: 1fr 1fr; gap: 40px; } }
  .case-col-h {
    font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--text-muted); margin-bottom: 12px;
  }
  .case-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 9px; }
  .case-list li {
    position: relative; padding-left: 20px; font-size: 15px; line-height: 1.55;
    color: var(--text-secondary);
  }
  .case-list li::before {
    content: ''; position: absolute; left: 2px; top: 9px;
    width: 6px; height: 6px; border-radius: 50%; background: var(--accent); opacity: 0.5;
  }
  .case-list-out li::before { border-radius: 2px; opacity: 0.85; }
  .case-close {
    margin-top: 22px; background: none; border: 1px solid var(--border-hover);
    color: var(--text-secondary); border-radius: 980px; padding: 8px 18px;
    font-size: 14px; font-weight: 500; transition: border-color .18s ease, color .18s ease;
  }
  .case-close:hover { border-color: var(--accent); color: var(--accent-text); }

  @media (prefers-reduced-motion: reduce) {
    .case-detail { animation: none; }
    .case-tile, .case-cue, .case-logo { transition: none; }
  }
</style>

<script is:inline>
  (function () {
    var sec = document.querySelector('[data-cases]');
    if (!sec) return;
    var grid = sec.querySelector('.cases-grid');
    var tiles = Array.prototype.slice.call(sec.querySelectorAll('.case-tile'));

    function render(openId) {
      grid.classList.toggle('has-open', !!openId);
      tiles.forEach(function (t) {
        var isOpen = t.getAttribute('data-id') === openId;
        t.classList.toggle('is-open', isOpen);
        t.querySelector('.case-open').setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        t.querySelector('.case-detail').hidden = !isOpen;
      });
    }

    function setOpen(openId) {
      if (document.startViewTransition) {
        document.startViewTransition(function () { render(openId); });
      } else {
        render(openId);
      }
    }

    var currentOpen = null;
    tiles.forEach(function (t) {
      var id = t.getAttribute('data-id');
      t.querySelector('.case-open').addEventListener('click', function () {
        currentOpen = (currentOpen === id) ? null : id;
        setOpen(currentOpen);
        if (currentOpen) {
          // keep the opened tile in view after the morph
          requestAnimationFrame(function () {
            setTimeout(function () { t.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); }, 60);
          });
        }
      });
      var closeBtn = t.querySelector('.case-close');
      if (closeBtn) closeBtn.addEventListener('click', function () { currentOpen = null; setOpen(null); });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && currentOpen) { currentOpen = null; setOpen(null); }
    });
  })();
</script>
