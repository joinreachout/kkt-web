---
// The rebuilt Optimus page (Яна's concept, 20.08.2026), shared by the English
// /solutions/optimus and the Russian /ru/solutions/optimus. All copy comes
// from src/i18n/pages/optimus-page.ts; this file owns the structure — layout,
// callout coordinates, illustration files and slide order — so a translation
// can never move a callout or drop a screen.
//
// Two things the client-side script needs are handed to it as JSON in a
// <script type="application/json"> block: an Astro module script cannot read
// the frontmatter directly, and the panels and slides are built by hand from
// innerHTML (which is also why their CSS lives under :global — see the style
// block at the foot of this file).
import CTA from '~/components/CTA.astro';
import { useOptimusPage } from '~/i18n/pages/optimus-page';
import { toLocale } from '~/i18n/config';

const locale = toLocale(Astro.currentLocale);
const t = useOptimusPage(Astro.currentLocale);

// Screenshots exist in Russian and English; every other locale gets English.
const shotLang = locale === 'ru' ? 'ru' : 'en';

// Illustration per process step — structural, shared by both languages.
const STEP_ART: Record<string, string> = {
  '1': 'step-1-planning-v2.jpg',
  '2': 'step-2-approval-v2.jpg',
  '3': 'step-3-supply-v2.jpg',
  'exc': 'step-exc-conflict-v2.jpg',
  '4': 'step-4-receiving-v2.jpg',
};

// Callout anchors per slide: where the dot sits on the screenshot and which
// band the label hangs in. Order matches `ui.slides[n].anns`.
// Step number shown on the rail; '!' marks the exception branch.
const STEP_NUM: Record<string, string> = { '1': '01', '2': '02', '3': '03', 'exc': '!', '4': '04', '5': '05' };

// Where the eight "today" chips and the six "with Optimus" chips sit.
const CHIPS_TODAY_POS = [[30, 19], [70, 19], [22, 41], [78, 41], [22, 61], [78, 61], [24, 90], [76, 90]];
const CHIPS_OPTIMUS_POS = [[30, 19], [70, 19], [26, 41], [74, 41], [26, 61], [74, 61]];
const DTAG_IN_Y = ['17%', '39%', '61%', '83%'];
const DTAG_OUT_Y = ['32%', '62%'];

const SLIDE_SHOTS = ['ui-1-action', 'ui-2-matrix', 'ui-3-history', 'ui-4-capital', 'ui-5-transit', 'ui-6-scenarios'];
const SLIDE_ANCHORS: { x: number; y: number; side: 'top' | 'bottom' }[][] = [
  [{ x: 30, y: 22, side: 'top' }, { x: 46, y: 47, side: 'bottom' }],
  [{ x: 20, y: 27, side: 'top' }, { x: 55, y: 62, side: 'bottom' }],
  [{ x: 80, y: 45, side: 'top' }],
  [{ x: 14, y: 24, side: 'top' }, { x: 76, y: 42, side: 'bottom' }],
  [{ x: 21, y: 29, side: 'top' }],
  [{ x: 52, y: 66, side: 'bottom' }],
];

const clientData = {
  panels: t.process.steps.map((s) => ({
    key: s.key,
    ...t.process.panels[s.key],
    art: STEP_ART[s.key],
    artAlt: t.process.picto[s.key],
  })),
  slides: t.ui.slides.map((sl, i) => ({
    src: `/screens/v2/${SLIDE_SHOTS[i]}-${shotLang}.jpg`,
    caption: sl.caption,
    alt: sl.alt,
    anns: sl.anns.map((text, j) => ({ ...SLIDE_ANCHORS[i][j], text })),
  })),
  slideAria: t.ui.slideAria,
};
---

  <article class="prose-page">
    <!-- HERO -->
    <div class="container hero-grid">
      <div>
        <div class="section-label">{t.hero.label}</div>
        <h1 class="h1-page">{t.hero.h1}</h1>
        <p class="lede lede-lead">{t.hero.lede}</p>
        <p class="how">{t.hero.how}</p>
        <ul class="checks">
          {t.hero.checks.map((c) => (
            <li>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10.5l4 4 8-9" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>{c}</span>
            </li>
          ))}
        </ul>
        <div class="cta-row">
          <a href="/contact?subject=Optimus%20demo" class="btn-primary">{t.hero.ctaDemo}</a>
        </div>
      </div>
      <img class="hero-art" src="/screens/v2/optimus-network-iso-v2.jpg"
           alt={t.hero.alt}
           fetchpriority="high" decoding="async"/>
    </div>

    <!-- 01 · the process today -->
    <section data-reveal class="section section-problem">
      <div class="container">
        <div class="section-label">{t.problem.label}</div>
        <h2 class="h2-section">{t.problem.h2}</h2>
        <p class="sec-lede">{t.problem.lede}</p>

        <div class="duo" id="duo">
          <div class="duo-toggle" role="tablist" aria-label={t.problem.toggleAria}>
            <button class="duo-btn is-on" data-mode="chaos" role="tab" aria-selected="true">{t.problem.tabToday}</button>
            <button class="duo-btn" data-mode="order" role="tab" aria-selected="false">{t.problem.tabOptimus}</button>
          </div>

          <div class="duo-stage">
            <svg viewBox="0 0 1120 540" preserveAspectRatio="none" aria-hidden="true">
              <g class="lines lines-chaos">
                <path d="M560 60 C 420 60, 260 80, 180 120"/>
                <path d="M560 60 C 700 60, 860 80, 940 120"/>
                <path d="M180 120 C 130 230, 130 330, 180 420"/>
                <path d="M940 120 C 990 230, 990 330, 940 420"/>
                <path d="M180 120 C 420 200, 700 90, 940 130"/>
                <path d="M180 420 C 440 330, 690 460, 940 420"/>
                <path d="M180 120 C 430 260, 700 380, 940 430"/>
                <path d="M180 420 C 420 300, 700 160, 940 125"/>
                <path d="M560 70 C 540 160, 580 190, 560 240"/>
                <path d="M185 425 C 340 380, 470 320, 545 285"/>
              </g>
              <g class="lines lines-order">
                <path id="ln-office" d="M572 90 L 572 145"/>
                <path id="ln-depot" d="M255 145 L 452 232"/>
                <path id="ln-supplier" d="M865 145 L 670 232"/>
                <path id="ln-port" d="M255 400 L 448 288"/>
                <path id="ln-trucks" d="M865 400 L 674 288"/>
              </g>
              <g class="pkt-layer">
                <g class="pkt"><circle class="pkt-halo" r="8"/><circle class="pkt-dot" r="3.5"/>
                  <animateMotion dur="2.2s" begin="0s" repeatCount="indefinite"><mpath href="#ln-depot"/></animateMotion></g>
                <g class="pkt"><circle class="pkt-halo" r="8"/><circle class="pkt-dot" r="3.5"/>
                  <animateMotion dur="2.2s" begin="0.55s" repeatCount="indefinite"><mpath href="#ln-supplier"/></animateMotion></g>
                <g class="pkt"><circle class="pkt-halo" r="8"/><circle class="pkt-dot" r="3.5"/>
                  <animateMotion dur="2.2s" begin="1.1s" repeatCount="indefinite"><mpath href="#ln-port"/></animateMotion></g>
                <g class="pkt"><circle class="pkt-halo" r="8"/><circle class="pkt-dot" r="3.5"/>
                  <animateMotion dur="2.2s" begin="1.65s" repeatCount="indefinite"><mpath href="#ln-trucks"/></animateMotion></g>
                <g class="pkt"><circle class="pkt-halo" r="8"/><circle class="pkt-dot" r="3.5"/>
                  <animateMotion dur="2s" begin="0.8s" repeatCount="indefinite" keyPoints="1;0" keyTimes="0;1" calcMode="linear"><mpath href="#ln-office"/></animateMotion></g>
              </g>
            </svg>

            <div class="duo-node duo-node-accent" style="--x:50%; --y:11%;">{t.problem.nodes.office}</div>
            <div class="duo-node" style="--x:16%; --y:24%;">{t.problem.nodes.depot}</div>
            <div class="duo-node" style="--x:84%; --y:24%;">{t.problem.nodes.supplier}</div>
            <div class="duo-node" style="--x:16%; --y:76%;">{t.problem.nodes.port}</div>
            <div class="duo-node" style="--x:84%; --y:76%;">{t.problem.nodes.trucks}</div>

            <img class="duo-art" src="/screens/v2/optimus-dispatcher-iso-v2.jpg" alt="" aria-hidden="true"/>
            <img class="duo-art duo-art-happy" src="/screens/v2/optimus-dispatcher-happy-iso-v2.jpg" alt="" aria-hidden="true"/>
            <div class="duo-core duo-core-chaos" style="--x:50%; --y:90%;">
              <b>{t.problem.coreChaos.title}</b><span>{t.problem.coreChaos.sub}</span>
            </div>
            <div class="duo-core duo-core-order" style="--x:50%; --y:92%;">
              <b>{t.problem.coreOrder.title}</b><span>{t.problem.coreOrder.sub}</span>
            </div>

            {t.problem.chipsToday.map((text, i) => (
              <div class="chip chip-a" style={`--x:${CHIPS_TODAY_POS[i][0]}%; --y:${CHIPS_TODAY_POS[i][1]}%;`}>{text}</div>
            ))}

            {t.problem.chipsOptimus.map((text, i) => (
              <div class="chip chip-b" style={`--x:${CHIPS_OPTIMUS_POS[i][0]}%; --y:${CHIPS_OPTIMUS_POS[i][1]}%;`}>{text}</div>
            ))}
          </div>

          <div class="duo-strip duo-strip-chaos">
            <b>{t.problem.stripToday.lead}</b>{t.problem.stripToday.rest}
          </div>
          <div class="duo-strip duo-strip-order">
            <b>{t.problem.stripOptimus.lead}</b>{t.problem.stripOptimus.rest}
          </div>
        </div>
      </div>
    </section>

    <!-- 02 · the process -->
    <section data-reveal class="section section-process">
      <div class="container">
        <div class="section-label">{t.process.label}</div>
        <h2 class="h2-section">{t.process.h2}</h2>
        <p class="sec-lede">{t.process.lede}</p>

        <div class="proc" id="proc">
          <div class="proc-rail" role="tablist" aria-label={t.process.railAria}>
            {t.process.steps.map((step, i) => (
              <button
                class:list={['proc-step', { 'is-active': i === 0, 'proc-step-exc': step.key === 'exc' }]}
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                data-step={step.key}
              >
                <span class="proc-num">{STEP_NUM[step.key]}</span>
                <span class="proc-name">{step.name}</span>
                <span class="proc-brief">{step.brief}</span>
              </button>
            ))}
          </div>

          <div class="proc-panel" id="proc-panel" role="tabpanel">
            <!-- built by the script from the JSON block below -->
          </div>
        </div>

        <p class="proc-note">{t.process.note}</p>
      </div>
    </section>


    <!-- 03 · data flows -->
    <section data-reveal class="section section-data">
      <div class="container">
        <div class="section-label">{t.data.label}</div>
        <h2 class="h2-section">{t.data.h2}</h2>
        <p class="sec-lede">{t.data.lede}</p>

        <div class="dflow">
          <img class="dflow-art" src="/screens/v2/optimus-dataflow-iso-v2.jpg"
               alt={t.data.alt}
               loading="lazy" decoding="async"/>

          {t.data.inputs.map((d, i) => (
            <div class="dtag dtag-in" style={`--y:${DTAG_IN_Y[i]}`}><b>{d.name}</b><span>{d.note}</span></div>
          ))}

          {t.data.outputs.map((d, i) => (
            <div class="dtag dtag-out" style={`--y:${DTAG_OUT_Y[i]}`}><b>{d.name}</b><span>{d.note}</span></div>
          ))}

          <div class="dcap dcap-in">{t.data.capIn}</div>
          <div class="dcap dcap-out">{t.data.capOut}</div>
        </div>

        <ul class="gains" data-reveal-stagger>
          {t.data.gains.map((g) => (<li><b>{g.lead}</b>{g.rest}</li>))}
        </ul>
      </div>
    </section>

    <!-- the interface — carousel -->
    <section data-reveal class="section section-ui">
      <div class="container">
        <div class="section-label">{t.ui.label}</div>
        <h2 class="h2-section">{t.ui.h2}</h2>
        <p class="sec-lede">{t.ui.lede}</p>

        <div class="carousel" id="carousel">
          <div class="car-viewport">
            <div class="car-track" id="car-track"><!-- slides are drawn by the script --></div>
          </div>
          <button class="car-nav car-prev" id="car-prev" aria-label={t.ui.prevAria}>‹</button>
          <button class="car-nav car-next" id="car-next" aria-label={t.ui.nextAria}>›</button>
          <div class="car-dots" id="car-dots"></div>
        </div>
      </div>
    </section>

    <CTA
      heading={t.cta.heading}
      body={t.cta.body}
      primaryLabel={t.cta.primary}
      primaryHref="/contact?subject=Optimus%20demo"
      secondaryLabel={null}
    />

    <script type="application/json" id="optimus-i18n" set:html={JSON.stringify(clientData)}></script>
  </article>

<script>
  /* Copy for the step panels and the carousel arrives as JSON from the
   * component — an Astro module script cannot read frontmatter — so English
   * and Russian share this code. Structure (coordinates, image files, order)
   * comes from the same block and is identical in both languages. */
  type Ann = { x: number; y: number; side: 'top' | 'bottom'; text: string };
  type Panel = { key: string; label: string; title: string; bullets: string[]; art: string; artAlt: string };
  type Slide = { src: string; caption: string; alt: string; anns: Ann[] };

  const raw = document.getElementById('optimus-i18n')?.textContent ?? '{}';
  const I18N: { panels: Panel[]; slides: Slide[]; slideAria: string } = JSON.parse(raw);
  const PANELS: Record<string, Panel> = Object.fromEntries(I18N.panels.map((d) => [d.key, d]));

  const panel = document.getElementById('proc-panel')!;
  const steps = Array.from(document.querySelectorAll<HTMLButtonElement>('.proc-step'));

  function render(key: string) {
    const d = PANELS[key];
    if (!d) return;
    panel.innerHTML = `
      <div class="pp-label">${d.label}</div>
      <h3 class="pp-title">${d.title}</h3>
      <ul class="pp-bullets">${d.bullets.map((b) => `<li>${b}</li>`).join('')}</ul>
      ${d.art ? `
        <figure class="pp-art">
          <img src="/screens/v2/${d.art}" alt="${d.artAlt}" loading="lazy" decoding="async"/>
        </figure>` : ''}
    `;
  }

  steps.forEach((btn) => {
    btn.addEventListener('click', () => {
      steps.forEach((b) => { b.classList.toggle('is-active', b === btn); b.setAttribute('aria-selected', String(b === btn)); });
      render(btn.dataset.step!);
    });
  });
  render(steps[0]?.dataset.step ?? '1');

  /* ---------------- screen carousel ---------------- */
  /* Every screenshot was taken in one 1600×900 window, so the frames match.
   * Which language they show is decided by the component. */
  const SLIDES = I18N.slides;

  const track = document.getElementById('car-track');
  const dots = document.getElementById('car-dots');
  if (track && dots) {
    track.innerHTML = SLIDES.map((sl) => {
      const top = sl.anns.filter((a) => a.side === 'top');
      const bottom = sl.anns.filter((a) => a.side === 'bottom');
      const band = (items: Ann[], side: string) => `
        <div class="ann-band ann-band-${side}">
          ${items.map((a, i) => `
            <div class="ann" style="--ax:${a.x}%; --d:${0.15 + i * 0.18}s">${a.text}</div>
            <span class="lead-out" style="--ax:${a.x}%; --d:${0.15 + i * 0.18}s"></span>`).join('')}
        </div>`;
      return `
      <figure class="car-slide">
        ${band(top, 'top')}
        <div class="shot-frame">
          <img src="${sl.src}" alt="${sl.alt}" loading="lazy" decoding="async"/>
          ${sl.anns.map((a, i) => `
            <span class="lead-in lead-in-${a.side}" style="--x:${a.x}%; --y:${a.y}%; --d:${0.22 + i * 0.18}s"></span>
            <i class="ann-dot" style="--x:${a.x}%; --y:${a.y}%; --d:${0.32 + i * 0.18}s"></i>`).join('')}
        </div>
        ${band(bottom, 'bottom')}
        <figcaption>${sl.caption}</figcaption>
      </figure>`;
    }).join('');
    dots.innerHTML = SLIDES.map((_, i) => `<button type="button" data-slide="${i}" aria-current="${i === 0}" aria-label="${I18N.slideAria} ${i + 1}"></button>`).join('');

    let idx = 0;
    const slides = Array.from(track.querySelectorAll('.car-slide'));
    const show = (n: number) => {
      idx = (n + SLIDES.length) % SLIDES.length;
      track.style.transform = `translateX(-${idx * 100}%)`;
      dots.querySelectorAll('button').forEach((b, i) => b.setAttribute('aria-current', String(i === idx)));
      slides.forEach((sl, i) => sl.classList.toggle('is-live', i === idx));
    };
    // the first slide comes alive when the section reaches the viewport
    new IntersectionObserver((entries, obs) => {
      entries.forEach((e) => { if (e.isIntersecting) { slides[0].classList.add('is-live'); obs.disconnect(); } });
    }, { threshold: 0.3 }).observe(document.getElementById('carousel')!);
    document.getElementById('car-prev')!.addEventListener('click', () => show(idx - 1));
    document.getElementById('car-next')!.addEventListener('click', () => show(idx + 1));
    dots.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-slide]');
      if (b) show(Number(b.dataset.slide));
    });
    document.getElementById('carousel')!.addEventListener('keydown', (e) => {
      if ((e as KeyboardEvent).key === 'ArrowLeft') show(idx - 1);
      if ((e as KeyboardEvent).key === 'ArrowRight') show(idx + 1);
    });
  }

  // Callout leaders: start drawing when the figure enters the viewport
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('.shot-annot').forEach((fig) => {
    if (reduceMotion) { fig.classList.add('ann-go'); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        fig.classList.add('ann-go');
        io.disconnect();
      });
    }, { threshold: 0.35 });
    io.observe(fig);
  });

  // «Сегодня / С Optimus»
  const duo = document.getElementById('duo')!;
  duo.querySelectorAll<HTMLButtonElement>('.duo-btn').forEach((b) => {
    b.addEventListener('click', () => {
      duo.classList.toggle('is-order', b.dataset.mode === 'order');
      duo.querySelectorAll('.duo-btn').forEach((x) => { x.classList.toggle('is-on', x === b); x.setAttribute('aria-selected', String(x === b)); });
    });
  });
</script>

<style>
  /* Opening: what it is, set large; how it does it, set smaller; then the
     five things a fuel network gets, as ticks big enough to read at a glance. */
  .lede-lead { font-size: clamp(18px, 1.95vw, 23px); line-height: 1.45; color: var(--text-primary); font-weight: 500; max-width: 60ch; }
  .how { font-size: clamp(15px, 1.5vw, 17px); line-height: 1.6; color: var(--text-secondary); margin: 18px 0 0; max-width: 62ch; }
  .checks { list-style: none; padding: 0; margin: clamp(22px, 3vh, 32px) 0 0; display: grid; gap: 12px 28px; }
  @media (min-width: 720px) { .checks { grid-template-columns: 1fr 1fr; } }
  .checks li { display: flex; align-items: flex-start; gap: 11px; font-size: clamp(16px, 1.55vw, 18.5px); line-height: 1.35; font-weight: 500; color: var(--text-primary); }
  .checks svg { width: 21px; height: 21px; flex: none; margin-top: 1px; color: var(--accent); }

  .prose-page { padding-top: clamp(40px, 6vh, 72px); }
  .hero-grid { display: grid; grid-template-columns: minmax(420px, 1.1fr) 1fr; gap: clamp(24px, 4vw, 56px); align-items: end; padding-bottom: clamp(48px, 8vh, 96px); }
  .hero-art { width: 100%; border-radius: 18px; }
  .duo-art { position: absolute; left: 50%; top: 47%; transform: translate(-50%, -50%); width: 30%; mix-blend-mode: multiply; transition: opacity 0.45s; }
  .duo.is-order .duo-art { opacity: 0; }
  .flow-art { display: block; width: min(620px, 80%); margin: 0 auto 34px; border-radius: 16px; }
  .h1-page {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(36px, 5vw, 56px); line-height: 1.14; margin-bottom: 16px;
  }
  .lede { font-size: clamp(17px, 2vw, 20px); color: var(--text-secondary); max-width: 760px; line-height: 1.6; }
  .cta-row { display: flex; gap: 14px; margin-top: 28px; flex-wrap: wrap; }
  .section { padding: clamp(48px, 8vh, 96px) 0; }
  .sec-lede { color: var(--text-secondary); max-width: 720px; line-height: 1.6; margin-bottom: 32px; }

  /* 01 — «Сегодня / С Optimus» */
  .section-problem { background: var(--surface-alt); }
  .duo { position: relative; }
  .duo-toggle { display: inline-flex; gap: 4px; background: var(--card); border: 1px solid var(--border); border-radius: 999px; padding: 4px; margin-bottom: 22px; }
  .duo-btn { border: 0; background: transparent; cursor: pointer; font: 600 14px var(--font-display); color: var(--text-secondary); padding: 8px 18px; border-radius: 999px; transition: all 0.2s; }
  .duo-btn.is-on { background: var(--text-primary); color: #fff; }
  .duo.is-order .duo-btn.is-on { background: var(--accent-gradient); }
  .duo-stage { position: relative; aspect-ratio: 1120 / 540; }
  .duo-stage svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .lines path { fill: none; transition: opacity 0.5s; }
  .lines-chaos path { stroke: var(--border-hover); stroke-width: 1.2; stroke-dasharray: 5 6; }
  .lines-order path { stroke: var(--accent); stroke-width: 2; stroke-dasharray: 10 8; opacity: 0; }
  .duo.is-order .lines-chaos path { opacity: 0; }
  .duo.is-order .lines-order path { opacity: 1; animation: flow 1.2s linear infinite; }
  @keyframes flow { to { stroke-dashoffset: -18; } }
  .duo-art-happy { opacity: 0; }
  .duo.is-order .duo-art-happy { opacity: 1; }
  .duo.is-order .duo-art:not(.duo-art-happy) { opacity: 0; }
  .pkt-layer { opacity: 0; transition: opacity 0.5s; }
  .duo.is-order .pkt-layer { opacity: 1; }
  .pkt-dot { fill: var(--accent); }
  .pkt-halo { fill: var(--accent); opacity: 0.25; }
  .duo.is-order .duo-core-order { animation: none; }
  @keyframes corepulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(255, 106, 0, 0.35); }
    50% { box-shadow: 0 0 0 14px rgba(255, 106, 0, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .duo.is-order .lines-order path { animation: none; }
    .pkt { display: none; }
  }
  .duo-node, .duo-core, .chip { position: absolute; left: var(--x); top: var(--y); transform: translate(-50%, -50%); }
  .duo-node-accent {
    background: linear-gradient(135deg, #FFF6F0 0%, #FFE9DC 100%) !important;
    border-color: rgba(255, 106, 0, 0.38) !important;
    box-shadow: 0 4px 14px rgba(255, 106, 0, 0.10) !important;
  }
  .duo-node {
