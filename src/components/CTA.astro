---
interface Props {
  heading?: string;
  body?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  /** Pass null to render the primary action alone. */
  secondaryLabel?: string | null;
}
import { useHome } from '~/i18n/home';
import { localizePath, toLocale } from '~/i18n/config';
const locale = toLocale(Astro.currentLocale);
const c = useHome(Astro.currentLocale).cta;
const {
  heading = c.heading,
  body = c.body,
  primaryHref = '/contact',
  primaryLabel = c.primary,
  secondaryHref = '/case-studies/',
  secondaryLabel = c.secondary,
} = Astro.props as Props;
const L = (p: string) => localizePath(p, locale);
---

<section class="cta-block">
  <div class="container cta-inner">
    <h2 class="h2-section cta-heading">{heading}</h2>
    <p class="cta-body">{body}</p>
    <div class="cta-actions">
      <a href={L(primaryHref)} class="btn-primary">{primaryLabel}</a>
      {secondaryLabel && <a href={L(secondaryHref)} class="btn-ghost">{secondaryLabel}</a>}
    </div>
  </div>
</section>

<style>
  .cta-block {
    padding-top: clamp(56px, 9vh, 96px);
    padding-bottom: clamp(56px, 9vh, 96px);
    border-top: 1px solid var(--border);
    background: var(--surface);
  }
  .cta-heading {
    margin-bottom: 18px;
    max-width: 22ch;
  }
  .cta-body {
    max-width: 60ch;
    margin-bottom: 28px;
  }
  .cta-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
</style>
