---
// Homepage hero — rebuild (12 Jun 2026 brief).
// Copy is the ANAS opening statement (canonical source), near-verbatim.
// Apple-style: white canvas, oversized tight headline, generous space.
---

<section class="hero">
  <div class="container hero-inner fade-up" data-parallax>
    <p class="hero-eyebrow">Business-first Data &amp; AI</p>

    <h1 class="hero-title">
      We help companies move from <span class="hero-accent">business questions</span>
      to practical solutions in data, analytics, and automation.
    </h1>

    <p class="hero-sub">
      Domain expertise, process consulting, data engineering, ML/AI architecture
      and delivery coordination — in one team. The starting point is always the
      business objective. Technology comes after that.
    </p>

    <div class="hero-ctas">
      <a href="#how-we-work" class="btn-primary">See how we work</a>
      <a href="/case-studies/" class="link-cta">View selected work</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(64px, 11vh, 132px);
    padding-bottom: clamp(48px, 8vh, 96px);
    text-align: center;
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: 22px;
  }
  .hero-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(38px, 6.2vw, 76px);
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: var(--text-primary);
    max-width: 17ch;
    text-wrap: balance;
    margin-bottom: 26px;
  }
  .hero-accent {
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .hero-sub {
    font-size: clamp(17px, 1.8vw, 21px);
    line-height: 1.55;
    color: var(--text-secondary);
    max-width: 60ch;
    font-weight: 400;
    margin: 0 0 38px;
  }
  .hero-ctas {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
  }
</style>
