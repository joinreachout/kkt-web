---
// Homepage hero — rebuild (12 Jun 2026 brief).
// Copy is the ANAS opening statement (canonical source), near-verbatim.
// Apple-style: white canvas, oversized tight headline, generous space.
import HeroVisual from './HeroVisual.astro';
import { useStrings } from '~/i18n/strings';
import { localizePath, toLocale } from '~/i18n/config';
const locale = toLocale(Astro.currentLocale);
const t = useStrings(Astro.currentLocale);
const L = (p: string) => localizePath(p, locale);
---

<section class="hero">
  <div class="container hero-inner fade-up" data-parallax>
    <p class="hero-eyebrow">{t.hero.eyebrow}</p>

    <h1 class="hero-title">
      {t.hero.titleA}<span class="hero-accent">{t.hero.titleAccent1}</span>{t.hero.titleB}<span class="hero-accent">{t.hero.titleAccent2}</span>.
    </h1>

    <p class="hero-sub">{t.hero.sub}</p>

    <div class="hero-ctas">
      <a href="#how-we-work" class="btn-primary">{t.hero.ctaPrimary}</a>
      <a href={L('/case-studies/')} class="link-cta">{t.hero.ctaSecondary}</a>
    </div>

    <div class="hero-media">
      <HeroVisual />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(64px, 11vh, 132px);
    padding-bottom: clamp(48px, 8vh, 96px);
    text-align: center;
  }
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .hero-eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: 22px;
  }
  .hero-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(38px, 6.2vw, 76px);
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: var(--text-primary);
    max-width: 17ch;
    text-wrap: balance;
    margin-bottom: 26px;
  }
  .hero-accent {
    background: var(--accent-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .hero-sub {
    font-size: clamp(17px, 1.8vw, 21px);
    line-height: 1.55;
    color: var(--text-secondary);
    max-width: 60ch;
    font-weight: 400;
    margin: 0 0 38px;
  }
  .hero-ctas {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
  }
  .hero-media {
    width: 100%;
    max-width: 920px;
    margin-top: clamp(40px, 6vh, 72px);
  }
</style>
