---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import VersionBadge from '~/components/VersionBadge.astro';
import AdvisorMount from '~/components/AdvisorMount.astro';
import { LANGS, toLocale, alternates } from '~/i18n/config';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  pageType?: 'website' | 'article';
  articleAuthor?: string;
  articlePublished?: string; // ISO date
  faq?: { q: string; a: string }[]; // when set, emits FAQPage JSON-LD (gate on visible on-page Q&A)
}

const {
  title = 'KKT — senior data & AI delivery',
  description = 'A senior data & AI team with roots in business — data foundations, ML, and AI agents, shipped into real operations. Tallinn, EU.',
  canonical,
  noindex = false,
  ogImage = '/og/home.png',
  pageType = 'website',
  articleAuthor,
  articlePublished,
  faq,
} = Astro.props as Props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';

// i18n: page language + hreflang alternates for this path.
const locale = toLocale(Astro.currentLocale);
const langTag = LANGS[locale].bcp47;
const ogLocale = { en: 'en_US', de: 'de_DE', et: 'et_EE' }[locale];
const ogType = pageType === 'article' ? 'article' : 'website';
const hreflangs = alternates(Astro.url.pathname, Astro.site);

// Schema.org JSON-LD. Always emits an Organization graph node + a
// page-type node (WebPage / Article). Search engines pick from the
// graph; we keep both nodes lightweight and accurate.
const schemaGraph: Record<string, unknown>[] = [
  {
    '@type': ['Organization', 'ProfessionalService'],
    '@id': 'https://kittykat.tech/#org',
    name: 'Kitty Kat Technologies',
    legalName: 'Kitty Kat Technologies OÜ',
    alternateName: 'KKT',
    url: 'https://kittykat.tech/',
    logo: 'https://kittykat.tech/favicon.svg',
    email: 'hello@kittykat.tech',
    telephone: '+372 5555 3621',
    areaServed: ['Europe', 'Central Asia'],
    contactPoint: {
      '@type': 'ContactPoint',
      contactType: 'sales',
      email: 'hello@kittykat.tech',
      telephone: '+372 5555 3621',
      availableLanguage: ['en', 'de', 'et'],
    },
    sameAs: [
      'https://www.linkedin.com/company/kittykattech/',
    ],
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Jõe 7',
      postalCode: '10151',
      addressLocality: 'Tallinn',
      addressCountry: 'EE',
    },
    description:
      'A data and AI advisory and implementation firm specialising in fuel retail and mid-sized retail. KKT helps operators improve customer revenue, inventory and availability, margins, loss control and management productivity — from business case to a system running in operations. Tallinn, EU.',
    foundingLocation: 'Tallinn, Estonia',
    knowsAbout: [
      'AI delivery',
      'PMO',
      'Fuel retail operations',
      'Retail analytics',
      'Operating-intelligence systems',
    ],
    founder: [
      { '@id': 'https://kittykat.tech/#person-dennis' },
      { '@id': 'https://kittykat.tech/#person-george' },
    ],
    member: [
      { '@id': 'https://kittykat.tech/#person-nageye' },
      { '@id': 'https://kittykat.tech/#person-george' },
      { '@id': 'https://kittykat.tech/#person-dennis' },
    ],
  },
  {
    '@type': 'Person',
    '@id': 'https://kittykat.tech/#person-dennis',
    name: 'Dennis Nepomniashy',
    jobTitle: 'Data-driven Marketing',
    description: 'Marketing and software-integration project management, run from the data. Certified in Business IT and MCSI.',
    worksFor: { '@id': 'https://kittykat.tech/#org' },
    sameAs: 'https://www.linkedin.com/in/dennisnepomniashy/',
  },
  {
    '@type': 'Person',
    '@id': 'https://kittykat.tech/#person-george',
    name: 'George Shevardenidze',
    jobTitle: 'Data Scientist',
    description: 'Fifteen years in global B2B technical consultancy. Three years pulling data analytics and AI into running businesses. Certified by Microsoft AI, IBM, and Google.',
    worksFor: { '@id': 'https://kittykat.tech/#org' },
    sameAs: 'https://www.linkedin.com/in/george-shevardenidze-017a3999/',
  },
  {
    '@type': 'Person',
    '@id': 'https://kittykat.tech/#person-nageye',
    name: 'Nageye Ibrahim Rascid',
    jobTitle: 'Cloud Expert',
    description: 'Twenty years across Cisco Meraki, Snowflake, and Microsoft. Cloud architecture, big data, and machine learning at the scale where decisions cost real money.',
    worksFor: { '@id': 'https://kittykat.tech/#org' },
    sameAs: 'https://www.linkedin.com/in/nageyerascid/',
  },
];

if (pageType === 'article') {
  schemaGraph.push({
    '@type': 'Article',
    headline: title,
    description,
    inLanguage: langTag,
    image: ogImageUrl,
    url: canonicalUrl,
    author: articleAuthor
      ? { '@type': 'Person', name: articleAuthor }
      : { '@id': 'https://kittykat.tech/#org' },
    publisher: { '@id': 'https://kittykat.tech/#org' },
    datePublished: articlePublished,
    dateModified: articlePublished,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  });
} else {
  schemaGraph.push({
    '@type': 'WebPage',
    '@id': canonicalUrl,
    name: title,
    description,
    url: canonicalUrl,
    inLanguage: langTag,
    isPartOf: { '@id': 'https://kittykat.tech/#org' },
    primaryImageOfPage: { '@type': 'ImageObject', url: ogImageUrl },
  });
  if (isHome) {
    // Home page acts as the WebSite root; declare it once.
    schemaGraph.push({
      '@type': 'WebSite',
      '@id': 'https://kittykat.tech/#website',
      url: 'https://kittykat.tech/',
      name: 'KKT — senior data & AI delivery',
      publisher: { '@id': 'https://kittykat.tech/#org' },
    });
  }
}

// BreadcrumbList — derived from URL path. Helps Google render the
// crumb trail in search results.
const pathname = Astro.url.pathname.replace(/\/+$/, '');
const segments = pathname.split('/').filter(Boolean);
if (segments.length > 0 && pageType !== 'article') {
  const NAMES: Record<string, string> = {
    'case-studies': 'Case studies',
    'industries': 'Industries',
    'solutions': 'Solutions',
    'methods': 'Methods',
    'blog': 'Blog',
    'about': 'About',
    'approach': 'Approach',
    'contact': 'Contact',
    'retail': 'Retail',
    'fuel-retail': 'Fuel retail',
    'optimus': 'Optimus',
    'red-petroleum': 'Red Petroleum',
    'click-and-grow': 'Click & Grow',
    'gte': 'GTE',
    'kricon': 'Kricon',
    'csc-telecom': 'CSC Telecom',
  };
  const items = [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://kittykat.tech/' },
  ];
  let acc = 'https://kittykat.tech';
  segments.forEach((seg, i) => {
    acc += '/' + seg;
    items.push({
      '@type': 'ListItem',
      position: i + 2,
      name: NAMES[seg] ?? seg,
      item: acc + '/',
    });
  });
  schemaGraph.push({
    '@type': 'BreadcrumbList',
    itemListElement: items,
  });
}

// Service schema for /solutions/optimus — helps Google understand
// Optimus is a named product/service offering.
if (pathname === '/solutions/optimus') {
  schemaGraph.push({
    '@type': 'Service',
    '@id': 'https://kittykat.tech/solutions/optimus#service',
    name: 'Optimus',
    serviceType: 'Operating-intelligence system for fuel-distribution networks',
    provider: { '@id': 'https://kittykat.tech/#org' },
    url: 'https://kittykat.tech/solutions/optimus/',
    description:
      'Operating intelligence for fuel networks: procurement, margin, stockouts and working capital, on connected data. In pilot at Red Petroleum, a 220+ station fuel network in Kyrgyzstan.',
    areaServed: 'Europe and Central Asia',
    audience: { '@type': 'BusinessAudience', audienceType: 'Fuel retail networks' },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Optimus capability surface',
      itemListElement: [
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI Briefing', description: 'Plain-language daily situation summary — Action Required, Good News, Savings Tip. Free-form chat answers questions from live data.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Procurement Advisor', description: 'Concrete order recommendations with supplier, tonnage, deadline, and price. Statuses CRITICAL / ORDER / OK. One-click PO creation.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Stockout Forecast', description: 'Days remaining until critical level per station and fuel-type position. Includes in-transit and split-wagon transfers.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Delivery conflict resolver', description: 'Auto-Distribute reroutes overflow wagons to the nearest stations with free capacity, with an audit trail.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Working Capital', description: 'Money frozen in inventory and where to release it, per fuel and per region.' } },
      ],
    },
  });
}


// FAQPage — only when the page passes real, visible Q&A (gate schema on
// on-page content, never schema-without-content).
if (faq && faq.length) {
  schemaGraph.push({
    '@type': 'FAQPage',
    '@id': canonicalUrl + '#faq',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}


// ItemList for /case-studies — named client engagements. Descriptions
// drawn only from existing case-study content.
if (pathname === '/case-studies') {
  // Cases are consolidated onto /case-studies/ and expand in place; the
  // per-case URLs are noindex redirect stubs. Point structured data at the
  // canonical on-page anchor (anchor id, not the slug — they can differ).
  const caseItem = (position: number, name: string, anchor: string, description: string) => ({
    '@type': 'ListItem',
    position,
    item: {
      '@type': 'Article',
      name,
      url: `https://kittykat.tech/case-studies/#${anchor}`,
      description,
      publisher: { '@id': 'https://kittykat.tech/#org' },
    },
  });
  schemaGraph.push({
    '@type': 'ItemList',
    '@id': 'https://kittykat.tech/case-studies/#list',
    name: 'KKT case studies',
    description: 'Named client engagements delivered by Kitty Kat Technologies.',
    itemListElement: [
      caseItem(1, 'Red Petroleum — piloting Optimus across the network', 'red-petroleum', 'Fuel retail, Kyrgyzstan. A 220+ station network with Optimus in pilot for procurement and margin.'),
      caseItem(2, 'Click & Grow — ML segmentation for Eastern Europe and CIS', 'click-grow', 'B2C smart indoor gardens. Customer analytics and ML segmentation models for targeted growth.'),
      caseItem(3, 'GTE — reporting and ML for compressor manufacturing', 'gte', 'Industrial compressor manufacturer. Finance and manufacturing reporting, plus ML for anomaly detection and energy-consumption optimisation.'),
      caseItem(4, 'Kricon — operational visibility for international logistics', 'kricon', 'International logistics. Reporting infrastructure, anomaly detection, and clustering models for ops-level signals.'),
      caseItem(5, 'CSC Telecom — customer and product analytics', 'csc-telecom', 'Mid-sized telecom provider. Customer and product analytics studies; several insights adopted and shipped.'),
    ],
  });
}

const schemaJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': schemaGraph,
});
---

<!doctype html>
<html lang={langTag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Mark JS available before paint so scroll-reveal can hide-then-reveal
         without a flash; no-JS users keep everything visible. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- hreflang alternates (en at root, de/et prefixed) -->
    {hreflangs.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="KKT" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {pageType === 'article' && articlePublished && (
      <>
        <meta property="article:published_time" content={articlePublished} />
        <meta property="article:modified_time" content={articlePublished} />
        {articleAuthor && <meta property="article:author" content={articleAuthor} />}
        <meta property="article:section" content="Blog" />
        <meta property="article:publisher" content="https://kittykat.tech/" />
      </>
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts: self-hosted DM Sans (no cross-origin round-trip).
         @font-face in global.css; preload the above-the-fold body face.
         Display type is DM Sans 600 — same family, no extra request. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/dmsans-latin.woff2" crossorigin />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="KKT — Blog" href="/rss.xml" />

    <script type="application/ld+json" set:html={schemaJsonLd}></script>
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <AdvisorMount />
    <VersionBadge />

    <!-- Motion: scroll-reveal (fade + rise, with optional staggered children)
         and a gentle hero parallax. Opt-in via [data-reveal] /
         [data-reveal-stagger] / [data-parallax]. Respects reduced-motion;
         reveals everything immediately if IO is unavailable. GPU-only. -->
    <script is:inline>
      (function () {
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Scroll-reveal
        var els = document.querySelectorAll('[data-reveal], [data-reveal-stagger]');
        if (els.length) {
          if (reduce || !('IntersectionObserver' in window)) {
            els.forEach(function (el) { el.classList.add('in-view'); });
          } else {
            var io = new IntersectionObserver(function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) { e.target.classList.add('in-view'); io.unobserve(e.target); }
              });
            }, { rootMargin: '0px 0px -14% 0px', threshold: 0.12 });
            els.forEach(function (el) { io.observe(el); });
          }
        }

        // Gentle hero parallax — drifts up slightly on scroll. Transform-only.
        var hero = document.querySelector('[data-parallax]');
        if (hero && !reduce) {
          var ticking = false;
          var apply = function () {
            var y = window.scrollY || window.pageYOffset || 0;
            hero.style.transform = y > 0 && y < 760 ? 'translateY(' + (-y * 0.2) + 'px)' : '';
            ticking = false;
          };
          window.addEventListener('scroll', function () {
            if (!ticking) { ticking = true; requestAnimationFrame(apply); }
          }, { passive: true });
        }
      })();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .skip-link:focus {
    left: 16px;
    top: 12px;
    width: auto;
    height: auto;
    padding: 8px 12px;
    background: var(--text-primary);
    color: #fff;
    z-index: 100;
    border-radius: 3px;
    font-size: 13px;
  }
</style>
