---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import VersionBadge from '~/components/VersionBadge.astro';
import AdvisorMount from '~/components/AdvisorMount.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  pageType?: 'website' | 'article';
  articleAuthor?: string;
  articlePublished?: string; // ISO date
}

const {
  title = 'KKT — senior data & AI delivery',
  description = 'A senior data & AI team with roots in business — data foundations, ML, and AI agents, shipped into real operations. Tallinn, EU.',
  canonical,
  noindex = false,
  ogImage = '/og/home.png',
  pageType = 'website',
  articleAuthor,
  articlePublished,
} = Astro.props as Props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';

// Schema.org JSON-LD. Always emits an Organization graph node + a
// page-type node (WebPage / Article). Search engines pick from the
// graph; we keep both nodes lightweight and accurate.
const schemaGraph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': 'https://kittykat.tech/#org',
    name: 'Kitty Kat Technologies',
    legalName: 'Kitty Kat Technologies OÜ',
    alternateName: 'KKT',
    url: 'https://kittykat.tech/',
    logo: 'https://kittykat.tech/favicon.svg',
    email: 'hello@kittykat.tech',
    telephone: '+372 5555 3621',
    sameAs: [
      'https://www.linkedin.com/company/kittykattech/',
    ],
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Jõe 7',
      postalCode: '10151',
      addressLocality: 'Tallinn',
      addressCountry: 'EE',
    },
    description:
      'A senior data & AI team with roots in business — data foundations, ML, and AI agents, shipped into real operations. Tallinn, EU.',
    foundingLocation: 'Tallinn, Estonia',
    knowsAbout: [
      'AI delivery',
      'PMO',
      'Fuel retail operations',
      'Retail analytics',
      'Operating-intelligence systems',
    ],
    member: [
      {
        '@type': 'Person',
        name: 'Nageye Ibrahim Rascid',
        jobTitle: 'Cloud Expert',
        sameAs: 'https://www.linkedin.com/in/nageyerascid/',
      },
      {
        '@type': 'Person',
        name: 'George Shevardenidze',
        jobTitle: 'Data Scientist',
        sameAs: 'https://www.linkedin.com/in/george-shevardenidze-017a3999/',
      },
      {
        '@type': 'Person',
        name: 'Dennis Nepomniashy',
        jobTitle: 'HoReCa & Business Informatics',
        sameAs: 'https://www.linkedin.com/in/dennisnepomniashy/',
      },
    ],
  },
];

if (pageType === 'article') {
  schemaGraph.push({
    '@type': 'Article',
    headline: title,
    description,
    image: ogImageUrl,
    url: canonicalUrl,
    author: articleAuthor
      ? { '@type': 'Person', name: articleAuthor }
      : { '@id': 'https://kittykat.tech/#org' },
    publisher: { '@id': 'https://kittykat.tech/#org' },
    datePublished: articlePublished,
    dateModified: articlePublished,
    mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  });
} else {
  schemaGraph.push({
    '@type': 'WebPage',
    '@id': canonicalUrl,
    name: title,
    description,
    url: canonicalUrl,
    isPartOf: { '@id': 'https://kittykat.tech/#org' },
    primaryImageOfPage: { '@type': 'ImageObject', url: ogImageUrl },
  });
  if (isHome) {
    // Home page acts as the WebSite root; declare it once.
    schemaGraph.push({
      '@type': 'WebSite',
      '@id': 'https://kittykat.tech/#website',
      url: 'https://kittykat.tech/',
      name: 'KKT — senior data & AI delivery',
      publisher: { '@id': 'https://kittykat.tech/#org' },
    });
  }
}

// BreadcrumbList — derived from URL path. Helps Google render the
// crumb trail in search results.
const pathname = Astro.url.pathname.replace(/\/+$/, '');
const segments = pathname.split('/').filter(Boolean);
if (segments.length > 0 && pageType !== 'article') {
  const NAMES: Record<string, string> = {
    'case-studies': 'Case studies',
    'industries': 'Industries',
    'solutions': 'Solutions',
    'methods': 'Methods',
    'insights': 'Insights',
    'about': 'About',
    'approach': 'Approach',
    'contact': 'Contact',
    'not-for-you': 'Is this a fit?',
    'retail': 'Retail',
    'fuel-retail': 'Fuel retail',
    'optimus': 'Optimus',
    'red-petroleum': 'Red Petroleum',
    'click-and-grow': 'Click & Grow',
    'gte': 'GTE',
    'kricon': 'Kricon',
    'csc-telecom': 'CSC Telecom',
    'cost-of-doing-nothing': 'Cost of doing nothing',
  };
  const items = [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://kittykat.tech/' },
  ];
  let acc = 'https://kittykat.tech';
  segments.forEach((seg, i) => {
    acc += '/' + seg;
    items.push({
      '@type': 'ListItem',
      position: i + 2,
      name: NAMES[seg] ?? seg,
      item: acc + '/',
    });
  });
  schemaGraph.push({
    '@type': 'BreadcrumbList',
    itemListElement: items,
  });
}

// Service schema for /solutions/optimus — helps Google understand
// Optimus is a named product/service offering.
if (pathname === '/solutions/optimus') {
  schemaGraph.push({
    '@type': 'Service',
    '@id': 'https://kittykat.tech/solutions/optimus#service',
    name: 'Optimus',
    serviceType: 'Operating-intelligence system for fuel-distribution networks',
    provider: { '@id': 'https://kittykat.tech/#org' },
    url: 'https://kittykat.tech/solutions/optimus/',
    description:
      'Operating intelligence for fuel networks: procurement, margin, stockouts and working capital, on connected data. In pilot at Red Petroleum, a 250-station fuel network in Kyrgyzstan.',
    areaServed: 'Europe and Central Asia',
    audience: { '@type': 'BusinessAudience', audienceType: 'Fuel retail networks' },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Optimus capability surface',
      itemListElement: [
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'AI Briefing', description: 'Plain-language daily situation summary — Action Required, Good News, Savings Tip. Free-form chat answers questions from live data.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Procurement Advisor', description: 'Concrete order recommendations with supplier, tonnage, deadline, and price. Statuses CRITICAL / ORDER / OK. One-click PO creation.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Stockout Forecast', description: 'Days remaining until critical level per station and fuel-type position. Includes in-transit and split-wagon transfers.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Delivery conflict resolver', description: 'Auto-Distribute reroutes overflow wagons to the nearest stations with free capacity, with an audit trail.' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Working Capital', description: 'Money frozen in inventory and where to release it, per fuel and per region.' } },
      ],
    },
  });
}

// FAQPage for /not-for-you — the page's seven fit conditions are
// genuine Q&A; answer text mirrors the published copy verbatim.
if (pathname === '/not-for-you') {
  const mk = (q: string, a: string) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  });
  schemaGraph.push({
    '@type': 'FAQPage',
    '@id': 'https://kittykat.tech/not-for-you/#faq',
    mainEntity: [
      mk(
        'Is KKT the right partner if our revenue is below ~$50M?',
        'KKT is built for mid-sized companies (deepest in retail and fuel). Below that scale, the delivery model usually costs more than the value it can create — you would be paying for rigor you do not need yet. There are excellent partners sized for smaller companies, and starting with one of them is the right first move.'
      ),
      mk(
        'Does KKT take on strategy work without delivery?',
        'No. KKT work is shaped to put something operating into your business, not to produce a deck that sits on a shelf. If what you need is a slide-led strategy with no delivery team behind it, a strategy house will serve you better.'
      ),
      mk(
        'What if there is no senior internal owner to inherit the work?',
        'The systems KKT builds keep running after the team leaves only if someone senior inside owns them — with real authority and real time, not just a title. If that person is not in place yet, the honest first step is to get them in seat, and KKT is glad to help scope the role first.'
      ),
      mk(
        'Can KKT put a model into production in four weeks?',
        'KKT can run a diagnostic in four weeks. A model live in your business and moving real numbers in four weeks — that KKT cannot promise, and would rather say so than over-commit. Good delivery has a floor on time.'
      ),
      mk(
        'Does KKT work in heavily regulated banking, public sector, or defence?',
        'No. Those domains carry compliance bars and delivery patterns KKT does not claim deep expertise in. Firms built specifically for that work will serve you better.'
      ),
      mk(
        'Will KKT deploy AI without a defined business outcome?',
        'No. KKT puts data, models, and AI to work only where they earn their place against margin, cash, availability, customer value, or productivity. If the ask is to deploy a chatbot or run an LLM pilot with no business outcome attached, KKT is probably not the right call.'
      ),
      mk(
        'Does KKT offer full outsourcing or staff augmentation?',
        'No. KKT works alongside your people and brings senior delivery rigor, AI capability, and PMO discipline — but does not take over your operations, IT, or data function. If you need full-service outsourcing or staff augmentation, a different kind of firm is the better fit.'
      ),
    ],
  });
}

// ItemList for /case-studies — named client engagements. Descriptions
// drawn only from existing case-study content.
if (pathname === '/case-studies') {
  const caseItem = (position: number, name: string, slug: string, description: string) => ({
    '@type': 'ListItem',
    position,
    item: {
      '@type': 'Article',
      name,
      url: `https://kittykat.tech/case-studies/${slug}/`,
      description,
      publisher: { '@id': 'https://kittykat.tech/#org' },
    },
  });
  schemaGraph.push({
    '@type': 'ItemList',
    '@id': 'https://kittykat.tech/case-studies/#list',
    name: 'KKT case studies',
    description: 'Named client engagements delivered by Kitty Kat Technologies.',
    itemListElement: [
      caseItem(1, 'Red Petroleum — piloting Optimus across the network', 'red-petroleum', 'Fuel retail, Kyrgyzstan. A 250-station network with Optimus in pilot for procurement and margin.'),
      caseItem(2, 'Click & Grow — ML segmentation for Eastern Europe and CIS', 'click-and-grow', 'B2C smart indoor gardens. Customer analytics and ML segmentation models for targeted growth.'),
      caseItem(3, 'GTE — reporting and ML for compressor manufacturing', 'gte', 'Industrial compressor manufacturer. Finance and manufacturing reporting, plus ML for anomaly detection and energy-consumption optimisation.'),
      caseItem(4, 'Kricon — operational visibility for international logistics', 'kricon', 'International logistics. Reporting infrastructure, anomaly detection, and clustering models for ops-level signals.'),
      caseItem(5, 'CSC Telecom — customer and product analytics', 'csc-telecom', 'Mid-sized telecom provider. Customer and product analytics studies; several insights adopted and shipped.'),
    ],
  });
}

const schemaJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': schemaGraph,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Mark JS available before paint so scroll-reveal can hide-then-reveal
         without a flash; no-JS users keep everything visible. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="KKT" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts: self-hosted DM Sans (no cross-origin round-trip).
         @font-face in global.css; preload the above-the-fold body face.
         Display type is DM Sans 600 — same family, no extra request. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/dmsans-latin.woff2" crossorigin />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="KKT — Insights" href="/rss.xml" />

    <script type="application/ld+json" set:html={schemaJsonLd}></script>
  </head>

  <body>
    <a href="#main" class="skip-link">Skip to content</a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <AdvisorMount />
    <VersionBadge />

    <!-- Motion: scroll-reveal (fade + rise, with optional staggered children)
         and a gentle hero parallax. Opt-in via [data-reveal] /
         [data-reveal-stagger] / [data-parallax]. Respects reduced-motion;
         reveals everything immediately if IO is unavailable. GPU-only. -->
    <script is:inline>
      (function () {
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Scroll-reveal
        var els = document.querySelectorAll('[data-reveal], [data-reveal-stagger]');
        if (els.length) {
          if (reduce || !('IntersectionObserver' in window)) {
            els.forEach(function (el) { el.classList.add('in-view'); });
          } else {
            var io = new IntersectionObserver(function (entries) {
              entries.forEach(function (e) {
                if (e.isIntersecting) { e.target.classList.add('in-view'); io.unobserve(e.target); }
              });
            }, { rootMargin: '0px 0px -14% 0px', threshold: 0.12 });
            els.forEach(function (el) { io.observe(el); });
          }
        }

        // Gentle hero parallax — drifts up slightly on scroll. Transform-only.
        var hero = document.querySelector('[data-parallax]');
        if (hero && !reduce) {
          var ticking = false;
          var apply = function () {
            var y = window.scrollY || window.pageYOffset || 0;
            hero.style.transform = y > 0 && y < 760 ? 'translateY(' + (-y * 0.2) + 'px)' : '';
            ticking = false;
          };
          window.addEventListener('scroll', function () {
            if (!ticking) { ticking = true; requestAnimationFrame(apply); }
          }, { passive: true });
        }
      })();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .skip-link:focus {
    left: 16px;
    top: 12px;
    width: auto;
    height: auto;
    padding: 8px 12px;
    background: var(--text-primary);
    color: #fff;
    z-index: 100;
    border-radius: 3px;
    font-size: 13px;
  }
</style>
