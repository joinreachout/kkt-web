---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CTA from '~/components/CTA.astro';
import OptimusScreens from '~/components/OptimusScreens.astro';
import { useOptimus } from '~/i18n/pages/optimus';
import { localizePath, toLocale } from '~/i18n/config';

const locale = toLocale(Astro.currentLocale);
const t = useOptimus(Astro.currentLocale);
const fuelRetailHref = localizePath('/industries/fuel-retail', locale);
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  ogImage="/og/optimus.png"
>
  <article class="prose-page">
    <div class="container">
      <div class="section-label">{t.sectionLabel}</div>
      <h1 class="h1-page">{t.h1}</h1>
      <p class="hero-sub">{t.heroSub}</p>
      <p class="lede">{t.lede}</p>
      <p class="optimus-def">
        {t.defPre}<a href={fuelRetailHref}>{t.defLink}</a>{t.defPost}
      </p>

      <div class="cta-row">
        <a href="/contact?subject=Optimus%20demo" class="btn-primary">{t.ctaPrimary}</a>
        <a href="/case-studies#red-petroleum" class="btn-ghost">{t.ctaSecondary}</a>
      </div>

      <figure class="pulse" aria-label={t.pulse.ariaLabel}>
        <div class="pulse-rail">
          <div class="pulse-step">
            <div class="pulse-node">
              <span class="pulse-chip">03:30</span>
              <span class="pulse-t">{t.pulse.erpT}</span>
              <span class="pulse-s">{t.pulse.erpS}</span>
            </div>
          </div>
          <span class="pulse-arrow" aria-hidden="true">&rarr;</span>
          <div class="pulse-step">
            <div class="pulse-node">
              <span class="pulse-t">{t.pulse.forecastT}</span>
              <span class="pulse-s">{t.pulse.forecastS}</span>
            </div>
          </div>
          <span class="pulse-arrow" aria-hidden="true">&rarr;</span>
          <div class="pulse-step">
            <div class="pulse-node">
              <span class="pulse-t">{t.pulse.advisorT}</span>
              <span class="pulse-s">{t.pulse.advisorS}</span>
            </div>
          </div>
          <span class="pulse-arrow" aria-hidden="true">&rarr;</span>
          <div class="pulse-step">
            <div class="pulse-node pulse-dark">
              <span class="pulse-chip">{t.pulse.operatorChip}</span>
              <span class="pulse-t">{t.pulse.operatorT}</span>
              <span class="pulse-s">{t.pulse.operatorS}</span>
            </div>
          </div>
        </div>
        <div class="pulse-note">{t.pulse.note}</div>
        <figcaption class="pulse-caption">{t.pulse.caption}</figcaption>
      </figure>
    </div>

    <section data-reveal class="section section-advisor">
      <div class="container">
        <div class="section-label">{t.advisor.label}</div>
        <h2 class="h2-section">{t.advisor.h2}</h2>
        <p class="scen-lede">{t.advisor.lede}</p>

        <figure class="scen-image">
          <img
            src="/screens/optimus-procurement-advisor-en-v3.jpg"
            alt={t.advisor.imgAlt}
            loading="lazy"
            decoding="async"
          />
          <figcaption>{t.advisor.imgCaption}</figcaption>
        </figure>
      </div>
    </section>

    <section data-reveal class="section section-morning">
      <div class="container">
        <div class="section-label">{t.morning.label}</div>
        <h2 class="h2-section">{t.morning.h2}</h2>

        <ol class="morning-steps" data-reveal-stagger>
          {t.morning.steps.map((step, i) => (
            <li>
              <div class="step-num">{i + 1}</div>
              <div>
                <div class="step-name">{step.name}</div>
                <p>{step.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section data-reveal class="section section-changes">
      <div class="container">
        <div class="section-label">{t.changes.label}</div>
        <h2 class="h2-section">{t.changes.h2}</h2>
        <div class="outcomes-grid" data-reveal-stagger>
          {t.changes.outcomes.map((o) => (
            <div class="outcome">
              <div class="outcome-title">{o.title}</div>
              <p>{o.body}</p>
            </div>
          ))}
        </div>
        <p class="outcomes-note">{t.changes.note}</p>
      </div>
    </section>

    <section data-reveal class="section section-how">
      <div class="container">
        <div class="section-label">{t.how.label}</div>
        <h2 class="h2-section">{t.how.h2}</h2>
        <p class="how-lede">{t.how.lede}</p>

        <div class="clusters" data-reveal-stagger>
          {t.how.clusters.map((cluster) => (
            <div class="cluster">
              <div class="cluster-eyebrow">{cluster.eyebrow}</div>
              <h3 class="cluster-name">{cluster.name}.</h3>
              <ul class="cluster-items">
                {cluster.items.map((item) => (
                  <li>
                    <div class="item-name">{item.name}</div>
                    <p>{item.body}</p>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section data-reveal class="section section-screens">
      <div class="container">
        <div class="section-label">{t.screens.label}</div>
        <h2 class="h2-section">{t.screens.h2}</h2>
        <p class="screens-lede">{t.screens.lede}</p>
        <OptimusScreens
          variant="grid-4"
          picks={['fuel-forecast', 'redistribute-modal', 'fill-levels', 'scenarios']}
        />
      </div>
    </section>

    <section data-reveal class="section section-scenarios">
      <div class="container">
        <div class="section-label">{t.scenarios.label}</div>
        <h2 class="h2-section">{t.scenarios.h2}</h2>
        <p class="scen-lede">{t.scenarios.lede}</p>

        <figure class="scen-image">
          <img
            src="/screens/optimus-scenarios-v2.jpg"
            alt={t.scenarios.imgAlt}
            loading="lazy"
            decoding="async"
          />
          <figcaption>{t.scenarios.imgCaption}</figcaption>
        </figure>

        <div class="scen-grid" data-reveal-stagger>
          {t.scenarios.cards.map((card) => (
            <div class="scen-card">
              <div class="scen-tag">{card.tag}</div>
              <p>{card.body}</p>
            </div>
          ))}
        </div>

        <p class="scen-tail">{t.scenarios.tail}</p>
      </div>
    </section>

    <section data-reveal class="section section-deployments">
      <div class="container">
        <div class="section-label">{t.deployments.label}</div>
        <h2 class="h2-section">{t.deployments.h2}</h2>
        <div class="deployments" data-reveal-stagger>
          <div class="deployment">
            <div class="deployment-name">{t.deployments.name}</div>
            <div class="deployment-meta">{t.deployments.meta}</div>
            <div class="deployment-stats">
              {t.deployments.stats.map((s) => (
                <div class="dep-stat">
                  <span class="dep-stat-num">{s.num}</span>
                  <span class="dep-stat-label">{s.label}</span>
                </div>
              ))}
            </div>
            <p>{t.deployments.body}</p>
            <a href="/case-studies#red-petroleum" class="deployment-link">{t.deployments.link}</a>
          </div>
        </div>
      </div>
    </section>

    <section data-reveal class="section section-pullquote-optimus">
      <div class="container">
        <blockquote class="pullquote-optimus">
          <p>{t.pullquote}</p>
        </blockquote>
      </div>
    </section>

    <CTA
      heading={t.cta.heading}
      body={t.cta.body}
      primaryLabel={t.cta.primary}
      primaryHref="/contact?subject=Optimus%20diagnostic"
      secondaryLabel={t.cta.secondary}
      secondaryHref="/case-studies#red-petroleum"
    />
  </article>
</BaseLayout>

<style>
  .prose-page { padding-top: clamp(40px, 6vh, 72px); }
  .section-label { margin-bottom: 18px; }
  .h1-page {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 600;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.14;
    margin-bottom: 12px;
    letter-spacing: -0.01em;
  }
  .hero-sub {
    font-family: var(--font-display);
    font-style: normal;
    font-size: clamp(20px, 2.6vw, 28px);
    color: var(--text-secondary);
    margin-bottom: 24px;
    max-width: 36ch;
  }
  .lede {
    font-size: clamp(16px, 1.7vw, 18px);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 68ch;
    margin-bottom: 20px;
  }
  .optimus-def {
    font-size: clamp(16px, 1.7vw, 18px);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 68ch;
    margin-bottom: 32px;
  }
  .cta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .section-scenarios { background: var(--surface-alt); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .section-scenarios .section-label { margin-bottom: 12px; }
  .section-scenarios h2 { margin-bottom: 14px; max-width: 24ch; }
  .scen-lede { max-width: 60ch; margin-bottom: 32px; }
  .scen-image {
    margin: 0 0 32px;
    padding: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    max-width: 820px;
    box-shadow: 0 1px 0 rgba(26, 20, 16, 0.04), 0 8px 24px rgba(26, 20, 16, 0.06);
  }
  .scen-image img {
    display: block;
    width: 100%;
    height: auto;
  }
  .scen-image figcaption {
    padding: 12px 18px;
    border-top: 1px solid var(--border);
    background: var(--surface);
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--text-muted);
  }
  .scen-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin-bottom: 24px;
  }
  @media (min-width: 720px) { .scen-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1080px) { .scen-grid { grid-template-columns: repeat(5, 1fr); gap: 12px; } }
  .scen-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 3px solid var(--accent);
    border-radius: 0 0 4px 4px;
    padding: 18px 20px;
  }
  .scen-tag {
    font-family: var(--font-display);
    font-style: normal;
    font-size: 18px;
    color: var(--text-primary);
    margin-bottom: 10px;
    line-height: 1.2;
  }
  .scen-card p { font-size: 13px; line-height: 1.5; margin: 0; }
  .scen-tail { font-size: 13px; color: var(--text-muted); max-width: 60ch; }

  .section-screens .section-label { margin-bottom: 12px; }
  .section-screens h2 { margin-bottom: 14px; max-width: 24ch; }
  .screens-lede {
    max-width: 60ch;
    margin-bottom: 28px;
  }

  .pulse {
    margin: 36px 0 0;
    padding: 26px 28px 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    max-width: 860px;
  }
  .pulse-rail {
    display: flex;
    align-items: stretch;
    gap: 6px;
  }
  .pulse-step { flex: 1 1 0; min-width: 0; display: flex; }
  .pulse-node {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 26px 14px 14px;
    min-height: 78px;
  }
  .pulse-dark { background: var(--text-primary); border-color: var(--text-primary); }
  .pulse-chip {
    position: absolute;
    top: 9px;
    left: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent-text);
  }
  .pulse-dark .pulse-chip { color: #D9A441; }
  .pulse-t { font-size: 15px; font-weight: 600; color: var(--text-primary); line-height: 1.2; }
  .pulse-s { font-size: 12.5px; color: var(--text-secondary); line-height: 1.35; }
  .pulse-dark .pulse-t { color: var(--bg); }
  .pulse-dark .pulse-s { color: rgba(245, 243, 239, 0.72); }
  .pulse-arrow {
    align-self: center;
    flex: 0 0 auto;
    color: var(--text-muted);
    font-size: 18px;
    line-height: 1;
  }
  .pulse-note {
    margin-top: 18px;
    padding: 12px 16px;
    background: var(--surface-alt);
    border-left: 3px solid var(--accent);
    border-radius: 0 4px 4px 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 62ch;
  }
  .pulse-caption {
    margin-top: 16px;
    font-size: 13px;
    color: var(--text-muted);
    max-width: 62ch;
  }
  @media (max-width: 680px) {
    .pulse-rail { flex-direction: column; gap: 4px; }
    .pulse-step { width: 100%; }
    .pulse-arrow { transform: rotate(90deg); padding: 2px 0; }
  }

  .section {
    border-top: 1px solid var(--border);
    margin-top: 48px;
  }
  .section .section-label { margin-bottom: 12px; }
  .section h2 { margin-bottom: 36px; max-width: 24ch; }

  .section-morning {
    background: var(--surface-alt);
    margin-left: -100vw;
    margin-right: -100vw;
    padding-left: 100vw;
    padding-right: 100vw;
  }
  .morning-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 18px;
    max-width: 760px;
  }
  .morning-steps li {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 16px;
    padding: 22px 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
  }
  .step-num {
    font-family: var(--font-display);
    font-style: normal;
    font-size: 24px;
    color: var(--accent-text);
    line-height: 1;
  }
  .step-name {
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 6px;
    font-size: 16px;
  }
  .morning-steps p { font-size: 15px; max-width: 60ch; }

  .outcomes-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    margin-bottom: 24px;
  }
  @media (min-width: 720px) {
    .outcomes-grid { grid-template-columns: 1fr 1fr; }
  }
  .outcome {
    padding: 22px 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
  }
  .outcome-title {
    font-family: var(--font-display);
    font-style: normal;
    font-size: 22px;
    color: var(--text-primary);
    margin-bottom: 10px;
    font-weight: 600;
  }
  .outcome p { font-size: 15px; }
  .outcomes-note {
    font-size: 13px;
    color: var(--text-muted);
    max-width: 60ch;
    margin-top: 18px;
  }

  .how-lede {
    max-width: 60ch;
    margin-bottom: 32px;
  }
  .clusters {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }
  @media (min-width: 880px) {
    .clusters { grid-template-columns: 1fr 1fr; gap: 22px; }
  }
  .cluster {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 24px 26px;
    display: flex;
    flex-direction: column;
  }
  .cluster-eyebrow {
    font-size: 11px;
    color: var(--accent-text);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .cluster-name {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 600;
    font-size: clamp(20px, 2.4vw, 26px);
    color: var(--text-primary);
    margin-bottom: 18px;
    line-height: 1.2;
  }
  .cluster-items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .cluster-items li {
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }
  .cluster-items li:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }
  .item-name {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 14px;
    margin-bottom: 4px;
  }
  .cluster-items p {
    font-size: 14px;
    line-height: 1.55;
    margin: 0;
  }

  .deployments {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }
  @media (min-width: 720px) {
    .deployments { grid-template-columns: 1fr 1fr; }
  }
  .deployment {
    padding: 24px 26px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
  }
  .deployment-name {
    font-family: var(--font-display);
    font-style: normal;
    font-size: 26px;
    color: var(--text-primary);
    margin-bottom: 6px;
  }
  .deployment-meta {
    font-size: 12px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    margin-bottom: 14px;
  }
  .deployment-stats {
    display: flex;
    gap: 24px;
    margin: 0 0 18px;
    padding: 14px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .dep-stat { display: flex; flex-direction: column; gap: 2px; }
  .dep-stat-num {
    font-family: var(--font-display);
    font-style: normal;
    font-size: 28px;
    color: var(--accent);
    line-height: 1;
  }
  .dep-stat-label {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
  }
  .deployment p { font-size: 15px; margin-bottom: 16px; }

  .section-pullquote-optimus {
    padding: clamp(48px, 7vh, 88px) 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface-alt);
    margin-top: 48px;
  }
  .pullquote-optimus {
    margin: 0 auto;
    max-width: 760px;
    padding: 0;
  }
  .pullquote-optimus p {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 600;
    font-size: clamp(20px, 2.6vw, 28px);
    line-height: 1.35;
    color: var(--text-primary);
    margin: 0;
    max-width: 36ch;
  }
  .deployment-link {
    font-size: 13px;
    color: var(--text-primary);
    font-weight: 500;
  }
  .deployment-link.muted {
    color: var(--text-muted);
    font-style: normal;
  }
</style>
