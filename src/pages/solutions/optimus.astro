---
// English Optimus page — the rebuilt design (Яна's concept, 20.08.2026).
// Structure and copy live in OptimusPage.astro / i18n/pages/optimus-page.ts,
// shared with the Russian page at /ru/solutions/optimus.
// The German, Estonian and Thai pages still carry the earlier design and
// their own dictionary (i18n/pages/optimus.ts) until they are translated.
import BaseLayout from '~/layouts/BaseLayout.astro';
import OptimusPage from '~/components/OptimusPage.astro';
import { useOptimusPage } from '~/i18n/pages/optimus-page';

const t = useOptimusPage(Astro.currentLocale);
---

<BaseLayout title={t.meta.title} description={t.meta.description} ogImage="/og/optimus.png">
  <OptimusPage />
</BaseLayout>
