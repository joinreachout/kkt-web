---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CTA from '~/components/CTA.astro';
import OptimusScreens from '~/components/OptimusScreens.astro';

const clusters = [
  {
    name: 'What you see on day one',
    eyebrow: 'Visibility',
    items: [
      { name: 'AI Briefing', body: 'Plain-language daily summary — Action Required, Good News, Savings Tip. Free-form chat answers questions from live data.' },
      { name: 'Stockout Forecast', body: 'Days remaining until critical level per station × fuel. Includes in-transit and split-wagon transfers.' },
      { name: 'Fuel Level Forecast', body: 'Per-station stock projection charts with region and fuel filters.' },
      { name: 'Station Fill Levels', body: 'Per-station, per-fuel % capacity and tonnage, sorted by urgency.' },
    ],
  },
  {
    name: 'What you act on',
    eyebrow: 'Decision surface',
    items: [
      { name: 'Procurement Advisor', body: 'Concrete order recommendations with supplier, tonnage, deadline, price. Statuses CRITICAL / ORDER / OK. One-click PO creation.' },
      { name: 'Reserves Panel', body: 'Fuel held at supplier without destination. Release reserve assigns to a specific station with capacity check.' },
      { name: 'Delivery conflict resolver', body: 'Auto-Distribute reroutes overflow wagons to nearest stations with free capacity. Audit trail.' },
      { name: 'Forced Order flow', body: 'Senior management override path with audit trail and ship-history fallback.' },
    ],
  },
  {
    name: 'What you track over time',
    eyebrow: 'History & money',
    items: [
      { name: 'Working Capital', body: '$ frozen in inventory and where to release.' },
      { name: 'Inventory Turnover', body: 'Per-fuel turnover rate, days on hand, value at stake.' },
      { name: 'Recommendation History', body: 'Daily snapshots — rewind to any past day to see what was advised and what happened.' },
      { name: 'Shipments Timeline', body: '14 / 30 / 60-day forward view per station. Color-coded OK / Tight / Conflict.' },
    ],
  },
  {
    name: 'What runs without you',
    eyebrow: 'Autonomous',
    items: [
      { name: 'Auto-import (cron, ~03:30 local)', body: 'Pulls fresh stocks and orders from ERP. No manual upload.' },
      { name: 'Telegram alert mirror', body: 'Critical events pushed to operator group regardless of web availability.' },
    ],
  },
];
---

<BaseLayout
  title="Optimus — KKT"
  description="Daily operating intelligence for fuel networks. Stockouts, replenishment, working capital — in 10 minutes a morning."
  ogImage="/og/optimus.png"
>
  <article class="prose-page">
    <div class="container">
      <div class="section-label">Solutions — Optimus</div>
      <h1 class="h1-page">Optimus.</h1>
      <p class="hero-sub">Daily operating intelligence for fuel networks.</p>
      <p class="lede">
        Optimus is an operating-intelligence system for fuel-distribution
        networks. Each morning it pulls live data from ERP — current stocks,
        in-transit orders, station-level sales, supplier offers — forecasts
        when each station × fuel-type position will hit critical level,
        detects inbound delivery conflicts where arriving volume exceeds
        tank capacity, and produces concrete procurement recommendations:
        which supplier, how many tons, by what date, at what price.
      </p>
      <p class="optimus-def">
        The user is the head of supply. The morning workflow is 10 to 15
        minutes: read the briefing, close the critical positions, confirm
        or adjust the procurement recommendations, issue the purchase
        orders. Optimus is live at two deployments — Alfa Oil (Kyrgyzstan,
        600+ stations, $500M annual revenue) and a second Central Asian
        network (10 stations, 11 fuel types, 3 regions).
      </p>

      <div class="cta-row">
        <a href="/contact?subject=Optimus%20demo" class="btn-primary">Book a demo</a>
        <a href="/case-studies/alfa-oil" class="btn-ghost">Read the Alfa Oil case</a>
      </div>

      <figure class="pulse" aria-label="Optimus daily pulse: ERP import at 03:30, forecast engine, procurement advisor, operator at 08:00; critical alerts mirror to Telegram independently of the web.">
        <div class="pulse-rail">
          <div class="pulse-step">
            <div class="pulse-node">
              <span class="pulse-chip">03:30</span>
              <span class="pulse-t">ERP</span>
              <span class="pulse-s">stocks · in-transit · sales</span>
            </div>
          </div>
          <span class="pulse-arrow" aria-hidden="true">&rarr;</span>
          <div class="pulse-step">
            <div class="pulse-node">
              <span class="pulse-t">Forecast engine</span>
              <span class="pulse-s">stockout &times; delivery</span>
            </div>
          </div>
          <span class="pulse-arrow" aria-hidden="true">&rarr;</span>
          <div class="pulse-step">
            <div class="pulse-node">
              <span class="pulse-t">Procurement Advisor</span>
              <span class="pulse-s">supplier · tonnage · price</span>
            </div>
          </div>
          <span class="pulse-arrow" aria-hidden="true">&rarr;</span>
          <div class="pulse-step">
            <div class="pulse-node pulse-dark">
              <span class="pulse-chip">08:00</span>
              <span class="pulse-t">Operator</span>
              <span class="pulse-s">10&ndash;15 min · confirm or override, issue POs</span>
            </div>
          </div>
        </div>
        <div class="pulse-note">
          Critical alerts mirror to a Telegram group all day &mdash;
          independent of the web interface.
        </div>
        <figcaption class="pulse-caption">
          Daily pulse: data lands at 03:30, the head of supply opens
          Optimus at 08:00, ten to fifteen minutes later the day&rsquo;s
          procurement decisions are issued.
        </figcaption>
      </figure>
    </div>

    <section data-reveal class="section section-morning">
      <div class="container">
        <div class="section-label">A morning at the operator's desk</div>
        <h2 class="h2-section">Ten to fifteen minutes, then the day starts.</h2>

        <ol class="morning-steps" data-reveal-stagger>
          <li>
            <div class="step-num">1</div>
            <div>
              <div class="step-name">8:00 AM — Open the briefing.</div>
              <p>
                The head of supply opens Optimus and sees yesterday's
                pipeline freshness in one glance, not 40 minutes of
                reconciliation. Action Required. Good News. Savings Tip.
                What changed since yesterday.
              </p>
            </div>
          </li>
          <li>
            <div class="step-num">2</div>
            <div>
              <div class="step-name">Close critical positions.</div>
              <p>
                Procurement Advisor surfaces every station × fuel that
                will hit critical level inside the planning window. Each
                row already has a recommended supplier, tonnage, and
                deadline. Confirm or override.
              </p>
            </div>
          </li>
          <li>
            <div class="step-num">3</div>
            <div>
              <div class="step-name">Resolve delivery conflicts.</div>
              <p>
                When inbound volume exceeds available tank capacity,
                Auto-Distribute reroutes overflow to the nearest stations
                with free capacity. The operator sees the proposed routing,
                not just an alert.
              </p>
            </div>
          </li>
          <li>
            <div class="step-num">4</div>
            <div>
              <div class="step-name">Issue the POs.</div>
              <p>
                One-click PO creation on confirmed recommendations. The
                Reserves Panel covers any fuel already held at supplier
                without destination — assign it to a station with capacity
                check.
              </p>
            </div>
          </li>
          <li>
            <div class="step-num">5</div>
            <div>
              <div class="step-name">Walk away.</div>
              <p>
                Critical alerts mirror to a Telegram group. The operator
                does not depend on the web interface for the rest of the
                day.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section data-reveal class="section section-changes">
      <div class="container">
        <div class="section-label">What it actually changes</div>
        <h2 class="h2-section">Outcomes, not features.</h2>
        <div class="outcomes-grid" data-reveal-stagger>
          <div class="outcome">
            <div class="outcome-title">Stockouts</div>
            <p>
              Fewer surprise critical positions. The forecast surfaces them
              days before they happen, when there is still time to act.
            </p>
          </div>
          <div class="outcome">
            <div class="outcome-title">Working capital</div>
            <p>
              $ frozen in inventory becomes visible per fuel and per region
              — and so does where to release it. Inventory turnover stops
              being a quarterly review and becomes a daily decision.
            </p>
          </div>
          <div class="outcome">
            <div class="outcome-title">Procurement speed</div>
            <p>
              Decisions that took half a day of reconciliation move to
              minutes. The operator sees the recommendation and the data
              behind it on the same screen.
            </p>
          </div>
          <div class="outcome">
            <div class="outcome-title">Supplier consolidation</div>
            <p>
              Recommendation history makes supplier-by-supplier savings
              visible over time. The Procurement Advisor's defaults shift
              with what the data shows.
            </p>
          </div>
        </div>
        <p class="outcomes-note">
          Numbers per deployment vary by network size, fuel mix, and
          baseline. We publish ranges from real production environments,
          not vendor-deck promises. See the Alfa Oil case for one
          deployment's actual movement.
        </p>
      </div>
    </section>

    <section data-reveal class="section section-how">
      <div class="container">
        <div class="section-label">How it works</div>
        <h2 class="h2-section">The full functional surface, in four clusters.</h2>
        <p class="how-lede">
          Fourteen capabilities, organised by how the operator
          actually meets them — what you see, what you act on, what
          you track over time, and what runs without you.
        </p>

        <div class="clusters" data-reveal-stagger>
          {clusters.map((cluster) => (
            <div class="cluster">
              <div class="cluster-eyebrow">{cluster.eyebrow}</div>
              <h3 class="cluster-name">{cluster.name}.</h3>
              <ul class="cluster-items">
                {cluster.items.map((item) => (
                  <li>
                    <div class="item-name">{item.name}</div>
                    <p>{item.body}</p>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section data-reveal class="section section-screens">
      <div class="container">
        <div class="section-label">Selected views</div>
        <h2 class="h2-section">What it actually looks like.</h2>
        <p class="screens-lede">
          Four operator surfaces, lifted from a live deployment. At
          this display size the structure and density are visible but
          individual numbers are not — the way it should be.
        </p>
        <OptimusScreens
          variant="grid-4"
          picks={['fuel-forecast', 'redistribute-modal', 'fill-levels', 'scenarios']}
        />
      </div>
    </section>

    <section data-reveal class="section section-scenarios">
      <div class="container">
        <div class="section-label">Strategy &amp; Scenarios</div>
        <h2 class="h2-section">Five operating modes, one engine.</h2>
        <p class="scen-lede">
          Optimus runs the same forecast engine in five postures — pick
          the one that matches the moment. The procurement
          recommendations, working-capital pressure, and inventory
          posture re-balance accordingly. CFO-grade comparison built
          into the operator surface.
        </p>

        <figure class="scen-image">
          <img
            src="/screens/optimus-scenarios.jpg"
            alt="Optimus Strategy and Scenarios — side-by-side mode comparison table across Standard Safety / Cost Optimization / Cash Conservation / Balanced / Crisis"
            loading="lazy"
            decoding="async"
          />
          <figcaption>Mode comparison table — same inputs, five different recommendation sets, visible side-by-side.</figcaption>
        </figure>

        <div class="scen-grid" data-reveal-stagger>
          <div class="scen-card">
            <div class="scen-tag">Standard Safety</div>
            <p>Default. Conservative buffers, 45-day horizon, low surprise risk.</p>
          </div>
          <div class="scen-card">
            <div class="scen-tag">Cost Optimization</div>
            <p>Push for cheapest landed price across the network. Tighter buffers, more sensitivity to supplier price shifts.</p>
          </div>
          <div class="scen-card">
            <div class="scen-tag">Cash Conservation</div>
            <p>Minimise capital lock. Lower inventory days, smaller PO sizes, accept slightly tighter operating margin.</p>
          </div>
          <div class="scen-card">
            <div class="scen-tag">Balanced</div>
            <p>Median posture between cost, cash, and risk. Useful default when conditions are stable.</p>
          </div>
          <div class="scen-card">
            <div class="scen-tag">Crisis</div>
            <p>Hold-the-line mode. Survive the immediate window, defer everything that can be deferred.</p>
          </div>
        </div>

        <p class="scen-tail">
          Each mode produces a different recommendation set against
          the same operational reality — visible side-by-side. Mode
          comparison view in the screenshot above.
        </p>
      </div>
    </section>

    <section data-reveal class="section section-deployments">
      <div class="container">
        <div class="section-label">Two live deployments</div>
        <h2 class="h2-section">Same product. Same engine. Different scale.</h2>
        <div class="deployments" data-reveal-stagger>
          <div class="deployment">
            <div class="deployment-name">Alfa Oil</div>
            <div class="deployment-meta">Kyrgyzstan · Live</div>
            <div class="deployment-stats">
              <div class="dep-stat">
                <span class="dep-stat-num">600+</span>
                <span class="dep-stat-label">stations</span>
              </div>
              <div class="dep-stat">
                <span class="dep-stat-num">$500M</span>
                <span class="dep-stat-label">revenue</span>
              </div>
              <div class="dep-stat">
                <span class="dep-stat-num">11</span>
                <span class="dep-stat-label">fuel types</span>
              </div>
            </div>
            <p>
              Optimus operating across the full network. Pricing posture,
              station-level operations, supplier relationships — under one
              roof.
            </p>
            <a href="/case-studies/alfa-oil" class="deployment-link">Read the case →</a>
          </div>
          <div class="deployment">
            <div class="deployment-name">Central Asian fuel network</div>
            <div class="deployment-meta">3 regions · Live</div>
            <div class="deployment-stats">
              <div class="dep-stat">
                <span class="dep-stat-num">10</span>
                <span class="dep-stat-label">stations</span>
              </div>
              <div class="dep-stat">
                <span class="dep-stat-num">11</span>
                <span class="dep-stat-label">fuel types</span>
              </div>
              <div class="dep-stat">
                <span class="dep-stat-num">3</span>
                <span class="dep-stat-label">regions</span>
              </div>
            </div>
            <p>
              The smaller end of the range. Same Optimus engine, configured
              for a tight network with multiple fuel types and regional
              supply variability.
            </p>
            <span class="deployment-link muted">Case study in editorial</span>
          </div>
        </div>
      </div>
    </section>

    <section data-reveal class="section section-pullquote-optimus">
      <div class="container">
        <blockquote class="pullquote-optimus">
          <p>
            Numbers per deployment vary by network size, fuel mix, and
            baseline. We publish ranges from real production
            environments, not vendor-deck promises.
          </p>
        </blockquote>
      </div>
    </section>

    <CTA
      heading="See if Optimus fits your network."
      body="A two-week diagnostic looks at your pricing posture, margin posture, and station-level operations — and tells you what shipping Optimus into your network would actually look like."
      primaryLabel="Book a diagnostic"
      primaryHref="/contact?subject=Optimus%20diagnostic"
      secondaryLabel="Read the Alfa Oil case"
      secondaryHref="/case-studies/alfa-oil"
    />
  </article>
</BaseLayout>

<style>
  .prose-page { padding-top: clamp(40px, 6vh, 72px); }
  .section-label { margin-bottom: 18px; }
  .h1-page {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.14;
    margin-bottom: 12px;
    letter-spacing: -0.01em;
  }
  .hero-sub {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(20px, 2.6vw, 28px);
    color: var(--text-secondary);
    margin-bottom: 24px;
    max-width: 36ch;
  }
  .lede {
    font-size: clamp(16px, 1.7vw, 18px);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 68ch;
    margin-bottom: 20px;
  }
  .optimus-def {
    font-size: clamp(16px, 1.7vw, 18px);
    color: var(--text-secondary);
    line-height: 1.65;
    max-width: 68ch;
    margin-bottom: 32px;
  }
  .cta-row {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .section-scenarios { background: var(--surface-alt); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .section-scenarios .section-label { margin-bottom: 12px; }
  .section-scenarios h2 { margin-bottom: 14px; max-width: 24ch; }
  .scen-lede { max-width: 60ch; margin-bottom: 32px; }
  .scen-image {
    margin: 0 0 32px;
    padding: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
    max-width: 820px;
    box-shadow: 0 1px 0 rgba(26, 20, 16, 0.04), 0 8px 24px rgba(26, 20, 16, 0.06);
  }
  .scen-image img {
    display: block;
    width: 100%;
    height: auto;
  }
  .scen-image figcaption {
    padding: 12px 18px;
    border-top: 1px solid var(--border);
    background: var(--surface);
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--text-muted);
  }
  .scen-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin-bottom: 24px;
  }
  @media (min-width: 720px) { .scen-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1080px) { .scen-grid { grid-template-columns: repeat(5, 1fr); gap: 12px; } }
  .scen-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 3px solid var(--accent);
    border-radius: 0 0 4px 4px;
    padding: 18px 20px;
  }
  .scen-tag {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 18px;
    color: var(--text-primary);
    margin-bottom: 10px;
    line-height: 1.2;
  }
  .scen-card p { font-size: 13px; line-height: 1.5; margin: 0; }
  .scen-tail { font-size: 13px; color: var(--text-muted); max-width: 60ch; }

  .section-screens .section-label { margin-bottom: 12px; }
  .section-screens h2 { margin-bottom: 14px; max-width: 24ch; }
  .screens-lede {
    max-width: 60ch;
    margin-bottom: 28px;
  }

  .pulse {
    margin: 36px 0 0;
    padding: 26px 28px 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    max-width: 860px;
  }
  .pulse-rail {
    display: flex;
    align-items: stretch;
    gap: 6px;
  }
  .pulse-step { flex: 1 1 0; min-width: 0; display: flex; }
  .pulse-node {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 26px 14px 14px;
    min-height: 78px;
  }
  .pulse-dark { background: var(--text-primary); border-color: var(--text-primary); }
  .pulse-chip {
    position: absolute;
    top: 9px;
    left: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--accent-text);
  }
  .pulse-dark .pulse-chip { color: #D9A441; }
  .pulse-t { font-size: 15px; font-weight: 600; color: var(--text-primary); line-height: 1.2; }
  .pulse-s { font-size: 12.5px; color: var(--text-secondary); line-height: 1.35; }
  .pulse-dark .pulse-t { color: var(--bg); }
  .pulse-dark .pulse-s { color: rgba(245, 243, 239, 0.72); }
  .pulse-arrow {
    align-self: center;
    flex: 0 0 auto;
    color: var(--text-muted);
    font-size: 18px;
    line-height: 1;
  }
  .pulse-note {
    margin-top: 18px;
    padding: 12px 16px;
    background: var(--surface-alt);
    border-left: 3px solid var(--accent);
    border-radius: 0 4px 4px 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 62ch;
  }
  .pulse-caption {
    margin-top: 16px;
    font-size: 13px;
    color: var(--text-muted);
    max-width: 62ch;
  }
  @media (max-width: 680px) {
    .pulse-rail { flex-direction: column; gap: 4px; }
    .pulse-step { width: 100%; }
    .pulse-arrow { transform: rotate(90deg); padding: 2px 0; }
  }

  .section {
    border-top: 1px solid var(--border);
    margin-top: 48px;
  }
  .section .section-label { margin-bottom: 12px; }
  .section h2 { margin-bottom: 36px; max-width: 24ch; }

  .section-morning {
    background: var(--surface-alt);
    margin-left: -100vw;
    margin-right: -100vw;
    padding-left: 100vw;
    padding-right: 100vw;
  }
  .morning-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 18px;
    max-width: 760px;
  }
  .morning-steps li {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 16px;
    padding: 22px 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
  }
  .step-num {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 24px;
    color: var(--accent-text);
    line-height: 1;
  }
  .step-name {
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 6px;
    font-size: 16px;
  }
  .morning-steps p { font-size: 15px; max-width: 60ch; }

  .outcomes-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    margin-bottom: 24px;
  }
  @media (min-width: 720px) {
    .outcomes-grid { grid-template-columns: 1fr 1fr; }
  }
  .outcome {
    padding: 22px 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
  }
  .outcome-title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 22px;
    color: var(--text-primary);
    margin-bottom: 10px;
    font-weight: 400;
  }
  .outcome p { font-size: 15px; }
  .outcomes-note {
    font-size: 13px;
    color: var(--text-muted);
    max-width: 60ch;
    margin-top: 18px;
  }

  .how-lede {
    max-width: 60ch;
    margin-bottom: 32px;
  }
  .clusters {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }
  @media (min-width: 880px) {
    .clusters { grid-template-columns: 1fr 1fr; gap: 22px; }
  }
  .cluster {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 24px 26px;
    display: flex;
    flex-direction: column;
  }
  .cluster-eyebrow {
    font-size: 11px;
    color: var(--accent-text);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 600;
    margin-bottom: 8px;
  }
  .cluster-name {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
