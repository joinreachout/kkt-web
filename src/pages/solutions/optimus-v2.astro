---
// ЧЕРНОВИК (RU) новой страницы Optimus по концепции Яны, 20.08.2026.
// noindex, в навигации не участвует. После согласования: тексты → i18n
// словари, страница заменяет /solutions/optimus/.
import BaseLayout from '~/layouts/BaseLayout.astro';
import CTA from '~/components/CTA.astro';
---

<BaseLayout
  title="Optimus — управление запасами топлива"
  description="Optimus отслеживает запасы топлива на каждой нефтебазе, рассчитывает, когда и в каком объёме заказать, и заранее предупреждает, если план поставки нужно скорректировать."
  ogImage="/og/optimus.png"
  noindex={true}
>
  <article class="prose-page">
    <!-- HERO -->
    <div class="container hero-grid">
      <div>
        <div class="section-label">Optimus · управление запасами топлива</div>
        <h1 class="h1-page">Как работает Optimus</h1>
        <p class="lede">
          Optimus в режиме реального времени отслеживает запасы топлива на каждой нефтебазе,
          рассчитывает, когда и в каком объёме заказать, и заранее предупреждает, если план
          поставки нужно скорректировать. Сотруднику остаётся только согласовать решение —
          остальное система делает сама.
        </p>
        <div class="cta-row">
          <a href="/contact?subject=Optimus%20demo" class="btn-primary">Посмотреть демо</a>
          <a href="/case-studies#red-petroleum" class="btn-ghost">Кейс внедрения</a>
        </div>
      </div>
      <img class="hero-art" src="/screens/v2/optimus-network-iso.jpg"
           alt="Сеть под управлением Optimus: нефтебаза, ЖД, бензовоз и станции, связанные в один контур"
           fetchpriority="high" decoding="async"/>
    </div>

    <!-- 01 · ПРОБЛЕМАТИКА -->
    <section data-reveal class="section section-problem">
      <div class="container">
        <div class="section-label">01 · Текущий процесс</div>
        <h2 class="h2-section">Как выглядит процесс сегодня</h2>
        <p class="sec-lede">
          Поставщики, порт, нефтебаза и перевозчики работают каждый по своему процессу,
          а отдел поставок сводит все процессы вручную. Проблемы, как правило, типичные —
          и на них теряется много времени. Переключите на «С Optimus», чтобы увидеть тот же
          процесс, когда система внедрена.
        </p>

        <div class="duo" id="duo">
          <div class="duo-toggle" role="tablist" aria-label="Сегодня или с Optimus">
            <button class="duo-btn is-on" data-mode="chaos" role="tab" aria-selected="true">Как сегодня</button>
            <button class="duo-btn" data-mode="order" role="tab" aria-selected="false">С Optimus</button>
          </div>

          <div class="duo-stage">
            <svg viewBox="0 0 1120 540" preserveAspectRatio="none" aria-hidden="true">
              <g class="lines lines-chaos">
                <path d="M560 60 C 420 60, 260 80, 180 120"/>
                <path d="M560 60 C 700 60, 860 80, 940 120"/>
                <path d="M180 120 C 130 230, 130 330, 180 420"/>
                <path d="M940 120 C 990 230, 990 330, 940 420"/>
                <path d="M180 120 C 420 200, 700 90, 940 130"/>
                <path d="M180 420 C 440 330, 690 460, 940 420"/>
                <path d="M180 120 C 430 260, 700 380, 940 430"/>
                <path d="M180 420 C 420 300, 700 160, 940 125"/>
                <path d="M560 70 C 540 160, 580 190, 560 240"/>
                <path d="M185 425 C 340 380, 470 320, 545 285"/>
              </g>
              <g class="lines lines-order">
                <path id="ln-office" d="M572 90 L 572 145"/>
                <path id="ln-depot" d="M255 145 L 452 232"/>
                <path id="ln-supplier" d="M865 145 L 670 232"/>
                <path id="ln-port" d="M255 400 L 448 288"/>
                <path id="ln-trucks" d="M865 400 L 674 288"/>
              </g>
              <g class="pkt-layer">
                <g class="pkt"><circle class="pkt-halo" r="8"/><circle class="pkt-dot" r="3.5"/>
                  <animateMotion dur="2.2s" begin="0s" repeatCount="indefinite"><mpath href="#ln-depot"/></animateMotion></g>
                <g class="pkt"><circle class="pkt-halo" r="8"/><circle class="pkt-dot" r="3.5"/>
                  <animateMotion dur="2.2s" begin="0.55s" repeatCount="indefinite"><mpath href="#ln-supplier"/></animateMotion></g>
                <g class="pkt"><circle class="pkt-halo" r="8"/><circle class="pkt-dot" r="3.5"/>
                  <animateMotion dur="2.2s" begin="1.1s" repeatCount="indefinite"><mpath href="#ln-port"/></animateMotion></g>
                <g class="pkt"><circle class="pkt-halo" r="8"/><circle class="pkt-dot" r="3.5"/>
                  <animateMotion dur="2.2s" begin="1.65s" repeatCount="indefinite"><mpath href="#ln-trucks"/></animateMotion></g>
                <g class="pkt"><circle class="pkt-halo" r="8"/><circle class="pkt-dot" r="3.5"/>
                  <animateMotion dur="2s" begin="0.8s" repeatCount="indefinite" keyPoints="1;0" keyTimes="0;1" calcMode="linear"><mpath href="#ln-office"/></animateMotion></g>
              </g>
            </svg>

            <div class="duo-node duo-node-accent" style="--x:50%; --y:11%;">Отдел поставок</div>
            <div class="duo-node" style="--x:16%; --y:24%;">Нефтебаза</div>
            <div class="duo-node" style="--x:84%; --y:24%;">Поставщик</div>
            <div class="duo-node" style="--x:16%; --y:76%;">Порт / ЖД</div>
            <div class="duo-node" style="--x:84%; --y:76%;">Бензовозы</div>

            <img class="duo-art" src="/screens/v2/optimus-dispatcher-iso.jpg" alt="" aria-hidden="true"/>
            <img class="duo-art duo-art-happy" src="/screens/v2/optimus-dispatcher-happy-iso.jpg" alt="" aria-hidden="true"/>
            <div class="duo-core duo-core-chaos" style="--x:50%; --y:90%;">
              <b>Ручная сводка</b><span>Excel, звонки, почта</span>
            </div>
            <div class="duo-core duo-core-order" style="--x:50%; --y:92%;">
              <b>Optimus</b><span>пересчёт всей сети в реальном времени</span>
            </div>

            <div class="chip chip-a" style="--x:30%; --y:19%;">Разрозненные системы</div>
            <div class="chip chip-a" style="--x:70%; --y:19%;">Человеческий фактор</div>
            <div class="chip chip-a" style="--x:22%; --y:41%;">Неточные данные</div>
            <div class="chip chip-a" style="--x:78%; --y:41%;">Дисбаланс запасов</div>
            <div class="chip chip-a" style="--x:22%; --y:61%;">Ручной труд и задержки</div>
            <div class="chip chip-a" style="--x:78%; --y:61%;">Замороженный капитал</div>
            <div class="chip chip-a" style="--x:24%; --y:90%;">Бумажный документооборот</div>
            <div class="chip chip-a" style="--x:76%; --y:90%;">Потери продаж</div>

            <div class="chip chip-b" style="--x:30%; --y:19%;">Единый источник данных</div>
            <div class="chip chip-b" style="--x:70%; --y:19%;">Прогноз по каждому резервуару</div>
            <div class="chip chip-b" style="--x:26%; --y:41%;">Заказ кратен цистерне</div>
            <div class="chip chip-b" style="--x:74%; --y:41%;">Поставщик по цене и срокам</div>
            <div class="chip chip-b" style="--x:26%; --y:61%;">Конфликты видны заранее</div>
            <div class="chip chip-b" style="--x:74%; --y:61%;">Меньше капитала в запасах</div>
          </div>

          <div class="duo-strip duo-strip-chaos">
            <b>Последствия:</b> снижение эффективности · финансовые потери · упущенные возможности · рост операционных рисков
          </div>
          <div class="duo-strip duo-strip-order">
            <b>Сотруднику остаётся принять решение</b> — остальное система делает сама
          </div>
        </div>
      </div>
    </section>

    <!-- 02 · ПРОЦЕСС -->
    <section data-reveal class="section section-process">
      <div class="container">
        <div class="section-label">02 · Процесс</div>
        <h2 class="h2-section">От остатка на нефтебазе до новой поставки</h2>
        <p class="sec-lede">
          Обычный путь короткий: система рассчитала потребность → сотрудник согласовал →
          поставщик привёз → топливо приняли на нефтебазе. Нажмите на шаг, чтобы увидеть,
          как устроен процесс.
        </p>

        <div class="proc" id="proc">
          <div class="proc-rail" role="tablist" aria-label="Шаги процесса">
            <button class="proc-step is-active" role="tab" aria-selected="true" data-step="1">
              <span class="proc-num">01</span>
              <span class="proc-name">Автоматическое планирование</span>
              <span class="proc-brief">Optimus получает свежие остатки и расход в режиме реального времени, считает, когда запас дойдёт до критического уровня, и формирует предложение по заказу.</span>
            </button>
            <button class="proc-step" role="tab" aria-selected="false" data-step="2">
              <span class="proc-num">02</span>
              <span class="proc-name">Согласование заказа</span>
              <span class="proc-brief">Сотрудник проверяет предложение и подтверждает его — единственный обязательный шаг с участием сотрудника во всём процессе.</span>
            </button>
            <button class="proc-step" role="tab" aria-selected="false" data-step="3">
              <span class="proc-num">03</span>
              <span class="proc-name">Закупка и поставка</span>
              <span class="proc-brief">Заказ уходит поставщику. Optimus отслеживает движение топлива и заранее видит, если на нефтебазе не хватит места к приезду.</span>
            </button>
            <button class="proc-step proc-step-exc" role="tab" aria-selected="false" data-step="exc">
              <span class="proc-num">!</span>
              <span class="proc-name">Исключение: топливо едет, а места нет</span>
              <span class="proc-brief">Optimus видит такой случай заранее и предлагает сценарии распределения.</span>
            </button>
            <button class="proc-step" role="tab" aria-selected="false" data-step="4">
              <span class="proc-num">04</span>
              <span class="proc-name">Приёмка на нефтебазе</span>
              <span class="proc-brief">Топливо слито в резервуары, поставка зафиксирована. Остатки пересчитываются сразу.</span>
            </button>
          </div>

          <div class="proc-panel" id="proc-panel" role="tabpanel">
            <!-- заполняется скриптом -->
          </div>
        </div>

        <p class="proc-note">
          Функционал системы и скорость обновления данных определяются наличием данных
          на стороне клиента и возможностью интеграции с внутренними системами.
        </p>
      </div>
    </section>


    <!-- 03 · ПОТОКИ ДАННЫХ -->
    <section data-reveal class="section section-data">
      <div class="container">
        <div class="section-label">03 · Интеграция</div>
        <h2 class="h2-section">Потоки данных</h2>
        <p class="sec-lede">
          Optimus не хранит собственные справочники — он забирает данные из систем компании,
          считает решение и возвращает готовый результат обратно.
        </p>

        <div class="dflow">
          <div class="dmid">
            <img class="dflow-art" src="/screens/v2/optimus-dataflow-iso.jpg"
                 alt="Данные из учётных систем стекаются в Optimus и возвращаются в ERP и на дашборды"
                 loading="lazy" decoding="async"/>
            <div class="dcore">Optimus</div>
          </div>

          <div class="dcol dcol-in">
            <div class="dcol-title">На входе</div>
            <div class="dtag"><b>ERP</b><span>Остатки на нефтебазе, заказы на поставку</span></div>
            <div class="dtag"><b>TMS</b><span>Данные по логистике</span></div>
            <div class="dtag"><b>DWH</b><span>Любые структурированные данные</span></div>
            <div class="dtag"><b>Рыночные цены</b><span>Внешние котировки для сравнения поставщиков</span></div>
          </div>

          <div class="dcol dcol-out">
            <div class="dcol-title">На выходе</div>
            <div class="dtag"><b>ERP</b><span>Обновлённые остатки и заказы</span></div>
            <div class="dtag"><b>Дашборды и аналитика</b><span>Прогноз остатков, оборот запасов, капитал в запасах</span></div>
          </div>

        </div>

        <ul class="gains" data-reveal-stagger>
          <li><b>Экономия денег.</b> Система пересчитывает решение по заданным сценариям и учитывает деньги, замороженные в лишних запасах.</li>
          <li><b>Сокращение простоев.</b> Меньше потерь от простоев нефтебаз и транспорта.</li>
          <li><b>Скорость принятия решения.</b> Весь процесс автоматизирован — сотруднику остаётся оценить готовое предложение, а не считать вручную десятки сочетаний нефтебаз и видов топлива.</li>
          <li><b>Повышение качества данных.</b> Оптимизация потоков данных снижает риски, связанные с ручными расчётами и файлами.</li>
        </ul>
      </div>
    </section>

    <!-- ИНТЕРФЕЙС — карусель -->
    <section data-reveal class="section section-ui">
      <div class="container">
        <div class="section-label">Интерфейс</div>
        <h2 class="h2-section">Как это выглядит в системе</h2>
        <p class="sec-lede">
          Шесть рабочих экранов Optimus. Листайте стрелками или точками.
        </p>

        <div class="carousel" id="carousel">
          <div class="car-viewport">
            <div class="car-track" id="car-track"><!-- слайды рисует скрипт --></div>
          </div>
          <button class="car-nav car-prev" id="car-prev" aria-label="Предыдущий экран">‹</button>
          <button class="car-nav car-next" id="car-next" aria-label="Следующий экран">›</button>
          <div class="car-dots" id="car-dots"></div>
        </div>
      </div>
    </section>

    <CTA
      heading="Посмотрите Optimus на живой сети"
      body="Демо-стенд работает на полной модели сети: нефтебазы, резервуары, поставщики, живой пересчёт. Покажем на ваших сценариях."
      primaryLabel="Запросить демо"
      primaryHref="/contact?subject=Optimus%20demo"
      secondaryLabel="Кейс внедрения"
      secondaryHref="/case-studies#red-petroleum"
    />
  </article>
</BaseLayout>

<script>
  const DATA: Record<string, { label: string; title: string; bullets: string[]; images: { src: string; caption: string }[] }> = {
    '1': {
      label: 'Шаг 01', title: 'Автоматическое планирование',
      bullets: [
        'Критичность заказа определяется настраиваемыми порогами остатков на нефтебазе — свои для каждой нефтебазы и вида топлива',
        'Заказ формируется не тогда, когда топливо кончилось, а настолько заранее, чтобы новое успело приехать',
        'Топливо, которое уже в пути, также учитывается в остатках',
        'Заказ всегда кратен заданному объёму цистерны',
        'Поставщик выбирается не только по цене, но и с поправкой на сроки и надёжность поставки',
        'Дополнительный заказ можно разместить вручную в любой момент',
      ],
    },
    '2': {
      label: 'Шаг 02', title: 'Согласование заказа',
      bullets: [
        'Сотрудник оценивает предложенный объём, поставщика и итоговую стоимость заказа',
        'Предложение можно скорректировать вручную перед подтверждением',
        'Это единственный обязательный шаг с участием сотрудника во всём процессе',
      ],
    },
    '3': {
      label: 'Шаг 03', title: 'Закупка и поставка',
      bullets: [
        'Optimus отслеживает поставку и заранее оценивает загрузку резервуаров с учётом топлива, которое уже в дороге',
        'Учитывается скорость слива и время отбора проб, чтобы не включать это время в простой',
        'Если к приезду резервуар окажется полон — система предложит сценарии распределения',
      ],
    },
    'exc': {
      label: 'Исключение', title: 'Что если топливо приедет, а места не будет?',
      bullets: [
        'Optimus считает остаток на много дней вперёд и видит заранее, что резервуар к моменту приезда будет полон',
        'Тогда система предложит распределить топливо по другим нефтебазам, чтобы не было простоев и штрафов',
        'Для каждого случая она считает: через сколько суток освободится место, сколько цистерн не поместится, сколько дней они простоят и во что это обойдётся',
        'Если на одной нефтебазе излишек, а на другой нехватка — дешевле перевезти топливо между ними, чем заказывать новое',
      ],
    },
    '4': {
      label: 'Шаг 04', title: 'Приёмка на нефтебазе',
      bullets: [
        'Факт доставки фиксируется в системе',
        'Остатки обновляются, и расчёт по сети выполняется заново',
        'Данные передаются обратно в ERP и на дашборды',
      ],
    },
  };


  /* Изометрические пиктограммы шагов — в стиле иллюстраций страницы */
  /* Заглушки под пиктограммы шагов. Dennis генерит в nanobanana,
   * затем сюда подставляются пути к картинкам вместо блока-заглушки. */
  const PICTO: Record<string, { file: string; what: string; prompt: string }> = {
    '1': {
      file: 'step-1-planning.jpg',
      what: 'Монитор с растущим графиком остатка и линией критического уровня; рядом маленький значок «обновление в реальном времени».',
      prompt: 'Isometric 3D illustration, matte dark charcoal #1D1D1F objects, glowing orange #FF6A00 accent lines, pure white background, soft shadows. A single flat monitor on a small platform showing a simple line chart declining toward a marked threshold line. No text, no letters, no numbers, no people, no logos. Square composition.'
    },
    '2': {
      file: 'step-2-approval.jpg',
      what: 'Карточка заказа и крупная галочка подтверждения — единственный шаг, где нужен человек.',
      prompt: 'Isometric 3D illustration, matte dark charcoal #1D1D1F objects, glowing orange #FF6A00 accent lines, pure white background, soft shadows. A single document card on a small platform with a large glowing orange checkmark hovering above it. No text, no letters, no numbers, no people, no logos. Square composition.'
    },
    '3': {
      file: 'step-3-supply.jpg',
      what: 'Цистерна на рельсах в движении, оранжевая линия маршрута к нефтебазе.',
      prompt: 'Isometric 3D illustration, matte dark charcoal #1D1D1F objects, glowing orange #FF6A00 accent lines, pure white background, soft shadows. A single rail tank car on a short piece of track, with a glowing orange route line running ahead of it. No text, no letters, no numbers, no people, no logos. Square composition.'
    },
    'exc': {
      file: 'step-exc-conflict.jpg',
      what: 'Полный резервуар и ждущая рядом цистерна; сверху значок времени — груз приехал, а места нет.',
      prompt: 'Isometric 3D illustration, matte dark charcoal #1D1D1F objects, glowing orange #FF6A00 accent lines, pure white background, soft shadows. A storage tank filled to the top next to a waiting rail tank car, with a small glowing orange hourglass floating above. No text, no letters, no numbers, no people, no logos. Square composition.'
    },
    '4': {
      file: 'step-4-receiving.jpg',
      what: 'Резервуар, который наполняется: уровень поднимается, стрелка вниз в горловину.',
      prompt: 'Isometric 3D illustration, matte dark charcoal #1D1D1F objects, glowing orange #FF6A00 accent lines, pure white background, soft shadows. A storage tank being filled, the fuel level glowing orange inside it and an arrow pointing down into its inlet. No text, no letters, no numbers, no people, no logos. Square composition.'
    }
  };

  const panel = document.getElementById('proc-panel')!;
  const steps = Array.from(document.querySelectorAll<HTMLButtonElement>('.proc-step'));

  function render(key: string) {
    const d = DATA[key];
    if (!d) return;
    panel.innerHTML = `
      <div class="pp-label">${d.label}</div>
      <h3 class="pp-title">${d.title}</h3>
      <ul class="pp-bullets">${d.bullets.map((b) => `<li>${b}</li>`).join('')}</ul>
      ${PICTO[key] ? `
        <div class="pp-slot">
          <div class="pp-slot-tag">Пиктограмма · заглушка</div>
          <div class="pp-slot-what">${PICTO[key].what}</div>
          <div class="pp-slot-file">/screens/v2/${PICTO[key].file}</div>
          <details class="pp-slot-prompt"><summary>Промпт для nanobanana</summary><code>${PICTO[key].prompt}</code></details>
        </div>` : ''}
    `;
  }

  steps.forEach((btn) => {
    btn.addEventListener('click', () => {
      steps.forEach((b) => { b.classList.toggle('is-active', b === btn); b.setAttribute('aria-selected', String(b === btn)); });
      render(btn.dataset.step!);
    });
  });
  render('1');

  /* ---------------- карусель экранов ---------------- */
  const SLIDES = [
    { src: '/screens/v2/advisor-ru.png',
      caption: 'Советник по закупкам: что критично, что заказать, у кого и когда',
      alt: 'Советник по закупкам Optimus: критичные позиции, рекомендации по заказам, поставщики и сроки',
      anns: [
        { x: 6,  y: 10, side: 'top', text: 'Критично / заказать / в норме — вся сеть одним списком' },
        { x: 55, y: 26, side: 'top', text: 'Объём кратен цистерне, поставщик и крайняя дата заказа' },
        { x: 84, y: 50, side: 'top', text: 'Обоснование решения — словами, с рисками' }
      ] },
    { src: '/screens/v2/fill-levels-ru.png',
      caption: 'Заполнение по каждому виду топлива, с прогнозом до критического уровня',
      alt: 'Заполнение резервуаров Optimus по видам топлива с прогнозом до критического уровня', anns: [] },
    { src: '/screens/v2/supply-feed-ru.png',
      caption: 'Лента поставок: статус каждой партии и риск не поместиться в резервуар',
      alt: 'Лента поставок Optimus: хронология подтверждённых поставок по дням со статусами',
      anns: [
        { x: 76, y: 13, side: 'top',    text: '35 поставок, 208 цистерн — и только 2 конфликта, найденных заранее' },
        { x: 30, y: 44, side: 'bottom', text: 'Каждая партия: статус и «поместится ли в резервуар в день прибытия»' }
      ] },
    { src: '/screens/v2/conflicts-ru.png',
      caption: 'Конфликты поставок: что не влезает и во сколько обойдётся ожидание',
      alt: 'Конфликты поставок Optimus: цистерны, которые не помещаются, и стоимость простоя', anns: [] },
    { src: '/screens/v2/turnover-ru.png',
      caption: 'Скорость оборота запасов по видам топлива',
      alt: 'Оборот запасов Optimus: дни запаса и капитал по видам топлива', anns: [] },
    { src: '/screens/v2/scenarios-ru.png',
      caption: 'Сравнение сценариев закупки и их влияние на капитал',
      alt: 'Сравнение сценариев закупки Optimus и их влияние на капитал в запасах', anns: [] }
  ];

  const track = document.getElementById('car-track');
  const dots = document.getElementById('car-dots');
  if (track && dots) {
    track.innerHTML = SLIDES.map((sl) => `
      <figure class="car-slide">
        <div class="shot-frame">
          <img src="${sl.src}" alt="${sl.alt}" loading="lazy" decoding="async"/>
          ${sl.anns.map((a) => `<i class="ann-dot" style="--x:${a.x}%; --y:${a.y}%"></i>`).join('')}
          ${sl.anns.map((a) => `<div class="ann ann-${a.side}" style="--ax:${a.x}%">${a.text}</div>`).join('')}
        </div>
        <figcaption>${sl.caption}</figcaption>
      </figure>`).join('');
    dots.innerHTML = SLIDES.map((_, i) => `<button type="button" data-slide="${i}" aria-current="${i === 0}" aria-label="Экран ${i + 1}"></button>`).join('');

    let idx = 0;
    const show = (n) => {
      idx = (n + SLIDES.length) % SLIDES.length;
      track.style.transform = `translateX(-${idx * 100}%)`;
      dots.querySelectorAll('button').forEach((b, i) => b.setAttribute('aria-current', String(i === idx)));
    };
    document.getElementById('car-prev').addEventListener('click', () => show(idx - 1));
    document.getElementById('car-next').addEventListener('click', () => show(idx + 1));
    dots.addEventListener('click', (e) => {
      const b = e.target.closest('[data-slide]'); if (b) show(Number(b.dataset.slide));
    });
    document.getElementById('carousel').addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(idx - 1);
      if (e.key === 'ArrowRight') show(idx + 1);
    });
  }


  // Поводки колаутов: запуск отрисовки при появлении в вьюпорте
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('.shot-annot').forEach((fig) => {
    if (reduceMotion) { fig.classList.add('ann-go'); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        fig.classList.add('ann-go');
        io.disconnect();
      });
    }, { threshold: 0.35 });
    io.observe(fig);
  });

  // «Сегодня / С Optimus»
  const duo = document.getElementById('duo')!;
  duo.querySelectorAll<HTMLButtonElement>('.duo-btn').forEach((b) => {
    b.addEventListener('click', () => {
      duo.classList.toggle('is-order', b.dataset.mode === 'order');
      duo.querySelectorAll('.duo-btn').forEach((x) => { x.classList.toggle('is-on', x === b); x.setAttribute('aria-selected', String(x === b)); });
    });
  });
</script>

<style>
  .prose-page { padding-top: clamp(40px, 6vh, 72px); }
