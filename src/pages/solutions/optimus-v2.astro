    position: absolute; top: 44%; transform: translateY(-50%); width: 44px; height: 44px; border-radius: 50%;
    background: var(--card); border: 1px solid var(--border); font-size: 22px; line-height: 1; color: var(--text-primary);
    box-shadow: 0 6px 20px rgba(0,0,0,.10); cursor: pointer; z-index: 3;
  }
  .car-nav:hover { border-color: var(--accent); color: var(--accent-text); }
  .car-prev { left: -14px; } .car-next { right: -14px; }
  .car-dots { display: flex; gap: 7px; justify-content: center; margin-top: 18px; }
  .car-dots button { width: 8px; height: 8px; border-radius: 50%; border: 0; background: var(--border-hover); cursor: pointer; padding: 0; }
