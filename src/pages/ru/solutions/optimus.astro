---
// Русская страница Optimus. Русский — частичный язык: он покрывает ровно
// этот путь (PARTIAL_LOCALE_PATHS в src/i18n/config.ts), поэтому флаг RU
// появляется в переключателе только здесь и на английской версии страницы.
// Разметка и тексты общие с ней: OptimusPage.astro + i18n/pages/optimus-page.ts.
import BaseLayout from '~/layouts/BaseLayout.astro';
import OptimusPage from '~/components/OptimusPage.astro';
import { useOptimusPage } from '~/i18n/pages/optimus-page';

const t = useOptimusPage(Astro.currentLocale);
---

<BaseLayout title={t.meta.title} description={t.meta.description} ogImage="/og/optimus-v2.png">
  <OptimusPage />
</BaseLayout>
