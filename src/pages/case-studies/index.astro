---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CTA from '~/components/CTA.astro';

// Smaller / earlier engagements — separate bucket from the marquee five.
// Listed for completeness, not heavyweight. Add new entries by dropping
// a logo into public/logos/ and appending here.
const smallerEngagements = [
  {
    name: 'Clubtek',
    region: 'Thailand',
    blurb: 'Premium audio, light, and video integration. Top-tier event and venue work.',
    logo: '/logos/clubtek.png',
  },
  {
    name: 'Khaos Marani',
    region: 'Georgia',
    blurb: 'Winery. Advanced analytics and predictive ML to forecast wine demand, optimise pricing, and segment consumers for targeted marketing.',
    logo: null,
    monogram: 'KM',
  },
  {
    name: 'Geo Engineering',
    region: 'CIS',
    blurb: 'Pump manufacturer (Alliance Industry Group). SaaS AI solutions, including an internal chatbot to streamline communications and operations.',
    logo: null,
    monogram: 'GE',
  },
  {
    name: 'KliverYards',
    region: 'CIS',
    blurb: 'Specialised steel structures and drilling rigs. Data analysis on project delays plus computer vision for production efficiency.',
    logo: null,
    monogram: 'KY',
  },
  {
    name: 'RiskTekConsult',
    region: 'CIS',
    blurb: 'Specialised risk consultancy. Advanced analytics for failure analysis and prevention.',
    logo: null,
    monogram: 'RT',
  },
];

const cases = [
  {
    href: '/case-studies/red-petroleum',
    client: 'Red Petroleum',
    logo: '/logos/red-petroleum.png',
    industry: 'Fuel retail',
    region: 'Kyrgyzstan',
    summary:
      'A full data & AI transformation — supply chain, customers, operations, data foundation. Optimus, the procurement engine, in pilot.',
    status: 'Featured',
    featured: true,
  },
  {
    href: '/case-studies/click-and-grow',
    client: 'Click & Grow',
    logo: '/logos/click-and-grow.png',
    industry: 'B2C — smart indoor gardens',
    region: 'Eastern Europe / CIS',
    summary:
      'Customer analytics and ML segmentation to find where the high-value segments actually were, then act on them.',
    status: 'Delivered',
  },
  {
    href: '/case-studies/gte',
    client: 'GTE',
    logo: '/logos/gte.png',
    industry: 'Industrial — compressors',
    region: 'EU',
    summary:
      'Reporting platform across finance and manufacturing, plus ML prototypes for compressor anomaly detection and energy optimisation.',
    status: 'Delivered',
  },
  {
    href: '/case-studies/kricon',
    client: 'Kricon',
    logo: '/logos/kricon.png',
    industry: 'International logistics',
    region: 'Cross-border',
    summary:
      'Operational visibility across the route network — reporting infrastructure plus anomaly-detection and clustering models for ops-level signals.',
    status: 'Delivered',
  },
  {
    href: '/case-studies/csc-telecom',
    client: 'CSC Telecom',
    logo: '/logos/csc-telecom.png',
    industry: 'Telecom',
    region: 'Global',
    summary:
      'Customer and product analytics for a global Travel/Tourist SIM business. Each study shaped to land a specific decision rather than fill a report.',
    status: 'Delivered',
  },
  {
    href: '/case-studies/taxi',
    client: 'Ride-hailing platform',
    logo: null,
    monogram: 'RH',
    industry: 'Ride-hailing — aggregator',
    region: 'Baltics',
    summary:
      'Data deep-dive plus ML for dynamic pricing and ride-demand forecasting at a leading Baltic ride-hailing platform. Client unnamed while the engagement is in progress.',
    status: 'In progress',
  },
];
---

<BaseLayout
  title="Case studies — KKT"
  description="Walkable investigations of what we shipped and what it moved."
  ogImage="/og/case-studies.png"
>
  <article class="prose-page">
    <div class="container">
      <div class="section-label">Case studies</div>
      <h1 class="h1-page">What we shipped, what it moved.</h1>
      <p class="lede">
        Walkable investigations. Each case is the
        engagement as it actually ran: where it started, what shipped,
        what it changed in the business.
      </p>

      <div class="cases-strip">
        <div class="cases-stat">
          <div class="cases-stat-num">10+</div>
          <div class="cases-stat-label">engagements shipped</div>
        </div>
        <div class="cases-stat">
          <div class="cases-stat-num">8+</div>
          <div class="cases-stat-label">sectors</div>
        </div>
        <div class="cases-stat">
          <div class="cases-stat-num">$600M</div>
          <div class="cases-stat-label">largest client, Red Petroleum</div>
        </div>
      </div>

      <ul class="case-list" data-reveal-stagger>
        {cases.map((c) => (
          <li>
            <a href={c.href} class={`case-card ${c.featured ? 'case-card-featured' : ''}`}>
              <div class="case-logo">
                {c.logo
                  ? <img src={c.logo} alt={`${c.client} logo`} width="150" height="150" loading="lazy" />
                  : <span class="case-monogram" aria-hidden="true">{c.monogram}</span>}
              </div>
              <div class="case-meta">
                <span class={`case-status ${c.featured ? 'is-featured' : ''}`}>{c.status}</span>
                <span class="case-sep">·</span>
                <span>{c.industry}</span>
                <span class="case-sep">·</span>
                <span>{c.region}</span>
              </div>
              <h2 class="case-client">{c.client}</h2>
              <p class="case-summary">{c.summary}</p>
              <span class="case-arrow">Read the case →</span>
            </a>
          </li>
        ))}
      </ul>

      {smallerEngagements.length > 0 && (
        <section data-reveal class="smaller">
          <div class="section-label">Smaller engagements</div>
          <h2 class="h2-section">Earlier and adjacent work.</h2>
          <p class="smaller-lede">
            Listed for completeness — real shipped work, earlier or
            adjacent to the engagements we lead with.
          </p>
          <ul class="smaller-grid" data-reveal-stagger>
            {smallerEngagements.map((s) => (
              <li class="smaller-card">
                <div class="smaller-logo">
                  {s.logo
                    ? <img src={s.logo} alt={`${s.name} logo`} loading="lazy" />
                    : <span class="smaller-monogram" aria-hidden="true">{s.monogram}</span>}
                </div>
                <div class="smaller-meta">
                  <div class="smaller-name">{s.name}</div>
                  <div class="smaller-region">{s.region}</div>
                </div>
                <p class="smaller-blurb">{s.blurb}</p>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>

    <CTA />
  </article>
</BaseLayout>

<style>
  .prose-page { padding-top: clamp(40px, 6vh, 72px); }
  .section-label { margin-bottom: 18px; }
  .h1-page {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 600;
    font-size: clamp(32px, 4.5vw, 48px);
    line-height: 1.16;
    margin-bottom: 18px;
    letter-spacing: -0.01em;
    max-width: 22ch;
  }
  .lede {
    font-size: clamp(17px, 2vw, 20px);
    color: var(--text-secondary);
    line-height: 1.55;
    max-width: 56ch;
    margin-bottom: 40px;
  }
  .cases-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 36px;
    margin-bottom: 28px;
    padding: 18px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .cases-stat { display: flex; flex-direction: column; gap: 2px; }
  .cases-stat-num {
    font-family: var(--font-display);
    font-style: normal;
    font-size: clamp(28px, 3.6vw, 36px);
    color: var(--accent);
    line-height: 1;
  }
  .cases-stat-label {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
    max-width: 24ch;
  }

  .cases-pull {
    margin: 0 0 36px;
    padding: 22px 26px;
    background: var(--surface-alt);
    border-left: 3px solid var(--accent);
    border-radius: 0 4px 4px 0;
    max-width: 720px;
  }
  .cases-pull p {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 600;
    font-size: clamp(18px, 2.2vw, 22px);
    line-height: 1.35;
    color: var(--text-primary);
    margin: 0;
    max-width: 38ch;
  }

  .case-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 16px;
  }
  .case-card {
    display: block;
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    text-decoration: none;
    color: inherit;
    transition: border-color .18s ease;
  }
  .case-card:hover {
    border-color: var(--border-hover);
    text-decoration: none;
  }
  .case-card-featured {
    padding: 32px;
    border-top: 3px solid var(--accent);
  }
  .case-card-featured .case-client {
    font-size: 32px;
  }
  .case-status.is-featured {
    color: var(--accent);
  }

  .case-logo {
    width: 116px;
    height: 60px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 10px 16px;
    margin-bottom: 18px;
  }
  .case-logo img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }
  .case-card-featured .case-logo {
    width: 132px;
    height: 68px;
  }
  .case-monogram {
    font-family: var(--font-display);
    font-style: normal;
    font-size: 24px;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  .cases-carveout {
    font-size: 13px;
    color: var(--text-muted);
    font-style: normal;
    max-width: 60ch;
    margin: -22px 0 36px;
  }

  .smaller {
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid var(--border);
  }
  .smaller .section-label { margin-bottom: 14px; }
  .smaller h2 { margin-bottom: 14px; max-width: 26ch; }
  .smaller-lede {
    max-width: 60ch;
    margin-bottom: 28px;
    color: var(--text-secondary);
  }
  .smaller-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 720px) {
    .smaller-grid { grid-template-columns: 1fr 1fr; }
  }
  .smaller-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 22px 24px;
    display: grid;
    grid-template-columns: 60px 1fr;
    column-gap: 16px;
    row-gap: 8px;
    align-items: start;
  }
  .smaller-logo {
    grid-row: 1 / span 2;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .smaller-logo img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .smaller-monogram {
    font-family: var(--font-display);
    font-style: normal;
    font-size: 20px;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }
  .smaller-name {
    font-family: var(--font-display);
    font-style: normal;
    font-size: 22px;
    color: var(--text-primary);
    line-height: 1.2;
  }
  .smaller-region {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
    margin-top: 2px;
  }
  .smaller-blurb {
    grid-column: 1 / -1;
    font-size: 14px;
    color: var(--text-secondary);
    margin: 0;
    max-width: 56ch;
  }
  .case-meta {
    font-size: 12px;
    color: var(--text-muted);
    margin-bottom: 10px;
    letter-spacing: 0.04em;
  }
  .case-status {
    color: var(--accent-text);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .case-sep { margin: 0 6px; }
  .case-client {
    font-family: var(--font-display);
    font-style: normal;
    font-size: 26px;
    color: var(--text-primary);
    margin-bottom: 10px;
    font-weight: 600;
  }
  .case-summary {
    margin-bottom: 14px;
    max-width: 60ch;
  }
  .case-arrow {
    font-size: 13px;
    color: var(--text-primary);
    font-weight: 500;
  }
</style>
