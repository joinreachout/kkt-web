---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CTA from '~/components/CTA.astro';
import RelatedCases from '~/components/RelatedCases.astro';
import CaseSnapshot from '~/components/CaseSnapshot.astro';
---

<BaseLayout
  title="Kricon — Case study — KKT"
  description="Operational analytics for a mid-sized international logistics operator."
>
  <article class="prose-page">
    <div class="container">
      <div class="section-label section-label-prior">Case study — Kricon &middot; Earlier engagement (predates current ICP focus)</div>
      <h1 class="h1-page">Kricon — operational visibility across the route network.</h1>

      <CaseSnapshot
        industry="International logistics"
        region="Cross-border"
        status="Delivered"
        situation="Operational data was fragmented across the route network — no single view, and no clear read on where data and AI would actually pay back."
        shipped="A unified reporting platform, an anomaly-detection layer over shipment signals, and operational clustering across the network."
        outcome="One operational decision surface, incidents surfaced before they cascade, and a prioritised plan with the first pieces already running."
        stack={['PowerBI', 'DBT', 'PostgreSQL', 'custom ELT', 'XGB / IsolationForest / DBSCAN']}
      />

      <section data-reveal class="shipped">
        <div class="shipped-label">What shipped</div>
        <ul>
          <li><strong>Unified reporting platform</strong> — pulled fragmented operational data sources into a single decision surface.</li>
          <li><strong>Anomaly-detection layer</strong> — ML models running over shipment-level signals to surface incidents before they cascade.</li>
          <li><strong>Operational clustering</strong> — pattern-finding across the route network to reveal where intervention pays back fastest.</li>
        </ul>
      </section>

      <p class="editorial-note">
        Walkable case in editorial. Deeper write-up of the engagement and
        what shipped follows in Phase 1.5.
      </p>
    </div>

    <RelatedCases current="kricon" />

    <CTA />
  </article>
</BaseLayout>

<style>
  .prose-page { padding-top: clamp(40px, 6vh, 72px); }
  .section-label { margin-bottom: 18px; }
  .h1-page {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(30px, 4.2vw, 44px);
    line-height: 1.16;
    margin-bottom: 36px;
    letter-spacing: -0.01em;
    max-width: 26ch;
  }
  .topline {
    max-width: 720px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 24px 28px;
    margin-bottom: 32px;
  }
  .topline-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    font-size: 15px;
    color: var(--text-primary);
  }
  .topline-row:last-child { border-bottom: none; }
  .topline-label {
    color: var(--text-muted);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    align-self: center;
  }
  .live-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #2A8A62;
    margin-right: 8px;
    vertical-align: middle;
  }
  .prose-block { max-width: 700px; margin-bottom: 32px; }
  .prose-block p { margin-bottom: 14px; max-width: 64ch; }

  .stack {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 18px 22px;
    max-width: 700px;
    margin-bottom: 32px;
  }
  .stack-label {
    font-size: 11px;
    color: var(--accent-text);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .stack p {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-secondary);
    margin: 0;
  }
  .editorial-note {
    font-size: 13px;
    color: var(--text-muted);
    font-style: italic;
    max-width: 60ch;
  }

  .shipped {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 0 4px 4px 0;
    padding: 22px 26px;
    max-width: 720px;
    margin-bottom: 32px;
  }
  .shipped-label {
    font-size: 11px;
    color: var(--accent-text);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 14px;
  }
  .shipped ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .shipped li {
    font-size: 14px;
    line-height: 1.6;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
    max-width: 64ch;
  }
  .shipped li:last-child { padding-bottom: 0; border-bottom: none; }
  .shipped strong { color: var(--text-primary); font-weight: 600; }

</style>
