---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import HowWeWork from '~/components/HowWeWork.astro';
import WhyUs from '~/components/WhyUs.astro';
import MediaSlot from '~/components/MediaSlot.astro';
import CTA from '~/components/CTA.astro';

// Trust strip variant — flip to 'A' or 'B' if Red Petroleum consent tier shifts.
// See WORK/briefs/alfa-oil-content-brief.md.
const trustVariant = 'C' as const;
---

<BaseLayout
  title="KKT — operating systems for retail and fuel networks"
  description="A senior data & AI team with roots in business — data foundations, ML, and AI agents, shipped into real operations. Tallinn, EU."
>
  <Hero trustVariant={trustVariant} />

  <HowWeWork />

  <WhyUs />

  <section class="section section-industries" data-reveal>
    <div class="container">
      <div class="section-label">Where we work</div>
      <h2 class="h2-section">We go all the way into the business.</h2>
      <p class="industries-lede">
        Retail and fuel networks are where we go deepest — but we've shipped
        data and AI across telecom, mobility, industry, risk and more.
        Inside each, the whole operation: procurement and margin, logistics,
        customers, finance, and the data foundation under it. Not one tool.
      </p>
      <div class="industry-grid" data-reveal-stagger>
        <a href="/industries/retail" class="industry-card">
          <MediaSlot class="industry-media" ratio="16 / 9" kind="image" label="Retail — store, shelf, or analytics screen" />
          <div class="industry-eyebrow">Retail</div>
          <h3 class="industry-title">Mid-sized retailers</h3>
          <p>
            Your data is already there — POS, ERP, loyalty, stock, finance.
            We connect it into one trusted base, then forecasting,
            promotions, margin and loyalty on top.
          </p>
          <div class="industry-stat">
            <span class="industry-stat-num">43</span>
            <span class="industry-stat-label">services across 11 retail domains in the open playbook</span>
          </div>
          <span class="industry-arrow">See the playbook →</span>
        </a>

        <a href="/industries/fuel-retail" class="industry-card">
          <MediaSlot class="industry-media" ratio="16 / 9" kind="image" label="Fuel — station, depot, or network map" />
          <div class="industry-eyebrow">Fuel retail</div>
          <h3 class="industry-title">Fuel networks</h3>
          <p>
            Connected data first, then AI where it earns its place — across
            supply and procurement, logistics and the depot, station
            operations, the shop and café, and customer loyalty.
          </p>
          <div class="industry-stat">
            <span class="industry-stat-num">7</span>
            <span class="industry-stat-label">blocks from supply and logistics to stations, customers and the data foundation</span>
          </div>
          <span class="industry-arrow">Explore the fuel map →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section-capabilities" data-reveal>
    <div class="container">
      <div class="section-label">What we do</div>
      <h2 class="h2-section">A full data & AI practice, shipped into real operations.</h2>
      <p class="cap-lede">
        A senior team with roots in business, not just tech. We work the
        whole path — from a low-risk prototype to a production system that
        runs without us.
      </p>
      <div class="cap-grid" data-reveal-stagger>
        <div class="cap-card">
          <div class="cap-eyebrow">01</div>
          <h3 class="cap-title">Data &amp; analytics</h3>
          <p>We dive into your data — POS, ERP, loyalty, finance — surface the trends that move decisions, and stand up the warehouse, BI and text-to-SQL underneath.</p>
        </div>
        <div class="cap-card">
          <div class="cap-eyebrow">02</div>
          <h3 class="cap-title">ML models</h3>
          <p>Segmentation, demand and price forecasting, dynamic pricing, optimisation, anomaly detection, recommendation engines — built for a decision, not a demo.</p>
        </div>
        <div class="cap-card">
          <div class="cap-eyebrow">03</div>
          <h3 class="cap-title">AI assistants &amp; automation</h3>
          <p>LLM assistants and chatbots, OCR, computer vision, agentic workflows — plus ready-to-use AI tools fitted to your operation for quicker ROI.</p>
        </div>
        <div class="cap-card">
          <div class="cap-eyebrow">04</div>
          <h3 class="cap-title">Prototyping — test before invest</h3>
          <p>Low-risk AI/ML prototypes that prove the value on your data before you commit to a full build.</p>
        </div>
        <div class="cap-card">
          <div class="cap-eyebrow">05</div>
          <h3 class="cap-title">AI strategy &amp; enablement</h3>
          <p>We translate business challenges into an AI roadmap, and bring your team up to speed with practical, non-technical training.</p>
        </div>
        <div class="cap-card">
          <div class="cap-eyebrow">06</div>
          <h3 class="cap-title">AI ethics &amp; regulatory</h3>
          <p>Guidance through AI's ethical and regulatory landscape, so adoption stays compliant.</p>
        </div>
      </div>
      <p class="cap-tail">
        <a href="/case-studies/" class="cap-link">See it in the work — fuel, retail, telecom, industry and more →</a>
      </p>
    </div>
  </section>

  <section class="section section-pullquote" data-reveal>
    <div class="container">
      <blockquote class="pullquote">
        <p>
          We don't start with the technology. We start with the business
          question — then build the data, the processes, and the AI that
          earns its place, and stay until the system runs without us.
        </p>
      </blockquote>
    </div>
  </section>

  <section class="section section-infographic theme-dark" data-reveal>
    <div class="container">
      <div class="section-label">The whole operation</div>
      <h2 class="h2-section infographic-title">Not one tool — the whole path, on connected data.</h2>
      <p class="infographic-lede">
        From the business question through the data foundation, the models, and the
        AI that earns its place — to a system your team runs without us.
      </p>
      <MediaSlot
        class="infographic-band"
        kind="infographic"
        ratio="16 / 6"
        label="Value chain / capability map — supply · logistics · stations · customers · finance · data foundation"
        caption="To be built in code (SVG), in the style of the fuel transformation map."
      />
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  .section-industries {
    padding-top: clamp(48px, 7vh, 80px);
    padding-bottom: clamp(48px, 7vh, 80px);
    border-top: 1px solid var(--border);
  }
  .section-industries .section-label,
  .section-featured .section-label {
    margin-bottom: 12px;
  }
  .section-industries h2 {
    margin-bottom: 14px;
    max-width: 22ch;
  }
  .industries-lede {
    max-width: 62ch;
    margin-bottom: 36px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .industry-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }
  @media (min-width: 720px) {
    .industry-grid {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
  }

  .industry-card {
    display: block;
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    text-decoration: none;
    transition: border-color .18s ease, transform .18s ease;
    color: inherit;
  }
  .industry-card:hover {
    border-color: var(--border-hover);
    text-decoration: none;
  }
  .industry-eyebrow {
    font-size: 11px;
    color: var(--accent-text);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .industry-title {
    font-family: var(--font-display);
    font-style: normal;
    font-size: 24px;
    color: var(--text-primary);
    margin-bottom: 10px;
    font-weight: 600;
  }
  .industry-card p {
    font-size: 15px;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }
  .industry-arrow {
    font-size: 13px;
    color: var(--text-primary);
    font-weight: 500;
  }
  .industry-stat {
    margin: 16px 0;
    padding: 12px 0;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .industry-stat-num {
    font-family: var(--font-display);
    font-style: normal;
    font-size: 32px;
    color: var(--accent);
    line-height: 1;
    flex-shrink: 0;
  }
  .industry-stat-label {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.4;
    max-width: 28ch;
  }

  .section-capabilities {
    padding-top: clamp(48px, 7vh, 80px);
    padding-bottom: clamp(48px, 7vh, 80px);
    border-top: 1px solid var(--border);
  }
  .section-capabilities h2 { margin-bottom: 14px; max-width: 22ch; }
  .cap-lede {
    max-width: 62ch;
    margin-bottom: 36px;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .cap-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 720px) {
    .cap-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1000px) {
    .cap-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .cap-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 22px 22px 24px;
  }
  .cap-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--accent-text);
    margin-bottom: 12px;
  }
  .cap-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }
  .cap-card p { font-size: 14px; line-height: 1.55; color: var(--text-secondary); margin: 0; }
  .cap-tail { margin-top: 24px; }
  .cap-link {
    font-size: 14px;
    color: var(--text-primary);
    font-weight: 600;
    text-decoration: none;
  }
  .cap-link:hover { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--accent); }

  .section-pullquote {
    padding: clamp(48px, 7vh, 88px) 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface-alt);
  }
  .pullquote {
    margin: 0 auto;
    max-width: 760px;
    padding: 0;
  }
  .pullquote p {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 600;
    font-size: clamp(24px, 3.4vw, 38px);
    line-height: 1.25;
    color: var(--text-primary);
    margin: 0;
    max-width: 24ch;
  }

  .section-featured {
    padding-top: clamp(48px, 7vh, 80px);
    padding-bottom: clamp(48px, 7vh, 80px);
  }
  .section-featured h2 {
    margin-bottom: 28px;
    max-width: 22ch;
  }
  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: stretch;
  }
  @media (min-width: 880px) {
    .featured-grid {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
  }
  .featured-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 28px;
    display: flex;
    flex-direction: column;
  }
  .featured-text {
    justify-content: space-between;
  }
  .featured-body {
    margin-bottom: 24px;
  }
  .featured-stats {
    display: flex;
    gap: 28px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }
  .featured-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .featured-stat-num {
    font-family: var(--font-display);
    font-style: normal;
    font-size: 36px;
    color: var(--accent);
    line-height: 1;
  }
  .featured-stat-label {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
  }
  .featured-cta {
    align-self: flex-start;
  }
  .featured-visual {
    justify-content: center;
    align-items: stretch;
  }

  .section-howweship {
    padding-top: clamp(48px, 7vh, 80px);
    padding-bottom: clamp(48px, 7vh, 80px);
    border-top: 1px solid var(--border);
    background: var(--surface-alt);
  }
  .section-howweship .section-label { margin-bottom: 12px; }
  .section-howweship h2 { margin-bottom: 28px; max-width: 22ch; }

  .engagement-arc {
    margin: 0 0 36px;
    padding: 28px 32px 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-primary);
  }
  .engagement-arc svg { width: 100%; height: auto; display: block; }

  .hws-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    margin-bottom: 28px;
  }
  @media (min-width: 720px) {
    .hws-grid { grid-template-columns: 1fr 1fr; }
  }
  .hws-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 24px 26px;
  }
  .hws-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent-text);
    font-weight: 600;
    letter-spacing: 0.06em;
    margin-bottom: 12px;
  }
  .hws-title {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 600;
    font-size: 22px;
    color: var(--text-primary);
    margin-bottom: 10px;
    line-height: 1.2;
  }
  .hws-card p { font-size: 15px; max-width: 50ch; }
  .hws-tail { margin-top: 8px; }
  .hws-link {
    font-size: 14px;
    color: var(--text-primary);
    font-weight: 500;
    text-decoration: none;
  }
  .hws-link:hover { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--accent); }

  /* Media-slot placements */
  .industry-media { margin-bottom: 18px; }

  .section-infographic {
    padding-top: clamp(48px, 7vh, 88px);
    padding-bottom: clamp(48px, 7vh, 88px);
  }
  .section-infographic .section-label { margin-bottom: 12px; }
  .infographic-title { margin-bottom: 14px; max-width: 24ch; }
  .infographic-lede {
    max-width: 60ch;
    margin-bottom: 32px;
    color: var(--text-secondary);
    line-height: 1.6;
  }
</style>
