---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import HowWeWork from '~/components/HowWeWork.astro';
import WhyUs from '~/components/WhyUs.astro';
import ClientCases from '~/components/ClientCases.astro';
import CTA from '~/components/CTA.astro';

// Trust strip variant — flip to 'A' or 'B' if Red Petroleum consent tier shifts.
// See WORK/briefs/alfa-oil-content-brief.md.
const trustVariant = 'C' as const;
---

<BaseLayout
  title="Kitty Kat Technologies — data & AI delivery"
  description="We help mid-enterprise companies in traditional, asset-heavy industries move from business questions to practical solutions in data, AI, and automation. Tallinn, EU."
>
  <Hero trustVariant={trustVariant} />

  <!-- Who we serve -->
  <section class="section section-who" data-reveal>
    <div class="container">
      <div class="section-label">Who we work with</div>
      <h2 class="h2-section who-title">Mid-enterprise companies in traditional, asset-heavy industries.</h2>
      <p class="who-lede">
        Companies with established operations, legacy systems, and complex
        processes — where the cost of getting things wrong is real and the value
        of a working solution is measurable. We start from the business question,
        not the technology.
      </p>

      <ul class="who-industries" data-reveal-stagger>
        <li>Oil &amp; Gas</li>
        <li>Energy</li>
        <li>Retail</li>
        <li>Fuel retail</li>
        <li>Logistics</li>
        <li class="who-more">+ telecom, mobility, industry</li>
      </ul>

      <div class="who-maps">
        <p class="who-maps-label">Specialized solutions</p>
        <p class="who-maps-lede">AI Transformation Maps, built for the industries we go deepest in:</p>
        <div class="who-maps-grid">
          <a href="/industries/retail" class="who-map">
            <span class="who-map-name">Retail AI Canvas</span>
            <span class="who-map-arrow">Across the retail business →</span>
          </a>
          <a href="/industries/fuel-retail" class="who-map">
            <span class="who-map-name">Fuel AI Transformation Map</span>
            <span class="who-map-arrow">The whole fuel network economy →</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <HowWeWork />

  <WhyUs />

  <ClientCases />

  <CTA />
</BaseLayout>

<style>
  /* Who we serve */
  .section-who { padding-top: clamp(48px, 8vh, 96px); padding-bottom: clamp(48px, 7vh, 88px); }
  .who-title { margin: 12px 0 16px; max-width: 24ch; }
  .who-lede { font-size: clamp(17px, 1.7vw, 20px); line-height: 1.6; color: var(--text-secondary); max-width: 64ch; margin-bottom: clamp(32px, 5vh, 52px); }
  .who-industries { list-style: none; padding: 0; margin: 0 0 clamp(40px, 6vh, 64px); display: flex; flex-wrap: wrap; gap: 10px; }
  .who-industries li {
    font-family: var(--font-display); font-weight: 600; font-size: clamp(15px, 1.5vw, 18px);
    letter-spacing: -0.01em; color: var(--text-primary);
    background: var(--surface); border: 1px solid var(--border); border-radius: 100px; padding: 10px 20px;
  }
  .who-industries .who-more { font-family: var(--font-body); font-weight: 400; color: var(--text-muted); background: none; border: 0; padding: 10px 4px; align-self: center; }

  .who-maps { border-top: 1px solid var(--border); padding-top: clamp(28px, 4vh, 40px); }
  .who-maps-label { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-text); margin-bottom: 8px; }
  .who-maps-lede { font-size: clamp(15px, 1.5vw, 17px); color: var(--text-secondary); margin-bottom: 20px; }
  .who-maps-grid { display: grid; grid-template-columns: 1fr; gap: 14px; }
  @media (min-width: 720px) { .who-maps-grid { grid-template-columns: 1fr 1fr; gap: 18px; } }
  .who-map {
    display: flex; flex-direction: column; gap: 8px; text-decoration: none;
    background: var(--surface); border: 1px solid var(--border); border-radius: 14px; padding: 24px 26px;
    transition: border-color .2s ease, transform .2s ease;
  }
  .who-map:hover { border-color: var(--border-hover); transform: translateY(-2px); text-decoration: none; }
  .who-map-name { font-family: var(--font-display); font-weight: 600; font-size: clamp(18px, 1.9vw, 22px); letter-spacing: -0.015em; color: var(--text-primary); }
  .who-map-arrow { font-size: 14px; font-weight: 500; color: var(--accent-text); }

  .section-industries {
    padding-top: clamp(48px, 7vh, 80px);
    padding-bottom: clamp(48px, 7vh, 80px);
    border-top: 1px solid var(--border);
  }
  .section-industries .section-label,
  .section-featured .section-label {
    margin-bottom: 12px;
  }
  .section-industries h2 {
    margin-bottom: 14px;
    max-width: 22ch;
  }
  .industries-lede {
    max-width: 62ch;
    margin-bottom: 36px;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .industry-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }
  @media (min-width: 720px) {
    .industry-grid {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
  }

  .industry-card {
    display: block;
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    text-decoration: none;
    transition: border-color .18s ease, transform .18s ease;
    color: inherit;
  }
  .industry-card:hover {
    border-color: var(--border-hover);
    text-decoration: none;
  }
  .industry-eyebrow {
    font-size: 11px;
    color: var(--accent-text);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .industry-title {
    font-family: var(--font-display);
    font-style: normal;
    font-size: 24px;
    color: var(--text-primary);
    margin-bottom: 10px;
    font-weight: 600;
  }
  .industry-card p {
    font-size: 15px;
    color: var(--text-secondary);
    margin-bottom: 16px;
  }
  .industry-arrow {
    font-size: 13px;
    color: var(--text-primary);
    font-weight: 500;
  }
  .industry-stat {
    margin: 16px 0;
    padding: 12px 0;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: baseline;
    gap: 12px;
  }
  .industry-stat-num {
    font-family: var(--font-display);
    font-style: normal;
    font-size: 32px;
    color: var(--accent);
    line-height: 1;
    flex-shrink: 0;
  }
  .industry-stat-label {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.4;
    max-width: 28ch;
  }

  .section-capabilities {
    padding-top: clamp(48px, 7vh, 80px);
    padding-bottom: clamp(48px, 7vh, 80px);
    border-top: 1px solid var(--border);
  }
  .section-capabilities h2 { margin-bottom: 14px; max-width: 22ch; }
  .cap-lede {
    max-width: 62ch;
    margin-bottom: 36px;
    color: var(--text-secondary);
    line-height: 1.6;
  }
  .cap-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 720px) {
    .cap-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1000px) {
    .cap-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .cap-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 22px 22px 24px;
  }
  .cap-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--accent-text);
    margin-bottom: 12px;
  }
  .cap-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 10px;
    letter-spacing: -0.01em;
  }
  .cap-card p { font-size: 14px; line-height: 1.55; color: var(--text-secondary); margin: 0; }
  .cap-tail { margin-top: 24px; }
  .cap-link {
    font-size: 14px;
    color: var(--text-primary);
    font-weight: 600;
    text-decoration: none;
  }
  .cap-link:hover { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--accent); }

  .section-pullquote {
    padding: clamp(48px, 7vh, 88px) 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--surface-alt);
  }
  .pullquote {
    margin: 0 auto;
    max-width: 760px;
    padding: 0;
  }
  .pullquote p {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 600;
    font-size: clamp(24px, 3.4vw, 38px);
    line-height: 1.25;
    color: var(--text-primary);
    margin: 0;
    max-width: 24ch;
  }

  .section-featured {
    padding-top: clamp(48px, 7vh, 80px);
    padding-bottom: clamp(48px, 7vh, 80px);
  }
  .section-featured h2 {
    margin-bottom: 28px;
    max-width: 22ch;
  }
  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: stretch;
  }
  @media (min-width: 880px) {
    .featured-grid {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
  }
  .featured-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 28px;
    display: flex;
    flex-direction: column;
  }
  .featured-text {
    justify-content: space-between;
  }
  .featured-body {
    margin-bottom: 24px;
  }
  .featured-stats {
    display: flex;
    gap: 28px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }
  .featured-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .featured-stat-num {
    font-family: var(--font-display);
    font-style: normal;
    font-size: 36px;
    color: var(--accent);
    line-height: 1;
  }
  .featured-stat-label {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-weight: 600;
  }
  .featured-cta {
    align-self: flex-start;
  }
  .featured-visual {
    justify-content: center;
    align-items: stretch;
  }

  .section-howweship {
    padding-top: clamp(48px, 7vh, 80px);
    padding-bottom: clamp(48px, 7vh, 80px);
    border-top: 1px solid var(--border);
    background: var(--surface-alt);
  }
  .section-howweship .section-label { margin-bottom: 12px; }
  .section-howweship h2 { margin-bottom: 28px; max-width: 22ch; }

  .engagement-arc {
    margin: 0 0 36px;
    padding: 28px 32px 24px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text-primary);
  }
  .engagement-arc svg { width: 100%; height: auto; display: block; }

  .hws-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    margin-bottom: 28px;
  }
  @media (min-width: 720px) {
    .hws-grid { grid-template-columns: 1fr 1fr; }
  }
  .hws-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 24px 26px;
  }
  .hws-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent-text);
    font-weight: 600;
    letter-spacing: 0.06em;
    margin-bottom: 12px;
  }
  .hws-title {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 600;
    font-size: 22px;
    color: var(--text-primary);
    margin-bottom: 10px;
    line-height: 1.2;
  }
  .hws-card p { font-size: 15px; max-width: 50ch; }
  .hws-tail { margin-top: 8px; }
  .hws-link {
    font-size: 14px;
    color: var(--text-primary);
    font-weight: 500;
    text-decoration: none;
  }
  .hws-link:hover { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--accent); }

  /* Media-slot placements */
  .industry-media { margin-bottom: 18px; }

  .section-infographic {
    padding-top: clamp(48px, 7vh, 88px);
    padding-bottom: clamp(48px, 7vh, 88px);
  }
  .section-infographic .section-label { margin-bottom: 12px; }
  .infographic-title { margin-bottom: 14px; max-width: 24ch; }
  .infographic-lede {
    max-width: 60ch;
    margin-bottom: 32px;
    color: var(--text-secondary);
    line-height: 1.6;
  }
</style>
