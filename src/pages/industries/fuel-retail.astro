---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CTA from '~/components/CTA.astro';
import MediaSlot from '~/components/MediaSlot.astro';

// The fuel network economy — the canvas A–G blocks. Content kept from the
// fuel-retail runbook; Optimus is one embodiment (A+B), not the headline.
const blocks = [
  {
    lever: 'Fuel: procurement, price & margin',
    pressure: 'Procurement eats the morning, and margin is something you read after the fact.',
    detail: 'Procurement and price run as one commercial loop — forecast the need, choose supplier and moment, account for the full landed cost of a batch, set price-at-pump by market and demand. Fewer stockouts and surpluses, less overpay, better margin, faster commercial calls.',
  },
  {
    lever: 'Logistics & fuel supply',
    pressure: 'Batches go dark in transit; railcars sit, fines accrue, dispatch is manual.',
    detail: 'Fuel supply made manageable end-to-end — batch movement, delay risk, acceptance discrepancies, railcars and demurrage, depot operations, station delivery, trip execution. Fewer losses, less idle time and fines, less manual dispatch.',
  },
  {
    lever: 'Stations, stores & cafés',
    pressure: 'The network number hides where a station leaks money.',
    detail: 'The station run as a profit point, not only an operational object — underperformance, queues and lost traffic, dispenser and POS violations, shift work, equipment, assortment, write-offs, store conversion. Fewer operational losses, higher station revenue, better customer experience.',
  },
  {
    lever: 'Customers, loyalty & B2B',
    pressure: 'The customer base and B2B portfolio drift, and discounts leak margin.',
    detail: 'The customer base and B2B portfolio turned into a managed source of growth — customer value, churn, frequency and check, promo, reviews, retail media, corporate-client profitability. Higher retention, more margin per customer, fewer wasted discounts, a stronger loyalty program.',
  },
  {
    lever: 'Finance, money & control',
    pressure: 'Deviations surface at the month-end close, once they are already a problem.',
    detail: 'Finance sees the business as a live picture and finds the cause of a deviation faster — margin, costs, cash, receivables, payment risks, financial losses and policy violations become visible before they become a problem. Faster decisions, fewer leaks, better cash control, trust in the numbers.',
  },
  {
    lever: 'Supporting functions',
    pressure: 'Back-office routine piles up, and violations show up only at the audit.',
    detail: 'The routine taken out and control strengthened across the functions that support the business — HR, legal, MTO procurement, contractors, internal control, documents and back-office. Less manual work, faster processes, clearer spend, violations visible before the audit.',
  },
  {
    lever: 'Data & processes — the foundation',
    pressure: 'Every department runs its own numbers, and AI gets bolted on point by point.',
    detail: 'The foundation analytics, automation and AI run on — one data base, quality and availability, reporting, knowledge search, office AI tools, process re-engineering and agentic solutions. One version of truth, less manual work, AI that scales systemically.',
  },
];

const stages = [
  { tag: 'Essential', name: 'See & control, now', body: 'Bring the picture together on data you already have — need, stock, supplier offers, your price against the market. Cheap, fast, no models.' },
  { tag: 'Advanced', name: 'Forecast & optimize', body: 'Forecast demand, find the right volume and moment, price by local sensitivity. Builds on the foundation beneath it.' },
  { tag: 'Frontier', name: 'Decisions under AI', body: 'Agents prepare the order or hold price sharp within your rules — the person sets the bounds and approves. Never AI on its own.' },
];
---

<BaseLayout
  title="Fuel retail — KKT"
  description="AI and data for independent fuel networks — procurement and margin, logistics, stations, customers, finance and control. Bottom-up, on the data you already have."
  ogImage="/og/fuel-retail.png"
>
  <!-- Intro -->
  <section class="section fr-intro" data-reveal>
    <div class="container">
      <p class="section-label">Industries — Fuel retail</p>
      <h1 class="fr-h1">For independent <span class="grad">fuel networks</span>.</h1>
      <p class="fr-lede">
        Your network already has the data — ERP, POS, loyalty, GPS, depots, BI,
        spreadsheets. What is usually missing is connectedness: the network runs
        on people, calls, manual reconciliation and the experience of individual
        managers, while the data you have piled up does not yet work for your
        decisions.
      </p>
      <MediaSlot class="fr-intro-media" ratio="16 / 7" kind="image" label="Fuel — station forecourt, depot, or the network at a glance" />
    </div>
  </section>

  <!-- Position + maturity path (dark band) -->
  <section class="section fr-path theme-dark" data-reveal>
    <div class="container">
      <p class="section-label">How the path runs</p>
      <h2 class="fr-path-title">AI earns its place on top of a foundation — so the path runs bottom-up.</h2>
      <p class="fr-path-lede">
        AI agents are not installed on top of chaos. Every block of the network
        economy climbs the same way — start small on data you already have, build
        the foundation as you go. You do not need to be at the top to begin.
      </p>

      <ol class="fr-stages" data-reveal-stagger>
        {stages.map((s, i) => (
          <li class={`fr-stage${i === stages.length - 1 ? ' fr-stage-frontier' : ''}`}>
            <span class="fr-stage-tag">{s.tag}</span>
            <h3 class="fr-stage-name">{s.name}</h3>
            <p>{s.body}</p>
            {i < stages.length - 1 && <span class="fr-stage-arrow" aria-hidden="true">→</span>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Starting points — the whole network economy -->
  <section class="section fr-starts" data-reveal>
    <div class="container">
      <p class="section-label">Engagement starting points</p>
      <h2 class="fr-starts-title">Across the whole network economy.</h2>
      <p class="fr-starts-lede">
        The effect runs across the whole network economy — procurement and margin,
        pricing, logistics, stations, finance and control. We start where the
        diagnostic points. Optimus is one embodiment of this: the
        procurement-and-margin engine, in pilot at Red Petroleum.
      </p>

      <div class="fr-blocks" data-reveal-stagger>
        {blocks.map((b) => (
          <article class="fr-block">
            <span class="fr-block-mark" aria-hidden="true"></span>
            <h3 class="fr-block-lever">{b.lever}</h3>
            <p class="fr-block-pressure">{b.pressure}</p>
            <p class="fr-block-detail">{b.detail}</p>
          </article>
        ))}
      </div>

      <p class="fr-starts-tail">
        <a href="/case-studies/red-petroleum" class="link-cta">Read the Red Petroleum case</a>
      </p>
    </div>
  </section>

  <!-- How we work (soft band) -->
  <section class="section fr-hww theme-soft" data-reveal>
    <div class="container">
      <p class="section-label">How we work</p>
      <h2 class="fr-hww-title">Built around your business economics.</h2>
      <ul class="fr-hww-list" data-reveal-stagger>
        <li>
          <div class="fr-hww-k">From quick wins to systemic transformation</div>
          <p>Start with clear use cases, then build out the data, processes, models and agentic systems behind them.</p>
        </li>
        <li>
          <div class="fr-hww-k">AI tied to business economics, not the tech of the month</div>
          <p>Every initiative answers to margin, losses, working capital, revenue, service, or team efficiency.</p>
        </li>
        <li>
          <div class="fr-hww-k">We walk it from idea to deployment</div>
          <p>We set the priorities, the data, the dependencies, the pilots, and the next realistic step for your network.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- Cost of doing nothing preview -->
  <section class="section fr-cdn" data-reveal>
    <div class="container">
      <div class="fr-cdn-card">
        <div class="fr-cdn-tag">Cost of doing nothing · Phase 1.5</div>
        <h3 class="fr-cdn-title">Quantify the gap to top-quartile peers.</h3>
        <p>
          A single-page calculator: 6–8 inputs, three quantified gap scenarios
          (conservative / median / aggressive), every number with a source.
          Currently in benchmark calibration; the methodology is already public.
        </p>
        <p class="fr-cdn-links">
          <a href="/methods/cost-of-doing-nothing" class="link-cta">Read the methodology</a>
          <a href="/tools/cost-of-doing-nothing" class="link-cta">Try the v0 preview</a>
        </p>
      </div>
    </div>
  </section>

  <CTA
    heading="Fuel network diagnostic, two weeks."
    body="A scoped look at where connected data and AI earn their place in your network — procurement and pricing, logistics, stations, finance and control — and what shipping first looks like."
  />
</BaseLayout>

<style>
  .section-label { margin-bottom: 16px; }
  .grad {
    background: var(--accent-gradient);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
  }

  /* Intro */
  .fr-intro { padding-top: clamp(48px, 8vh, 104px); padding-bottom: clamp(40px, 6vh, 72px); }
  .fr-h1 {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(36px, 5.4vw, 66px); line-height: 1.05; letter-spacing: -0.03em;
    color: var(--text-primary); max-width: 16ch; margin-bottom: 22px;
  }
  .fr-lede {
    font-size: clamp(17px, 1.8vw, 21px); line-height: 1.55; color: var(--text-secondary);
    max-width: 64ch; margin-bottom: clamp(32px, 5vh, 56px);
  }
  .fr-intro-media { max-width: 1000px; }

  /* Maturity path (dark) */
  .fr-path { padding-top: clamp(56px, 9vh, 104px); padding-bottom: clamp(56px, 9vh, 104px); }
  .fr-path-title {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(26px, 3.4vw, 40px); line-height: 1.14; letter-spacing: -0.02em;
    color: var(--text-primary); max-width: 22ch; margin: 12px 0 16px;
  }
  .fr-path-lede { font-size: clamp(16px, 1.6vw, 19px); line-height: 1.6; color: var(--text-secondary); max-width: 62ch; margin-bottom: clamp(32px, 5vh, 52px); }
  .fr-stages { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr; gap: 14px; }
  @media (min-width: 760px) { .fr-stages { grid-template-columns: repeat(3, 1fr); gap: 18px; } }
  .fr-stage {
    position: relative; background: var(--surface); border: 1px solid var(--border);
    border-radius: 14px; padding: 24px 24px 26px;
  }
  .fr-stage-frontier { border-color: transparent; box-shadow: inset 0 0 0 1.5px transparent; background: linear-gradient(var(--surface), var(--surface)) padding-box, var(--accent-gradient) border-box; border: 1.5px solid transparent; }
  .fr-stage-tag {
    display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--accent-text); margin-bottom: 12px;
  }
  .fr-stage-name {
    font-family: var(--font-display); font-weight: 600; font-size: clamp(19px, 2vw, 23px);
    letter-spacing: -0.015em; color: var(--text-primary); margin-bottom: 10px; line-height: 1.2;
  }
  .fr-stage p { font-size: 15px; line-height: 1.55; color: var(--text-secondary); margin: 0; }
  .fr-stage-arrow {
    position: absolute; right: -13px; top: 50%; transform: translateY(-50%);
    color: var(--accent); font-size: 18px; line-height: 1; z-index: 1;
  }
  @media (max-width: 759px) {
    .fr-stage-arrow { right: 50%; top: auto; bottom: -13px; transform: translateX(50%) rotate(90deg); }
  }

  /* Starting points */
  .fr-starts { padding-top: clamp(56px, 9vh, 100px); padding-bottom: clamp(48px, 7vh, 88px); }
  .fr-starts-title {
    font-family: var(--font-display); font-weight: 600; font-size: clamp(26px, 3.4vw, 40px);
    letter-spacing: -0.02em; color: var(--text-primary); margin: 12px 0 16px; max-width: 22ch;
  }
  .fr-starts-lede { font-size: clamp(16px, 1.6vw, 19px); line-height: 1.6; color: var(--text-secondary); max-width: 66ch; margin-bottom: clamp(32px, 5vh, 52px); }
  .fr-blocks { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 720px) { .fr-blocks { grid-template-columns: 1fr 1fr; gap: 20px; } }
  .fr-block {
    background: var(--surface); border: 1px solid var(--border); border-radius: 14px;
    padding: 26px 28px 24px; transition: border-color .2s ease, transform .2s ease;
  }
  .fr-block:hover { border-color: var(--border-hover); transform: translateY(-2px); }
  .fr-block-mark { display: block; width: 34px; height: 4px; border-radius: 4px; background: var(--accent-gradient); margin-bottom: 16px; }
  .fr-block-lever {
    font-family: var(--font-display); font-weight: 600; font-size: clamp(18px, 1.9vw, 22px);
    letter-spacing: -0.015em; color: var(--text-primary); margin-bottom: 10px; line-height: 1.2;
  }
  .fr-block-pressure { font-size: 15px; line-height: 1.5; color: var(--text-muted); font-style: italic; margin-bottom: 12px; }
  .fr-block-detail { font-size: 15px; line-height: 1.6; color: var(--text-secondary); margin: 0; }
  .fr-starts-tail { margin-top: 28px; }

  /* How we work (soft) */
  .fr-hww { padding-top: clamp(56px, 9vh, 96px); padding-bottom: clamp(56px, 9vh, 96px); }
  .fr-hww-title {
    font-family: var(--font-display); font-weight: 600; font-size: clamp(24px, 3vw, 36px);
    letter-spacing: -0.02em; color: var(--text-primary); margin: 12px 0 24px; max-width: 24ch;
  }
  .fr-hww-list { list-style: none; padding: 0; margin: 0; counter-reset: hww; max-width: 800px; }
  .fr-hww-list li { counter-increment: hww; position: relative; padding: 22px 0 22px 56px; border-top: 1px solid var(--border); }
  .fr-hww-list li:last-child { border-bottom: 1px solid var(--border); }
  .fr-hww-list li::before {
    content: counter(hww, decimal-leading-zero); position: absolute; left: 0; top: 22px;
    font-family: var(--font-mono); font-size: 13px; color: var(--accent-text); font-weight: 700;
  }
  .fr-hww-k { font-size: 16px; font-weight: 600; color: var(--text-primary); margin-bottom: 6px; }
  .fr-hww-list p { margin: 0; max-width: 64ch; color: var(--text-secondary); font-size: 15px; line-height: 1.55; }

  /* Cost of doing nothing */
  .fr-cdn { padding-top: clamp(40px, 6vh, 72px); padding-bottom: clamp(40px, 6vh, 72px); }
  .fr-cdn-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: clamp(28px, 4vw, 44px); max-width: 820px; }
  .fr-cdn-tag { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-text); margin-bottom: 14px; }
  .fr-cdn-title { font-family: var(--font-display); font-weight: 600; font-size: clamp(22px, 2.6vw, 30px); letter-spacing: -0.02em; color: var(--text-primary); margin-bottom: 14px; }
  .fr-cdn-card p { font-size: 16px; line-height: 1.6; color: var(--text-secondary); max-width: 64ch; }
  .fr-cdn-links { display: flex; gap: 24px; flex-wrap: wrap; margin-top: 18px; }
</style>
