---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CTA from '~/components/CTA.astro';
import StartingPoints from '~/components/StartingPoints.astro';

const startingPoints = [
  {
    pressure: 'Store reports nobody fully trusts, margin views that do not agree, loyalty data that never reaches the buying team.',
    lever: 'One trusted data base',
    detail: 'POS, ERP, loyalty, stock, supplier, finance and master data connected into one governed layer — the base every later decision depends on.',
  },
  {
    pressure: 'Poor fresh ordering — too much of the wrong stock while you lose sales on the right products.',
    lever: 'Forecasting, replenishment & freshness',
    detail: 'Demand forecasting, availability protection and waste control, so the shelf matches real demand instead of last period.',
  },
  {
    pressure: 'Unclear promo ROI and inconsistent margin — commercial money subsidizing demand that would have happened anyway.',
    lever: 'Promotion & margin intelligence',
    detail: 'Where promotions and pricing actually create return, and a clearer forward view of where profit and cash are moving.',
  },
  {
    pressure: 'Loyalty, basket and feedback data sit unused — customers treated as one average, not as different groups.',
    lever: 'Customer value & loyalty',
    detail: 'Segmentation, retention and basket growth that follow from knowing who actually drives the business.',
  },
];
---

<BaseLayout
  title="Retail — KKT"
  description="AI and data for mid-sized food retailers — one trusted data foundation, then forecasting, promotions, margin and loyalty. The full playbook at retail.kittykat.tech."
  ogImage="/og/retail.png"
>
  <article class="prose-page">
    <div class="container">
      <div class="section-label">Industries — Retail</div>
      <h1 class="h1-page">For mid-sized food retailers.</h1>
      <p class="lede">
        Your data is already there — POS, ERP, loyalty, stock, supplier,
        finance, master data. In food retail the gaps are not abstract IT
        problems: unclear promo ROI, inconsistent margin views, poor fresh
        ordering, supplier disputes, and store reports nobody fully trusts.
      </p>

      <section data-reveal class="ind-pullquote">
        <blockquote>
          <p>
            We connect it into one trusted base, then add AI where it earns
            its place — built bottom-up, from the core outward, on the data
            you already have.
          </p>
        </blockquote>
      </section>

      <section data-reveal class="retail-path">
        <div class="section-label">How the path runs</div>
        <h2 class="h2-section">From the core outward.</h2>
        <p class="retail-path-lede">
          The staged model behind the playbook — starting from business
          reality, not a technology catalogue. Strengthen the core first,
          optimize where it pays, expand into new revenue only when the core
          is ready.
        </p>
        <div class="rpath" data-reveal-stagger>
          <div class="rpath-step">
            <span class="rpath-stage">Stage 1</span>
            <h3 class="rpath-name">Strengthen core operations</h3>
            <p>Improve visibility, execution, stock, margin, supplier control,
            reporting, loss prevention and workforce productivity in the
            current business.</p>
          </div>
          <span class="rpath-arrow" aria-hidden="true">&rarr;</span>
          <div class="rpath-step">
            <span class="rpath-stage">Stage 2</span>
            <h3 class="rpath-name">Optimize and grow</h3>
            <p>Use customer intelligence, promotion analytics and pricing
            discipline to grow more profitably from the existing base.</p>
          </div>
          <span class="rpath-arrow" aria-hidden="true">&rarr;</span>
          <div class="rpath-step rpath-step-accent">
            <span class="rpath-stage">Stage 3</span>
            <h3 class="rpath-name">Expand and monetize</h3>
            <p>Optional strategic expansion once the core is ready: retail
            media, supplier activation, paid loyalty, partner ecosystems.</p>
          </div>
        </div>
      </section>

      <section data-reveal class="callout">
        <div class="callout-label">The retail playbook</div>
        <h2 class="callout-title">Retail AI Canvas — 43 services across 11 domains.</h2>
        <p class="callout-body">
          The full open playbook of where AI and data create value across a
          mid-sized food retailer — data foundation, stock, promotions,
          margin, customers, suppliers and more. Built from real engagements,
          updated quarterly, with an advisor that walks you through it.
        </p>
        <p>
          <a href="https://retail.kittykat.tech" class="btn-primary" rel="noopener">
            Open the playbook →
          </a>
        </p>
      </section>

      <section data-reveal class="starts">
        <div class="section-label">Engagement starting points</div>
        <h2 class="h2-section">Where the work pays back first.</h2>
        <p class="starts-lede">
          The effect runs across the whole business — data foundation, stock
          and freshness, promotions and margin, customers. We start where the
          diagnostic points, from the core outward.
        </p>

        <StartingPoints items={startingPoints} />

        <p class="starts-tail">
          The full playbook lives at
          <a href="https://retail.kittykat.tech" rel="noopener">retail.kittykat.tech</a>.
        </p>
      </section>
    </div>

    <CTA
      heading="Retail diagnostic, two weeks."
      body="A focused look at where the playbook applies to your business — what to ship first, what to leave alone, what proof you need to commit."
    />
  </article>
</BaseLayout>

<style>
  .prose-page {
    padding-top: clamp(40px, 6vh, 72px);
  }
  .section-label { margin-bottom: 18px; }
  .h1-page {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(32px, 4.5vw, 48px);
    line-height: 1.16;
    margin-bottom: 18px;
    letter-spacing: -0.01em;
    max-width: 22ch;
  }
  .lede {
    font-size: clamp(17px, 2vw, 20px);
    color: var(--text-secondary);
    line-height: 1.55;
    max-width: 56ch;
    margin-bottom: 48px;
  }
  .ind-pullquote {
    margin: 8px 0 40px;
    padding: 28px 32px;
    background: var(--surface-alt);
    border-left: 3px solid var(--accent);
    border-radius: 0 4px 4px 0;
    max-width: 760px;
  }
  .ind-pullquote blockquote { margin: 0; padding: 0; }
  .ind-pullquote p {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(20px, 2.6vw, 28px);
    line-height: 1.3;
    color: var(--text-primary);
    margin: 0;
    max-width: 30ch;
  }

  .callout {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: clamp(24px, 4vw, 36px);
    max-width: 720px;
    margin-bottom: 32px;
  }
  .callout-label {
    font-size: 11px;
    color: var(--accent-text);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .callout-title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(22px, 3vw, 30px);
    line-height: 1.2;
    color: var(--text-primary);
    margin-bottom: 14px;
    max-width: 22ch;
  }
  .callout-body {
    margin-bottom: 20px;
    max-width: 56ch;
  }

  .retail-path {
    margin-top: 8px;
    margin-bottom: 8px;
    padding-top: 40px;
    border-top: 1px solid var(--border);
  }
  .retail-path .section-label { margin-bottom: 14px; }
  .retail-path h2 { margin-bottom: 14px; max-width: 24ch; }
  .retail-path-lede { max-width: 62ch; margin-bottom: 28px; color: var(--text-secondary); }
  .rpath { display: flex; align-items: stretch; gap: 8px; }
  .rpath-step {
    flex: 1 1 0;
    min-width: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 20px 22px;
  }
  .rpath-step-accent { background: var(--surface-alt); border-left: 3px solid var(--accent); }
  .rpath-stage {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 600;
    color: var(--accent-text);
    margin-bottom: 10px;
  }
  .rpath-name {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 20px;
    color: var(--text-primary);
    margin: 0 0 10px;
    line-height: 1.2;
  }
  .rpath-step p { font-size: 14px; line-height: 1.55; color: var(--text-secondary); margin: 0; max-width: 42ch; }
  .rpath-arrow { align-self: center; flex: 0 0 auto; color: var(--text-muted); font-size: 18px; line-height: 1; }
  @media (max-width: 720px) {
    .rpath { flex-direction: column; gap: 6px; }
    .rpath-arrow { transform: rotate(90deg); padding: 2px 0; }
  }

  .starts {
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid var(--border);
  }
  .starts .section-label { margin-bottom: 14px; }
  .starts h2 { margin-bottom: 18px; max-width: 24ch; }
  .starts-lede {
    max-width: 60ch;
    margin-bottom: 32px;
  }
  .starts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
    margin-bottom: 24px;
  }
  @media (min-width: 720px) {
    .starts-grid { grid-template-columns: 1fr 1fr; }
  }
  .start-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 22px 24px;
  }
  .start-title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 20px;
    color: var(--text-primary);
    margin-bottom: 10px;
  }
  .start-card p { font-size: 15px; max-width: 50ch; }
  .starts-tail {
    font-size: 14px;
    color: var(--text-muted);
    max-width: 60ch;
  }
  .starts-tail a {
    color: var(--text-primary);
    font-weight: 500;
    text-decoration: none;
  }
  .starts-tail a:hover { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--accent); }
</style>
