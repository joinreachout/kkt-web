---
import BaseLayout from '~/layouts/BaseLayout.astro';
import CTA from '~/components/CTA.astro';
import MediaSlot from '~/components/MediaSlot.astro';
import { useFuel } from '~/i18n/pages/fuel-retail';

// Fuel network economy (canvas A–G blocks + stages), localized in
// src/i18n/pages/fuel-retail.ts.
const f = useFuel(Astro.currentLocale);
const blocks = f.blocks;
const stages = f.stages;
---

<BaseLayout
  title={f.meta.title}
  description={f.meta.description}
  ogImage="/og/fuel-retail.png"
>
  <!-- Intro -->
  <section class="section fr-intro" data-reveal>
    <div class="container">
      <p class="section-label">{f.introLabel}</p>
      <h1 class="fr-h1">{f.h1a}<span class="grad">{f.h1grad}</span>.</h1>
      <p class="fr-lede">{f.lede}</p>
      <p class="fr-intro-cta">
        <a href="https://fuelretail.kittykat.tech" class="btn-primary" rel="noopener">{f.tailMap} →</a>
      </p>
      <MediaSlot class="fr-intro-media" ratio="16 / 7" kind="image" src="/industries/fuel-retail-v2.jpg" alt={f.imgAlt} label={f.imgLabel} />
    </div>
  </section>

  <!-- Position + maturity path (dark band) -->
  <section class="section fr-path theme-dark" data-reveal>
    <div class="container">
      <p class="section-label">{f.pathLabel}</p>
      <h2 class="fr-path-title">{f.pathTitle}</h2>
      <p class="fr-path-lede">{f.pathLede}</p>

      <ol class="fr-stages" data-reveal-stagger>
        {stages.map((s, i) => (
          <li class={`fr-stage${i === stages.length - 1 ? ' fr-stage-frontier' : ''}`}>
            <span class="fr-stage-tag">{s.tag}</span>
            <h3 class="fr-stage-name">{s.name}</h3>
            <p>{s.body}</p>
            {i < stages.length - 1 && <span class="fr-stage-arrow" aria-hidden="true">→</span>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Starting points — the whole network economy -->
  <section class="section fr-starts" data-reveal>
    <div class="container">
      <p class="section-label">{f.startsLabel}</p>
      <h2 class="fr-starts-title">{f.startsTitle}</h2>
      <p class="fr-starts-lede">{f.startsLede}</p>

      <div class="fr-blocks" data-reveal-stagger>
        {blocks.map((b) => (
          <article class="fr-block">
            <span class="fr-block-mark" aria-hidden="true"></span>
            <h3 class="fr-block-lever">{b.lever}</h3>
            <p class="fr-block-detail">{b.detail}</p>
            <ul class="fr-block-tasks">
              {b.tasks.map((t) => <li>{t}</li>)}
            </ul>
          </article>
        ))}
      </div>

      <p class="fr-starts-tail">
        <a href="https://fuelretail.kittykat.tech" class="link-cta" rel="noopener">{f.tailMap}</a>
        <a href="/case-studies#red-petroleum" class="link-cta">{f.tailCase}</a>
      </p>
    </div>
  </section>

  <!-- How we work (soft band) -->
  <section class="section fr-hww theme-soft" data-reveal>
    <div class="container">
      <p class="section-label">{f.hwwLabel}</p>
      <h2 class="fr-hww-title">{f.hwwTitle}</h2>
      <ul class="fr-hww-list" data-reveal-stagger>
        {f.hww.map((item) => (
          <li>
            <div class="fr-hww-k">{item.k}</div>
            <p>{item.p}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CTA heading={f.ctaHeading} body={f.ctaBody} />
</BaseLayout>

<style>
  .section-label { margin-bottom: 16px; }
  .grad {
    background: var(--accent-gradient);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
  }

  /* Intro */
  .fr-intro { padding-top: clamp(48px, 8vh, 104px); padding-bottom: clamp(40px, 6vh, 72px); }
  .fr-h1 {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(36px, 5.4vw, 66px); line-height: 1.05; letter-spacing: -0.03em;
    color: var(--text-primary); max-width: 16ch; margin-bottom: 22px;
  }
  .fr-lede {
    font-size: clamp(17px, 1.8vw, 21px); line-height: 1.55; color: var(--text-secondary);
    max-width: 64ch; margin-bottom: clamp(32px, 5vh, 56px);
  }
  .fr-intro-cta { margin: clamp(18px, 3vh, 30px) 0 clamp(28px, 5vh, 52px); }
  .fr-intro-media { max-width: 1000px; }

  /* Maturity path (dark) */
  .fr-path { padding-top: clamp(56px, 9vh, 104px); padding-bottom: clamp(56px, 9vh, 104px); }
  .fr-path-title {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(26px, 3.4vw, 40px); line-height: 1.14; letter-spacing: -0.02em;
    color: var(--text-primary); max-width: 22ch; margin: 12px 0 16px;
  }
  .fr-path-lede { font-size: clamp(16px, 1.6vw, 19px); line-height: 1.6; color: var(--text-secondary); max-width: 62ch; margin-bottom: clamp(32px, 5vh, 52px); }
  .fr-stages { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr; gap: 14px; }
  @media (min-width: 760px) { .fr-stages { grid-template-columns: repeat(3, 1fr); gap: 18px; } }
  .fr-stage {
    position: relative; background: var(--surface); border: 1px solid var(--border);
    border-radius: 14px; padding: 24px 24px 26px;
  }
  .fr-stage-frontier { border-color: transparent; box-shadow: inset 0 0 0 1.5px transparent; background: linear-gradient(var(--surface), var(--surface)) padding-box, var(--accent-gradient) border-box; border: 1.5px solid transparent; }
  .fr-stage-tag {
    display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--accent-text); margin-bottom: 12px;
  }
  .fr-stage-name {
    font-family: var(--font-display); font-weight: 600; font-size: clamp(19px, 2vw, 23px);
    letter-spacing: -0.015em; color: var(--text-primary); margin-bottom: 10px; line-height: 1.2;
  }
  .fr-stage p { font-size: 15px; line-height: 1.55; color: var(--text-secondary); margin: 0; }
  .fr-stage-arrow {
    position: absolute; right: -13px; top: 50%; transform: translateY(-50%);
    color: var(--accent); font-size: 18px; line-height: 1; z-index: 1;
  }
  @media (max-width: 759px) {
    .fr-stage-arrow { right: 50%; top: auto; bottom: -13px; transform: translateX(50%) rotate(90deg); }
  }

  /* Starting points */
  .fr-starts { padding-top: clamp(56px, 9vh, 100px); padding-bottom: clamp(48px, 7vh, 88px); }
  .fr-starts-title {
    font-family: var(--font-display); font-weight: 600; font-size: clamp(26px, 3.4vw, 40px);
    letter-spacing: -0.02em; color: var(--text-primary); margin: 12px 0 16px; max-width: 22ch;
    text-wrap: balance;
  }
  .fr-starts-lede { font-size: clamp(16px, 1.6vw, 19px); line-height: 1.6; color: var(--text-secondary); max-width: 66ch; margin-bottom: clamp(32px, 5vh, 52px); }
  .fr-blocks { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 720px) { .fr-blocks { grid-template-columns: 1fr 1fr; gap: 20px; } }
  .fr-block {
    background: var(--surface); border: 1px solid var(--border); border-radius: 14px;
    padding: 26px 28px 24px; transition: border-color .2s ease, transform .2s ease;
  }
  .fr-block:hover { border-color: var(--border-hover); transform: translateY(-2px); }
  .fr-block-mark { display: block; width: 34px; height: 4px; border-radius: 4px; background: var(--accent-gradient); margin-bottom: 16px; }
  .fr-block-lever {
    font-family: var(--font-display); font-weight: 600; font-size: clamp(18px, 1.9vw, 22px);
    letter-spacing: -0.015em; color: var(--text-primary); margin-bottom: 10px; line-height: 1.2;
  }
  .fr-block-pressure { font-size: 15px; line-height: 1.5; color: var(--text-muted); font-style: italic; margin-bottom: 12px; }
  .fr-block-detail { font-size: 15px; line-height: 1.6; color: var(--text-secondary); margin: 0 0 16px; }
  .fr-block-tasks {
    list-style: none; padding: 16px 0 0; margin: 0; border-top: 1px solid var(--border);
    display: grid; gap: 7px;
  }
  .fr-block-tasks li {
    position: relative; padding-left: 18px; font-size: 13.5px; line-height: 1.5; color: var(--text-secondary);
  }
  .fr-block-tasks li::before { content: '→'; position: absolute; left: 0; top: 0; color: var(--accent); opacity: 0.8; font-size: 13px; }
  .fr-starts-tail { margin-top: 32px; display: flex; gap: 24px; flex-wrap: wrap; }

  /* How we work (soft) */
  .fr-hww { padding-top: clamp(56px, 9vh, 96px); padding-bottom: clamp(56px, 9vh, 96px); }
  .fr-hww-title {
    font-family: var(--font-display); font-weight: 600; font-size: clamp(24px, 3vw, 36px);
    letter-spacing: -0.02em; color: var(--text-primary); margin: 12px 0 24px; max-width: 24ch;
  }
  .fr-hww-list { list-style: none; padding: 0; margin: 0; counter-reset: hww; max-width: 800px; }
  .fr-hww-list li { counter-increment: hww; position: relative; padding: 22px 0 22px 56px; border-top: 1px solid var(--border); }
  .fr-hww-list li:last-child { border-bottom: 1px solid var(--border); }
  .fr-hww-list li::before {
    content: counter(hww, decimal-leading-zero); position: absolute; left: 0; top: 22px;
    font-family: var(--font-mono); font-size: 13px; color: var(--accent-text); font-weight: 700;
  }
  .fr-hww-k { font-size: 16px; font-weight: 600; color: var(--text-primary); margin-bottom: 6px; }
  .fr-hww-list p { margin: 0; max-width: 64ch; color: var(--text-secondary); font-size: 15px; line-height: 1.55; }

  /* Cost of doing nothing */
  .fr-cdn { padding-top: clamp(40px, 6vh, 72px); padding-bottom: clamp(40px, 6vh, 72px); }
  .fr-cdn-card { background: var(--surface); border: 1px solid var(--border); border-radius: 16px; padding: clamp(28px, 4vw, 44px); max-width: 820px; }
  .fr-cdn-tag { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent-text); margin-bottom: 14px; }
  .fr-cdn-title { font-family: var(--font-display); font-weight: 600; font-size: clamp(22px, 2.6vw, 30px); letter-spacing: -0.02em; color: var(--text-primary); margin-bottom: 14px; }
  .fr-cdn-card p { font-size: 16px; line-height: 1.6; color: var(--text-secondary); max-width: 64ch; }
  .fr-cdn-links { display: flex; gap: 24px; flex-wrap: wrap; margin-top: 18px; }
</style>
