---
import BaseLayout from '~/layouts/BaseLayout.astro';
import HowWeWork from '~/components/HowWeWork.astro';
import CTA from '~/components/CTA.astro';

// Engagement method = the runbook "How We Work" (Identify → Scope → Execute →
// Close), rendered by the shared HowWeWork roadmap. The 3-stage maturity model
// lives on the industries pages, so it is not repeated here. The diagnostic, PMO
// and exit content below is approach-specific.
const phases = [
  { meta: 'Days 1–3', name: 'Kick-off and access', body: 'Stakeholder map, data access, scope freeze. We name the business question we will answer in two weeks, and the three or four data pulls we need to answer it.' },
  { meta: 'Days 4–9', name: 'Investigation', body: 'Interviews with the people closest to the operating reality. Hands-on data review. Surfacing the patterns that show up across both — we tell you what we see as we see it, no surprise reveal at the end.' },
  { meta: 'Days 10–12', name: 'Synthesis', body: 'What to ship, what to leave alone, what proof to commit. A sequenced backlog with effort and impact ranges, and the exit criteria for whichever stage you actually need.' },
  { meta: 'Day 14', name: 'Readout', body: 'A concrete recommendation, presented to the senior team. Decision-ready: enough detail to commit, scoped to avoid over-promising. If the case is not there, we say so.' },
];

// FAQ — visible on-page Q&A; the same array feeds FAQPage JSON-LD via BaseLayout.
// Answers are grounded in this page's own copy (method, diagnostic, exit) and the
// positioning; keep them in sync if the wording above changes.
const faqs = [
  { q: 'How does KKT actually deliver?', a: 'From a business question to a system that runs after we leave — on a four-step runbook: Identify, Scope, Execute, Close. Strong AI capability is the baseline; PMO discipline — scope, sequencing, ownership, shipping under constraint — is what makes it run in production instead of on slides.' },
  { q: 'Are you a fit for a mid-sized retailer?', a: 'Yes — we specialise in fuel retail and mid-sized retail. We start from the business problem you are trying to move: margin, availability, working capital, customer value or productivity, and whether data or AI can shift it.' },
  { q: 'What does a two-week diagnostic look like?', a: 'Every engagement we accept starts with a fixed, two-week diagnostic. It has one output: a sharp picture of what to ship, what to leave alone, and what proof you need before committing to a build.' },
  { q: 'Why would you turn down work?', a: "If the diagnostic shows the case isn't there, we say so. We don't take engagements we can't ship into production, and engagement length is shaped by what is real to ship — not by a default contract." },
  { q: 'What is Optimus?', a: 'Our daily operating-intelligence system for fuel-distribution networks: procurement, margin, stockouts and working capital, on connected data. In pilot at Red Petroleum, a 220+ station network in Kyrgyzstan.' },
  { q: 'What happens after you ship?', a: 'We design for the exit from week one. When the system is running and your senior counterpart is operating it, we leave — it keeps running without us.' },
];
---

<BaseLayout
  title="Approach — KKT"
  description="How we run an engagement: a clear method from business question to a system that runs without us, starting with a fixed two-week diagnostic, with senior PMO discipline throughout."
  ogImage="/og/approach.png"
  faq={faqs}
>
  <!-- Intro -->
  <section class="section ap-intro" data-reveal>
    <div class="container">
      <p class="section-label">Approach</p>
      <h1 class="ap-h1">How we run an <span class="grad">engagement</span>.</h1>
      <p class="ap-lede">
        From a business question to a solution that runs — and keeps running after
        we leave. Every engagement starts with a fixed two-week diagnostic, and
        senior PMO discipline holds it together throughout.
      </p>
    </div>
  </section>

  <!-- The method (shared roadmap, dark) -->
  <HowWeWork />

  <!-- PMO (soft band) -->
  <section class="section ap-pmo theme-soft" data-reveal>
    <div class="container">
      <p class="section-label">What holds it together</p>
      <h2 class="ap-h2">PMO is the rigor.</h2>
      <p class="ap-pmo-body">
        Strong AI capability is the baseline. PMO discipline — scope, sequencing,
        ownership, shipping under constraint — is what separates a slide-led project
        from one that runs in production. It is load-bearing, not overhead.
      </p>
    </div>
  </section>

  <!-- Diagnostic -->
  <section class="section ap-diag" data-reveal>
    <div class="container">
      <div class="ap-diag-head">
        <div>
          <p class="section-label">Inside a diagnostic</p>
          <h2 class="ap-h2">Two weeks. One sharp picture.</h2>
          <p class="ap-diag-lede">
            Every engagement we accept starts with a diagnostic. Two weeks,
            fixed-shape, focused on a single output: a sharp picture of what to
            ship, what to leave alone, and what proof you need before committing.
          </p>
        </div>
        <div class="ap-diag-stat">
          <div class="ap-diag-num">14</div>
          <div class="ap-diag-num-label">days, fixed shape</div>
        </div>
      </div>

      <ol class="ap-phases" data-reveal-stagger>
        {phases.map((p, i) => (
          <li class={`ap-phase${i === phases.length - 1 ? ' ap-phase-last' : ''}`}>
            <div class="ap-phase-meta">{p.meta}</div>
            <h3 class="ap-phase-name">{p.name}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ol>

      <blockquote class="ap-quote">
        <p>If the case for an engagement is not there, we say so at the readout. Honest answers beat a sold project.</p>
      </blockquote>
    </div>
  </section>

  <!-- After -->
  <section class="section ap-after theme-dark" data-reveal>
    <div class="container">
      <p class="section-label">After the diagnostic</p>
      <h2 class="ap-h2 ap-after-h2">We design for the exit from week one.</h2>
      <p class="ap-after-body">
        If the case is there, we agree on a sequenced engagement: a set of operating
        outcomes, the milestones that prove them, and the senior counterpart inside
        your organisation who inherits the system as we ship it. Engagement length is
        shaped by what is real to ship, not by a default contract length.
      </p>
      <p class="ap-after-body">
        When the system is running and the counterpart is operating it, we leave.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section ap-faq" data-reveal>
    <div class="container">
      <p class="section-label">Common questions</p>
      <h2 class="ap-h2">Straight answers.</h2>
      <dl class="faq-list" data-reveal-stagger>
        {faqs.map((f) => (
          <div class="faq-item">
            <dt class="faq-q">{f.q}</dt>
            <dd class="faq-a">{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  .section-label { margin-bottom: 16px; }
  .grad {
    background: var(--accent-gradient);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
  }
  .ap-h2 {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(24px, 3vw, 36px); line-height: 1.15; letter-spacing: -0.02em;
    color: var(--text-primary); margin: 12px 0 16px; max-width: 22ch;
  }

  /* Intro */
  .ap-intro { padding-top: clamp(48px, 8vh, 104px); padding-bottom: clamp(32px, 5vh, 56px); }
  .ap-h1 {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(36px, 5.4vw, 66px); line-height: 1.05; letter-spacing: -0.03em;
    color: var(--text-primary); max-width: 16ch; margin-bottom: 22px;
  }
  .ap-lede { font-size: clamp(17px, 1.8vw, 21px); line-height: 1.55; color: var(--text-secondary); max-width: 64ch; }

  /* PMO */
  .ap-pmo { padding-top: clamp(48px, 7vh, 88px); padding-bottom: clamp(48px, 7vh, 88px); }
  .ap-pmo-body { font-size: clamp(16px, 1.7vw, 19px); line-height: 1.6; color: var(--text-secondary); max-width: 64ch; }

  /* Diagnostic */
  .ap-diag { padding-top: clamp(56px, 9vh, 100px); padding-bottom: clamp(48px, 7vh, 88px); }
  .ap-diag-head { display: grid; grid-template-columns: 1fr; gap: 24px; margin-bottom: clamp(32px, 5vh, 52px); }
  @media (min-width: 760px) { .ap-diag-head { grid-template-columns: 1fr auto; align-items: end; gap: 48px; } }
  .ap-diag-lede { font-size: clamp(16px, 1.6vw, 19px); line-height: 1.6; color: var(--text-secondary); max-width: 60ch; }
  .ap-diag-stat { text-align: left; }
  .ap-diag-num { font-family: var(--font-display); font-weight: 600; font-size: clamp(48px, 7vw, 76px); line-height: 1; }
  .ap-diag-num { background: var(--accent-gradient); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .ap-diag-num-label { font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); margin-top: 6px; }

  .ap-phases { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: 1fr; gap: 14px; }
  @media (min-width: 720px) { .ap-phases { grid-template-columns: repeat(2, 1fr); gap: 18px; } }
  @media (min-width: 1000px) { .ap-phases { grid-template-columns: repeat(4, 1fr); } }
  .ap-phase {
    background: var(--surface); border: 1px solid var(--border); border-radius: 14px;
    padding: 22px 22px 24px; position: relative;
  }
  .ap-phase-last { border: 1.5px solid transparent; background: linear-gradient(var(--surface), var(--surface)) padding-box, var(--accent-gradient) border-box; }
  .ap-phase-meta { font-family: var(--font-mono); font-size: 12px; font-weight: 700; letter-spacing: 0.06em; color: var(--accent-text); margin-bottom: 12px; }
  .ap-phase-name { font-family: var(--font-display); font-weight: 600; font-size: 18px; letter-spacing: -0.01em; color: var(--text-primary); margin-bottom: 10px; line-height: 1.2; }
  .ap-phase p { font-size: 14px; line-height: 1.55; color: var(--text-secondary); margin: 0; }

  .ap-quote { margin: clamp(36px, 5vh, 56px) 0 0; padding: 0; max-width: 740px; }
  .ap-quote p {
    font-family: var(--font-display); font-weight: 600; font-size: clamp(20px, 2.6vw, 30px);
    line-height: 1.28; letter-spacing: -0.015em; color: var(--text-primary); margin: 0; max-width: 26ch;
    border-left: 3px solid transparent; border-image: var(--accent-gradient) 1; padding-left: 22px;
  }

  /* After (dark) */
  .ap-after { padding-top: clamp(56px, 9vh, 100px); padding-bottom: clamp(56px, 9vh, 100px); }
  .ap-after-h2 { max-width: 24ch; }
  .ap-after-body { font-size: clamp(16px, 1.7vw, 19px); line-height: 1.6; color: var(--text-secondary); max-width: 64ch; margin-bottom: 16px; }

  /* FAQ */
  .ap-faq { padding-top: clamp(56px, 9vh, 100px); padding-bottom: clamp(56px, 9vh, 100px); }
  .faq-list { margin: clamp(24px, 4vh, 40px) 0 0; padding: 0; max-width: 820px; }
  .faq-item { padding: 22px 0; border-top: 1px solid var(--border); }
  .faq-item:last-child { border-bottom: 1px solid var(--border); }
  .faq-q {
    font-family: var(--font-display); font-weight: 600; font-size: clamp(17px, 1.9vw, 21px);
    line-height: 1.3; letter-spacing: -0.01em; color: var(--text-primary); margin: 0 0 10px;
  }
  .faq-a { font-size: clamp(15px, 1.5vw, 17px); line-height: 1.6; color: var(--text-secondary); margin: 0; max-width: 68ch; }
</style>
