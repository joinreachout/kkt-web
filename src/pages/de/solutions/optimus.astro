---
// Deutsche Optimus-Seite — seit 28.08.2026 auf dem neuen Aufbau (Konzept Яна,
// 20.08). Markup und Texte teilt sie sich mit der englischen und der
// russischen Fassung: OptimusPage.astro + i18n/pages/optimus-page.ts.
//
// Die estnische und die thailändische Seite laufen weiterhin auf dem früheren
// Aufbau mit eigenem Wörterbuch (i18n/pages/optimus.ts).
//
// Die vorherige deutsche Fassung liegt in der Git-Historie dieser Datei.
import BaseLayout from '~/layouts/BaseLayout.astro';
import OptimusPage from '~/components/OptimusPage.astro';
import { useOptimusPage } from '~/i18n/pages/optimus-page';

const t = useOptimusPage(Astro.currentLocale);
---

<BaseLayout title={t.meta.title} description={t.meta.description} ogImage="/og/optimus-v2.png">
  <OptimusPage />
</BaseLayout>
